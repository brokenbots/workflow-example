variable "ref" {
    description = "Git ref to check out for this reproduction attempt (a SHA, tag, or remote ref)."
    type        = string
}

variable "ref_label" {
    description = "Short label for this arm of the matrix: \"main\" or \"stable\". Names the evidence file and the worktree."
    type        = string
}

variable "ref_display" {
    description = "Human-readable identity of the ref (resolved SHA or tag), recorded in evidence so a result is always attributable to a concrete commit."
    type        = string
    default     = ""
}

// Defaults to "" because it is referenced from adapter config, which must
// resolve at compile time. Always supplied by the parent.
variable "repo_dir" {
    description = "Absolute path of the repository's primary working tree. Worktree lifecycle runs here."
    type        = string
    default     = ""
}

// Defaults to "" for the same compile-time reason as repo_dir. Always
// supplied by the parent.
variable "worktree_dir" {
    description = "Absolute path of the throwaway worktree this arm checks out into. Created by the first step; the agent and worktree-scoped shell bind to it lazily."
    type        = string
    default     = ""
}

variable "evidence_dir" {
    description = "Absolute path of the shared evidence directory. This arm writes run-<ref_label>.md and its logs here. Never cleaned up by this subworkflow."
    type        = string
}

variable "bug_report_file" {
    description = "Absolute path to the original bug report, read-only."
    type        = string
}

variable "repro_workflow_dir" {
    description = "Optional reproduction workflow supplied with the report. When set it runs FIRST and UNMODIFIED, and its result is the primary evidence for this arm."
    type        = string
    default     = ""
}

variable "build_cmd" {
    description = "Build command, run inside the worktree before any reproduction attempt. Empty skips the build."
    type        = string
    default     = ""
}

variable "test_cmd" {
    description = "Baseline test command. Failures are recorded, not fatal — the point is to know whether the tree was already unhealthy before attributing anything to the reported bug."
    type        = string
    default     = ""
}

variable "max_visits" {
    description = "Maximum investigator attempts for this reproduction arm."
    type        = number
    default     = 3
}

// Always supplied by the parent. The default exists so this subworkflow
// compiles standalone: adapter config must be known at compile time, and a
// required object variable leaves it unknown.
variable "investigator" {
    type = object({
        model            = string
        max_turns        = optional(number, 40)
        reasoning_effort = optional(string, "")
        provider = optional(object({
            base_url = optional(string, "")
            wire_api = optional(string, "")
            api_key  = optional(string, "")
        }))
    })

    default = {
        model     = "kimi-k2.7-code:cloud"
        max_turns = 40
        provider = {
            base_url = "http://localhost:11434/v1"
            wire_api = "responses"
            api_key  = ""
        }
    }
}
