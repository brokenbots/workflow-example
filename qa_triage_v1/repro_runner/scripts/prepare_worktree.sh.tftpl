criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
set -euo pipefail
git -C "$criteria_value_1" worktree remove --force "$criteria_value_2" 2>/dev/null || true
git -C "$criteria_value_1" worktree prune 2>/dev/null || true
rm -rf "$criteria_value_2"
mkdir -p "$(dirname "$criteria_value_2")"
git -C "$criteria_value_1" worktree add --detach "$criteria_value_2" "$criteria_value_3"
git -C "$criteria_value_2" rev-parse HEAD
