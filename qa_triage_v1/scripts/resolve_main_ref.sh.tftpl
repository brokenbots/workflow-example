criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
set -euo pipefail
git -C "$criteria_value_1" fetch --all --tags --quiet
# printf, not a bare rev-parse: the trailing newline is captured into
# output.stdout and then interpolated into evidence and git refs.
printf '%s' "$(git -C "$criteria_value_1" rev-parse "$criteria_value_2")"
