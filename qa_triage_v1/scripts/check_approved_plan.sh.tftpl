approved_plan_file={{ .approved_plan_file | shellquote }}
run_dir={{ .run_dir | shellquote }}
set -euo pipefail
ev="$run_dir/evidence"
mkdir -p "$ev"

if [ -n "$approved_plan_file" ] && [ -f "$approved_plan_file" ]; then
    cp "$approved_plan_file" "$ev/plan.md"
    # Literal true so the workflow can write it into the bool restored node via
    # a bare output.stdout write (a comparison would be misrouted by the
    # engine's bare-traversal fast path).
    printf '%s' "true"
    exit 0
fi

printf '%s' "false"
exit 0
