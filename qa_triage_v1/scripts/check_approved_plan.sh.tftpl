approved_plan_file={{ .approved_plan_file | shellquote }}
run_dir={{ .run_dir | shellquote }}
set -euo pipefail
ev="$run_dir/evidence"
mkdir -p "$ev"

if [ -n "$approved_plan_file" ] && [ -f "$approved_plan_file" ]; then
    cp "$approved_plan_file" "$ev/plan.md"
    # Emit a semantic token so the workflow can compare it explicitly. The
    # comparison is evaluated correctly now that the engine's bare-traversal
    # fast path only applies to a bare output.* reference (CRI-94 / criteria
    # PR #360).
    printf '%s' "restored"
    exit 0
fi

printf '%s' "fresh"
exit 0
