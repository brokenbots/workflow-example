// Worktree lifecycle runs in the repo's primary tree — it must work before the
// per-ref worktree exists.
environment "remote" "primary" {
    // Per-scope sessions: each scope gets its own adapter pod, torn down at
    // scope exit. Requires the run data dir wiring (CRI-128).
    per_scope_sessions = false  // CRI-132: disabled until the operator parser understands the nested envelope
    working_directory = var.repo_dir
    process = {
        exec = ["*"]
    }
    listen_address = "127.0.0.1:7778"
    accept_token = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

// Build, baseline tests, and the reproduction itself run inside the checked-out
// ref. Bound lazily: the worktree is created by this subworkflow's first step.
environment "remote" "worktree" {
    working_directory = var.worktree_dir
    process = {
        exec = ["*"]
    }
    listen_address = "127.0.0.1:7778"
    accept_token = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

adapter "shell" "repo" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.3"
    environment = remote.primary
    secrets {
        GH_TOKEN = var.workflow_github_token
    }
}

adapter "shell" "wt" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.3"
    environment = remote.worktree
    secrets {
        GH_TOKEN = var.workflow_github_token
    }
}

adapter "copilot" "investigator" {
    environment = remote.worktree
    source      = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version     = "0.5.6"
    secrets {
        GITHUB_TOKEN = var.workflow_github_token
        GH_TOKEN     = var.workflow_github_token
    }
    config {
        model             = var.investigator.model
        max_turns         = "${var.investigator.max_turns}"
        reasoning_effort  = var.investigator.reasoning_effort
        system_prompt     = file("./agents/investigator.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.investigator.provider.base_url
        provider_wire_api = var.investigator.provider.wire_api
        working_directory = var.worktree_dir
    }
}
