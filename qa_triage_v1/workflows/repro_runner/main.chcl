workflow {
    name          = "repro_runner"
    version       = "1"
    criteria_version = ">=0.5.9, <0.6.0"
    initial_state = "prepare_worktree"
    target_state  = "done"

    policy {
        max_total_steps = 60
    }
}

// This arm's result: "yes" | "no" | "inconclusive".
//
// "inconclusive" is a first-class outcome, not a failure. A build that does not
// compile at this ref, or a reproduction whose result is ambiguous, must NOT be
// reported as "no" — a false "no" is what turns a real bug into a closed report.
data "internal" "reproduced" {
    type  = string
    value = "inconclusive"
}

// Whether the baseline test suite was already failing at this ref, before any
// reproduction was attempted. Carried into evidence so a pre-existing failure is
// never mistaken for the reported bug.
data "internal" "baseline_health" {
    type  = string
    value = "unknown"
}

step "prepare_worktree" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/prepare_worktree.sh.tftpl", {
            criteria_value_1 = var.repo_dir
            criteria_value_2 = var.worktree_dir
            criteria_value_3 = var.ref
        })
    }
    outcome "success" { next = switch.route_build }
    outcome "failure" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
}

switch "route_build" {
    match {
        condition = var.build_cmd == ""
        next      = switch.route_baseline_tests
    }
    default { next = step.build }
}

// A ref that does not build cannot host a reproduction. That is inconclusive
// for this arm, never a "no".
step "build" {
    target = adapter.shell.wt
    input {
        command = templatefile("./scripts/build.sh.tftpl", {
            criteria_value_1 = var.evidence_dir
            criteria_value_2 = var.ref_label
            criteria_value_3 = var.build_cmd
        })
    }
    outcome "success" { next = switch.route_baseline_tests }
    outcome "failure" { next = step.mark_build_failed }
}

step "mark_build_failed" {
    target = adapter.shell.wt
    input {
        command = templatefile("./scripts/mark_build_failed.sh.tftpl", {
            criteria_value_1 = var.evidence_dir
            criteria_value_2 = var.ref_label
            criteria_value_3 = var.ref
            criteria_value_4 = var.ref_display
            criteria_value_5 = var.build_cmd
        })
    }
    outcome "success" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
    outcome "failure" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
}

switch "route_baseline_tests" {
    match {
        condition = var.test_cmd == ""
        next      = switch.route_provided_workflow
    }
    default { next = step.baseline_tests }
}

// Deliberately non-fatal. The result is recorded either way: knowing the suite
// was already red at this ref is what prevents an unrelated failure being
// attributed to the reported bug.
step "baseline_tests" {
    target = adapter.shell.wt
    input {
        command = templatefile("./scripts/baseline_tests.sh.tftpl", {
            criteria_value_1 = var.evidence_dir
            criteria_value_2 = var.ref_label
            criteria_value_3 = var.test_cmd
        })
    }
    outcome "success" {
        next = switch.route_provided_workflow
        write {
            target = data.internal.baseline_health.value
            value  = output.stdout
        }
    }
    outcome "failure" {
        next = switch.route_provided_workflow
        write {
            target = data.internal.baseline_health.value
            value  = "already_failing"
        }
    }
}

switch "route_provided_workflow" {
    match {
        condition = var.repro_workflow_dir == ""
        next      = step.execute_plan
    }
    default { next = step.run_provided_workflow }
}

// The reporter's own reproduction, run unmodified, before the investigator gets
// a chance to construct its own. When a report ships a reproduction, that
// reproduction is the evidence — an investigator-authored substitute tests
// whatever the investigator understood the report to mean, which is exactly the
// substitution this workflow exists to prevent.
step "run_provided_workflow" {
    target = adapter.shell.wt
    input {
        command = templatefile("./scripts/run_provided_workflow.sh.tftpl", {
            criteria_value_1 = var.evidence_dir
            criteria_value_2 = var.ref_label
            criteria_value_3 = var.ref_display
            criteria_value_4 = var.repro_workflow_dir
        })
    }
    outcome "success" { next = step.execute_plan }
    outcome "failure" { next = step.execute_plan }
}

step "execute_plan" {
    target      = adapter.copilot.investigator
    max_visits  = var.max_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/execute_plan.md.tftpl", {
            evidence_dir    = var.evidence_dir
            ref_label       = var.ref_label
            ref             = var.ref
            ref_display     = var.ref_display
            worktree_dir    = var.worktree_dir
            baseline_health = data.internal.baseline_health.value
        })
    }

    outcome "reproduced" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "yes"
        }
    }
    outcome "not_reproduced" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "no"
        }
    }
    outcome "inconclusive" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
    outcome "need_help" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
    outcome "failure" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
    outcome "default" {
        next = state.done
        write {
            target = data.internal.reproduced.value
            value  = "inconclusive"
        }
    }
}

state "done" {
    terminal = true
    success  = true
}

// Declared outputs. `data "internal"` alone is NOT visible to the parent as
// `subworkflow.<name>` — without these blocks the parent's
// try(subworkflow.reproduced, "inconclusive") silently takes the fallback and
// every arm reports "inconclusive" regardless of what actually happened.
output "reproduced" {
    type  = string
    value = data.internal.reproduced.value
}

output "baseline_health" {
    type  = string
    value = data.internal.baseline_health.value
}
