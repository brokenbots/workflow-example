workflow {
    name          = "qa_triage_v1"
    version       = "1"
    criteria_version = ">=0.5.9, <0.6.0"
    initial_state = "read_report"
    target_state  = "workstream_published"

    policy {
        max_total_steps = 150
    }
}

// ── Run state ────────────────────────────────────────────────────────────────

// Absolute path of this triage run's directory: <triage_root>/<slug>.
// Evidence lives at <run_dir>/evidence, throwaway worktrees at <run_dir>/wt/<label>.
data "internal" "run_dir" {
    type  = string
    value = ""
}

// Concrete SHA of the mainline ref, resolved after an explicit fetch so the
// tested commit is the remote's rather than a stale local ref.
data "internal" "main_sha" {
    type  = string
    value = ""
}

// Highest non-prerelease semver tag, or var.stable_ref when set. Empty when the
// repo has no stable release — a valid state that the verdict must account for
// rather than treat as a failed resolution.
data "internal" "stable_tag" {
    type  = string
    value = ""
}

// Per-ref reproduction results: "yes" | "no" | "inconclusive" | "skipped".
// The PAIR is the finding — see the verdict gate. A single ref's result in
// isolation cannot distinguish a live bug from a regression from a stale build.
data "internal" "repro_main" {
    type  = string
    value = "skipped"
}

data "internal" "repro_stable" {
    type  = string
    value = "skipped"
}

// Supervisor's revision notes, fed back to the investigator on a bounded retry.
// Carried as data rather than accumulated in the prompt so a refine cycle costs
// one message, not a growing transcript.
data "internal" "supervisor_feedback" {
    type  = string
    value = ""
}

// Supervisor's verdict, recorded for the triage report.
data "internal" "verdict" {
    type  = string
    value = ""
}

// Absolute path of the published workstream file, set by publish_workstream.
// Empty when the run produced no workstream. Exposed as an output so a parent
// workflow (linear_intake_v1) can hand it to workstream_handler_v1 without
// re-deriving the slug.
data "internal" "workstream_file" {
    type  = string
    value = ""
}

// ── Reproduction subworkflows ────────────────────────────────────────────────
// Declared once per ref rather than iterated: the two runs take different refs
// and different worktrees, and keeping them separate makes the routing between
// them explicit rather than hidden in iteration state.

subworkflow "repro_main" {
    source = "./workflows/repro_runner"
    input = {
        ref                = var.main_ref
        ref_label          = "main"
        ref_display        = data.internal.main_sha.value
        repo_dir           = var.repo_dir
        worktree_dir       = "${data.internal.run_dir.value}/wt/main"
        evidence_dir       = "${data.internal.run_dir.value}/evidence"
        bug_report_file    = var.bug_report_file
        repro_workflow_dir = var.repro_workflow_dir
        build_cmd          = var.build_cmd
        test_cmd           = var.test_cmd
        max_visits         = var.max_repro_visits
        investigator       = var.investigator
        provider_base_url  = var.provider_base_url
        workflow_github_token = var.workflow_github_token
    }
}

subworkflow "repro_stable" {
    source = "./workflows/repro_runner"
    input = {
        ref                = data.internal.stable_tag.value
        ref_label          = "stable"
        ref_display        = data.internal.stable_tag.value
        repo_dir           = var.repo_dir
        worktree_dir       = "${data.internal.run_dir.value}/wt/stable"
        evidence_dir       = "${data.internal.run_dir.value}/evidence"
        bug_report_file    = var.bug_report_file
        repro_workflow_dir = var.repro_workflow_dir
        build_cmd          = var.build_cmd
        test_cmd           = var.test_cmd
        max_visits         = var.max_repro_visits
        investigator       = var.investigator
        provider_base_url  = var.provider_base_url
        workflow_github_token = var.workflow_github_token
    }
}

// ── Intake ───────────────────────────────────────────────────────────────────

step "read_report" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/read_report.sh.tftpl", {
            criteria_value_1 = var.bug_report_file
        })
    }
    outcome "success" { next = step.prepare_workspace }
    outcome "failure" { next = state.failed }
}

step "prepare_workspace" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/prepare_workspace.sh.tftpl", {
            criteria_value_1 = var.triage_root
            criteria_value_2 = var.repo_dir
            criteria_value_3 = var.bug_report_file
        })
    }
    outcome "success" {
        next = step.resolve_main_ref
        write {
            target = data.internal.run_dir.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// Fetch first, then resolve. Resolving without fetching is how a triage ends up
// testing a commit that is not what anyone else means by "main".
step "resolve_main_ref" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/resolve_main_ref.sh.tftpl", {
            criteria_value_1 = var.repo_dir
            criteria_value_2 = var.main_ref
        })
    }
    outcome "success" {
        next = step.resolve_stable_ref
        write {
            target = data.internal.main_sha.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// An empty result is legitimate — a repo with no release tags has no stable ref.
// It is recorded as empty and handled at routing, never treated as an error.
step "resolve_stable_ref" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/resolve_stable_ref.sh.tftpl", {
            criteria_value_1 = var.stable_ref
            criteria_value_2 = var.repo_dir
        })
    }
    outcome "success" {
        next = step.record_refs
        write {
            target = data.internal.stable_tag.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

step "record_refs" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/record_refs.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.test_refs
            criteria_value_3 = var.main_ref
            criteria_value_4 = data.internal.main_sha.value
            criteria_value_5 = data.internal.stable_tag.value
            criteria_value_6 = var.repro_workflow_dir
        })
    }
    outcome "success" { next = step.setup_scratch_worktree }
    outcome "failure" { next = state.failed }
}

// A real checkout at the mainline ref that the triage team owns outright.
//
// The investigator plans and drafts here, and is free to write reproduction
// harnesses, add test files, and patch code to test a hypothesis. That is
// normal triage work and it needs somewhere to happen — without this, an agent
// with nowhere legitimate to write ends up writing into the operator's
// checkout, which is exactly what happened before this step existed.
//
// Discarded wholesale at teardown. Nothing here is ever measured for a verdict:
// per-ref measurements come from repro_runner's own clean worktrees.
step "setup_scratch_worktree" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/setup_scratch_worktree.sh.tftpl", {
            criteria_value_1 = var.triage_root
            criteria_value_2 = var.repo_dir
            criteria_value_3 = data.internal.main_sha.value
        })
    }
    outcome "success" { next = step.intake_review }
    outcome "failure" { next = state.failed }
}

// ── Gate 0: is this report actionable at all? ────────────────────────────────
// Cheapest possible rejection. A report with no version, no environment, and no
// reproduction path cannot be triaged, and discovering that after a full build
// and reproduction cycle wastes the entire run.

step "intake_review" {
    target      = adapter.copilot.supervisor
    max_visits  = var.max_intake_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/intake_review.md.tftpl", {
            run_dir = data.internal.run_dir.value
        })
    }

    outcome "actionable" { next = step.plan_repro }
    outcome "insufficient" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "insufficient_report"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "needs_human" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_intake"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Plan ─────────────────────────────────────────────────────────────────────

step "plan_repro" {
    target      = adapter.copilot.investigator
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/plan_repro.md.tftpl", {
            run_dir             = data.internal.run_dir.value
            repro_workflow_dir = var.repro_workflow_dir
            build_cmd           = var.build_cmd
            test_cmd            = var.test_cmd
            supervisor_feedback = data.internal.supervisor_feedback.value
        })
    }

    outcome "plan_ready"  { next = step.review_plan }
    outcome "need_help" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_plan"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "failure"     { next = state.failed }
    outcome "default"     { next = state.failed }
}

// ── Gate 1: is the plan adequate, before it costs a build and a run? ─────────

step "review_plan" {
    target      = adapter.copilot.supervisor
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/review_plan.md.tftpl", {
            run_dir             = data.internal.run_dir.value
            repro_workflow_dir = var.repro_workflow_dir
        })
    }

    outcome "plan_approved" {
        next = switch.route_repro_start
        write {
            target = data.internal.supervisor_feedback.value
            value  = ""
        }
    }
    outcome "plan_revise" {
        next = step.plan_repro
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "plan_reject" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "plan_rejected"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Reproduction across the ref matrix ───────────────────────────────────────

switch "route_repro_start" {
    match {
        condition = var.test_refs == "stable"
        next      = switch.route_stable_available
    }
    default { next = step.run_repro_main }
}

step "run_repro_main" {
    target = subworkflow.repro_main
    outcome "success" {
        next = switch.route_after_main
        write {
            target = data.internal.repro_main.value
            value  = subworkflow.reproduced != null ? subworkflow.reproduced : "inconclusive"
        }
    }
    outcome "failure" {
        next = switch.route_after_main
        write {
            target = data.internal.repro_main.value
            value  = subworkflow.reproduced != null ? subworkflow.reproduced : "inconclusive"
        }
    }
}

switch "route_after_main" {
    match {
        condition = var.test_refs == "both"
        next      = switch.route_stable_available
    }
    default { next = step.aggregate_evidence }
}

// A repo with no release tag cannot be tested against stable. That is recorded
// as "skipped" and carried into the verdict, not silently dropped — a verdict
// reached without the stable arm is a weaker verdict and must be labelled so.
switch "route_stable_available" {
    match {
        condition = data.internal.stable_tag.value == ""
        next      = step.note_no_stable
    }
    default { next = step.run_repro_stable }
}

step "note_no_stable" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/note_no_stable.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
        })
    }
    outcome "success" { next = step.aggregate_evidence }
    outcome "failure" { next = state.failed }
}

step "run_repro_stable" {
    target = subworkflow.repro_stable
    outcome "success" {
        next = step.aggregate_evidence
        write {
            target = data.internal.repro_stable.value
            value  = subworkflow.reproduced != null ? subworkflow.reproduced : "inconclusive"
        }
    }
    outcome "failure" {
        next = step.aggregate_evidence
        write {
            target = data.internal.repro_stable.value
            value  = subworkflow.reproduced != null ? subworkflow.reproduced : "inconclusive"
        }
    }
}

step "aggregate_evidence" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/aggregate_evidence.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.test_refs
            criteria_value_3 = data.internal.main_sha.value
            criteria_value_4 = data.internal.repro_main.value
            criteria_value_5 = data.internal.stable_tag.value
            criteria_value_6 = data.internal.repro_stable.value
        })
    }
    outcome "success" { next = step.assert_repo_clean }
    outcome "failure" { next = state.failed }
}

// Triage treats the repository as a read-only input. If the primary working
// tree is dirty after the reproduction phases, an agent wrote into the repo it
// was supposed to be observing — which both corrupts the evidence (a "clean
// build at ref X" that has uncommitted edits is not a build at ref X) and
// leaves the operator's checkout modified.
//
// Reported loudly and fails the run. Deliberately does NOT revert: discarding
// changes in someone's working tree is not a decision this workflow gets to
// make unattended, and the operator may have legitimate work in progress.
step "assert_repo_clean" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/assert_repo_clean.sh.tftpl", {
            criteria_value_1 = var.repo_dir
            criteria_value_2 = data.internal.run_dir.value
        })
    }
    outcome "success" { next = step.verdict }
    outcome "failure" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "aborted_repo_modified"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = "Run aborted: the repository under test was modified during triage. See evidence/repo-dirty.md. No verdict was reached and no workstream was produced, because evidence gathered against a dirty tree cannot be attributed to the refs under test."
        }
    }
}

// ── Gate 2: does the evidence support the claim? ─────────────────────────────

step "verdict" {
    target      = adapter.copilot.supervisor
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/verdict.md.tftpl", {
            run_dir           = data.internal.run_dir.value
            main_sha          = data.internal.main_sha.value
            repro_main        = data.internal.repro_main.value
            stable_tag        = data.internal.stable_tag.value
            repro_stable      = data.internal.repro_stable.value
            design_intent_file = var.design_intent_file
        })
    }

    outcome "reproduced" {
        next = step.draft_workstream
        write {
            target = data.internal.verdict.value
            value  = "reproduced"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "regression" {
        next = step.draft_workstream
        write {
            target = data.internal.verdict.value
            value  = "regression"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "already_fixed" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "already_fixed"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "not_reproduced" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "not_reproduced"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "insufficient_evidence" {
        next = step.plan_repro
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "needs_human" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_verdict"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Workstream drafting ──────────────────────────────────────────────────────

step "draft_workstream" {
    target      = adapter.copilot.investigator
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/draft_workstream.md.tftpl", {
            run_dir             = data.internal.run_dir.value
            verdict             = data.internal.verdict.value
            supervisor_feedback = data.internal.supervisor_feedback.value
        })
    }

    outcome "draft_ready"  { next = step.approve_workstream }
    outcome "needs_design" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "needs_design_decision"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "need_help" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_draft"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "failure"   { next = state.failed }
    outcome "default"   { next = state.failed }
}

// ── Gate 3: final authority over whether a workstream file exists ────────────

step "approve_workstream" {
    target      = adapter.copilot.supervisor
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/approve_workstream.md.tftpl", {
            run_dir = data.internal.run_dir.value
            verdict = data.internal.verdict.value
        })
    }

    outcome "approved" { next = step.publish_workstream }
    outcome "revise" {
        next = step.draft_workstream
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "reject" {
        next = step.write_triage_report
        write {
            target = data.internal.verdict.value
            value  = "workstream_rejected"
        }
        write {
            target = data.internal.supervisor_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

step "publish_workstream" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/publish_workstream.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.workstream_out_dir
            criteria_value_3 = var.bug_report_file
        })
    }
    outcome "success" {
        next = step.write_triage_report
        write {
            target = data.internal.workstream_file.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// Written on every terminating path, including the ones that produce no
// workstream. A triage that concludes "not reproduced" is a result worth
// keeping — it is what stops the next person re-running the same dead end.
step "write_triage_report" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/write_triage_report.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.bug_report_file
            criteria_value_3 = data.internal.verdict.value
            criteria_value_4 = var.test_refs
            criteria_value_5 = data.internal.main_sha.value
            criteria_value_6 = data.internal.repro_main.value
            criteria_value_7 = data.internal.stable_tag.value
            criteria_value_8 = data.internal.repro_stable.value
            criteria_value_9 = var.repro_workflow_dir
            criteria_value_10 = data.internal.supervisor_feedback.value
        })
    }
    outcome "success" { next = step.teardown }
    outcome "failure" { next = state.failed }
}

// Worktrees are throwaway; evidence is the deliverable and is never removed.
step "teardown" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/teardown.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.repo_dir
            criteria_value_3 = var.triage_root
        })
    }
    outcome "success" { next = switch.route_final }
    outcome "failure" { next = switch.route_final }
}

switch "route_final" {
    match {
        condition = data.internal.verdict.value == "reproduced" || data.internal.verdict.value == "regression"
        next      = state.workstream_published
    }
    match {
        condition = startswith(data.internal.verdict.value, "needs_human_") || data.internal.verdict.value == "needs_design_decision"
        next      = state.needs_human
    }
    default { next = state.closed_no_workstream }
}

// ── Terminal states ──────────────────────────────────────────────────────────

state "workstream_published" {
    terminal = true
    success  = true
}

// Not a failure. A report that does not reproduce, or is already fixed, or was
// too thin to triage, is a legitimate and useful conclusion — the evidence
// directory records what was tried so it is not repeated.
state "closed_no_workstream" {
    terminal = true
    success  = true
}

state "needs_human" {
    terminal = true
    success  = false
}

state "failed" {
    terminal = true
    success  = false
}

// ── Outputs ──────────────────────────────────────────────────────────────────
// Declared for parent workflows (linear_intake_v1). verdict is empty when the
// run died before the intake or verdict gate recorded one; workstream_file is
// empty whenever no workstream was published. Parents must read both with
// try() on success AND failure outcomes — see
// workstreams/branch-evaluated-reports-wrong-condition-text.md.

output "verdict" {
    type  = string
    value = data.internal.verdict.value
}

output "workstream_file" {
    type  = string
    value = data.internal.workstream_file.value
}
