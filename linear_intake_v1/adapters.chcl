// All of this workflow's own work — Linear API calls, file guards — happens
// under intake_root. Nothing here touches the repository directly;
// qa_triage_v1 and workstream_handler_v1 manage their own environments and
// adapter sets as subworkflows.
environment "sandbox" "intake" {
    working_directory = var.intake_root
    filesystem = {
        read  = ["/"]
        write = ["/data", "/tmp", "/dev", "/home/criteria"]
    }
    network = {
        allow = ["*"]
    }
}

// Deterministic steps. Also carries the Linear credential: every Linear step
// runs curl against https://api.linear.app/graphql with this key.
//
// LINEAR_API_KEY is resolved from the host environment and injected into this
// adapter's command environment through the secret channel. It is never
// interpolated into step input.
adapter "shell" "intake" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.2"
    environment = sandbox.intake
    secrets {
        LINEAR_API_KEY = "env:LINEAR_API_KEY"
    }
}

// The sandbox scrubs host token variables before launch. The secret channel
// reintroduces only the non-review identity under the names used by the Copilot
// SDK and gh CLI.
adapter "copilot" "intake_classifier" {
    environment = sandbox.intake
    source      = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version     = "0.5.4"
    secrets {
        GITHUB_TOKEN = "env:WORKFLOW_GITHUB_TOKEN"
        GH_TOKEN     = "env:WORKFLOW_GITHUB_TOKEN"
    }
    config {
        model             = var.intake_classifier.model
        max_turns         = "${var.intake_classifier.max_turns}"
        reasoning_effort  = var.intake_classifier.reasoning_effort
        system_prompt     = file("./agents/intake_classifier.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.intake_classifier.provider.base_url
        provider_wire_api = var.intake_classifier.provider.wire_api
        working_directory = var.intake_root
    }
}

// The routing gate at the end of triage. Reads artifacts from disk — the
// triage report and the workstream file — never another agent's transcript.
adapter "copilot" "triage_reviewer" {
    environment = sandbox.intake
    source      = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version     = "0.5.4"
    secrets {
        GITHUB_TOKEN = "env:WORKFLOW_GITHUB_TOKEN"
        GH_TOKEN     = "env:WORKFLOW_GITHUB_TOKEN"
    }
    config {
        model             = var.triage_reviewer.model
        max_turns         = "${var.triage_reviewer.max_turns}"
        reasoning_effort  = var.triage_reviewer.reasoning_effort
        system_prompt     = file("./agents/triage_reviewer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.triage_reviewer.provider.base_url
        provider_wire_api = var.triage_reviewer.provider.wire_api
        working_directory = var.intake_root
    }
}
