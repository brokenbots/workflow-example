criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
criteria_value_4={{ .criteria_value_4 | shellquote }}
set -euo pipefail
: "${LINEAR_API_KEY:?LINEAR_API_KEY is not set -- export it before criteria apply}"
run_dir="$criteria_value_1/$criteria_value_2"
issue_id=$(jq -r '.data.issue.id' "$run_dir/ticket.json")
team_id=$(jq -r '.data.issue.team.id' "$run_dir/ticket.json")

labels=$(curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'query($team: ID!, $name: String!) { issueLabels(filter: {team: {id: {eq: $team}}, name: {eq: $name}}) { nodes { id } } }' \
        --arg team "$team_id" \
        --arg name "$criteria_value_3" \
        '{query: $q, variables: {team: $team, name: $name}}')" \
    https://api.linear.app/graphql)
[ -n "$labels" ] || { echo "linear rpc transport: issueLabels (empty response)" >&2; exit 1; }
printf '%s' "$labels" | jq -e '(type == "object") and (has("data") or has("errors"))' >/dev/null \
    || { echo "linear rpc transport: issueLabels (non-JSON-RPC body)" >&2; printf '%s\n' "$labels" >&2; exit 1; }
if printf '%s' "$labels" | jq -e 'has("errors")' >/dev/null; then
    echo "linear rpc error: issueLabels: $(printf '%s' "$labels" | jq -r '[.errors[]?.message] // [] | join("; ")')" >&2
    exit 1
fi

label_id=$(printf '%s' "$labels" | jq -r '.data.issueLabels.nodes[0].id // empty')

label_ids=$(jq -c \
    --arg desired "$criteria_value_3" \
    --arg conflicting "$criteria_value_4" \
    '[.data.issue.labels.nodes[]
      | select((.name | ascii_downcase) != ($desired | ascii_downcase))
      | select((.name | ascii_downcase) != ($conflicting | ascii_downcase))
      | .id]' \
    "$run_dir/ticket.json")

if [ -n "$label_id" ]; then
    label_ids=$(printf '%s' "$label_ids" | jq -c --arg label_id "$label_id" '. + [$label_id] | unique')
else
    echo "Linear label '$criteria_value_3' not found; removing conflicting '$criteria_value_4' label and continuing" >&2
fi

resp=$(curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'mutation($id: String!, $labelIds: [String!]!) { issueUpdate(id: $id, input: {labelIds: $labelIds}) { success } }' \
        --arg id "$issue_id" \
        --argjson labelIds "$label_ids" \
        '{query: $q, variables: {id: $id, labelIds: $labelIds}}')" \
    https://api.linear.app/graphql) || {
    echo "linear rpc transport: issueUpdate" >&2
    exit 1
}
[ -n "$resp" ] || { echo "linear rpc transport: issueUpdate (empty response)" >&2; exit 1; }
printf '%s' "$resp" | jq -e '(type == "object") and (has("data") or has("errors"))' >/dev/null \
    || { echo "linear rpc transport: issueUpdate (non-JSON-RPC body)" >&2; printf '%s\n' "$resp" >&2; exit 1; }
if printf '%s' "$resp" | jq -e 'has("errors")' >/dev/null; then
    echo "linear rpc error: issueUpdate: $(printf '%s' "$resp" | jq -r '[.errors[]?.message] // [] | join("; ")')" >&2
    exit 1
fi
if ! printf '%s' "$resp" | jq -e '.data.issueUpdate.success == true' >/dev/null; then
    echo "linear rpc error: issueUpdate (success=false)" >&2
    exit 1
fi

if [ -n "$label_id" ]; then
    echo "ticket labeled $criteria_value_3"
else
    echo "ticket classification updated without unavailable label $criteria_value_3"
fi