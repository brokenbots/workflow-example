criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
set -euo pipefail
: "${LINEAR_API_KEY:?LINEAR_API_KEY is not set -- export it before criteria apply}"
run_dir="$criteria_value_1/$criteria_value_2"
issue_id=$(jq -r '.data.issue.id' "$run_dir/ticket.json")

if [ "$criteria_value_3" = "feature" ]; then
    body='**Automated intake classified this ticket as a feature request.** A workstream was generated and the implementation handler has started. The ticket will be commented again when the handler finishes.'
else
    body="**Automated QA triage confirmed this bug (verdict: $criteria_value_3).** A workstream was generated and the implementation handler has started. The ticket will be commented again when the handler finishes."
fi

curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'mutation($id: String!, $body: String!) { commentCreate(input: {issueId: $id, body: $body}) { success } }' \
        --arg id "$issue_id" \
        --arg body "$body" \
        '{query: $q, variables: {id: $id, body: $body}}')" \
    https://api.linear.app/graphql \
    | jq -e '.data.commentCreate.success == true' >/dev/null

echo "comment posted"
