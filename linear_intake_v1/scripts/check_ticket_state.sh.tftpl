intake_root={{ .intake_root | shellquote }}
ticket_id={{ .ticket_id | shellquote }}
set -euo pipefail
ticket_json="$intake_root/$ticket_id/ticket.json"

if [ ! -f "$ticket_json" ]; then
    printf '%s' "unknown"
    exit 0
fi

state_type=$(jq -r '.data.issue.state.type // "unknown"' "$ticket_json")
# Emit a semantic token so the workflow can compare it explicitly. The
# comparison is evaluated correctly now that the engine's bare-traversal fast
# path only applies to a bare output.* reference (CRI-94 / criteria PR #360).
case "$state_type" in
    completed|canceled)
        printf '%s' "terminal"
        ;;
    *)
        printf '%s' "open"
        ;;
esac
exit 0
