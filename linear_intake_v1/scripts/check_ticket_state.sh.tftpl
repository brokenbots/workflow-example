intake_root={{ .intake_root | shellquote }}
ticket_id={{ .ticket_id | shellquote }}
set -euo pipefail
ticket_json="$intake_root/$ticket_id/ticket.json"

if [ ! -f "$ticket_json" ]; then
    printf '%s' "unknown"
    exit 0
fi

state_type=$(jq -r '.data.issue.state.type // "unknown"' "$ticket_json")
# Emit a literal true/false so the workflow can write it directly into the
# bool-typed ticket_terminal node via a bare output.stdout write. (A comparison
# like output.stdout == "terminal" in the write value is misrouted by the
# engine's bare-traversal fast path and fails bool conversion.)
case "$state_type" in
    completed|canceled)
        printf '%s' "true"
        ;;
    *)
        printf '%s' "false"
        ;;
esac
exit 0
