#!/bin/sh
# Assemble the workstream for an internal-reproduced bug directly from the
# task. The reproduction is already documented (run IDs, error signatures,
# builds, mechanism) — regenerating it via QA triage duplicates work the task
# already did. Exit criteria: the workstream file exists and is non-empty; the
# development it enables treats it as the plan.
#
# Ported from linear_triage_v1's write_confirmed_workstream.sh.tftpl: the
# Linear .data.issue envelope becomes the Kanboard {task, tags, comments}
# envelope — the hollow-workstream defect class cannot recur here because the
# field paths are pinned to the new envelope from the start.
#
# KB-355: every (re)write stamps a scope-generation marker into the file —
# '<!-- scope-generation: <hash of title+description> stamped: <RFC3339Z> -->'.
# Ticket rewrites in place keep the ticket id, so a predecessor scope's merged
# PR stays a permanent delivery-fingerprint identity match; the marker's
# generation time lets the classifier suppress merged identity PRs that predate
# the current scope. An unchanged scope re-triaged keeps its original stamp
# (the file is regenerated, but the generation time must not advance).
#
# The marker is read ONLY from the header region (content before the first
# level-two heading) and only the first line there whose entire content is the
# canonical marker shape. The workstream body embeds the ticket description
# and comment bodies verbatim, so a whole-file read would let a forgery inside
# the ticket text preserve or re-date the generation. The title is collapsed
# to a single heading line so a title containing newline+marker-shaped text
# cannot fabricate a second marker-shaped header line (the digest itself is
# computed over the RAW title — collapse is for heading emission only).
set -eu

TICKET_JSON="{{ .intake_root }}/{{ .ticket_id }}/ticket.json"
WORKSTREAM="{{ .intake_root }}/{{ .ticket_id }}/workstreams/{{ .ticket_id }}.md"

mkdir -p "$(dirname "$WORKSTREAM")"

TITLE=$(jq -r '.task.title // empty' "$TICKET_JSON")
DESC=$(jq -r '.task.description // empty' "$TICKET_JSON")

# KB-355 scope generation: hash of the scope-bearing content (title +
# description; comment-only edits do not advance the generation), and the
# generation time. An existing marker with THIS scope hash and a well-formed
# stamp is preserved so re-triage of an unchanged scope never re-arms the
# classifier's predecessor guard; anything else starts a new generation.
SCOPE_HASH=$(printf '%s\n%s' "$TITLE" "$DESC" | sha256sum | cut -c1-12)
valid_scope_stamp() {
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) return 0 ;;
        *) return 1 ;;
    esac
}
scope_prev_stamp=""
scope_prev_hash=""
if [ -s "$WORKSTREAM" ]; then
    scope_prev_line=$(awk '/^## /{exit} {print}' "$WORKSTREAM" 2>/dev/null \
        | grep -E -m1 '^<!-- scope-generation: [0-9a-f]{12} stamped: [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z -->$' \
        || true)
    scope_prev_hash=$(printf '%s' "$scope_prev_line" | sed -n 's/.*scope-generation: \([0-9a-f]\{12\}\) stamped:.*/\1/p')
    scope_prev_stamp=$(printf '%s' "$scope_prev_line" | sed -n 's/.*stamped: \([0-9T:-]*Z\).*/\1/p')
fi
if [ "$scope_prev_hash" = "$SCOPE_HASH" ] && valid_scope_stamp "$scope_prev_stamp"; then
    SCOPE_STAMP=$scope_prev_stamp
else
    SCOPE_STAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
fi

HEADING_TITLE=$(printf '%s' "$TITLE" | tr '\n' ' ')

{
    echo "# Workstream: $HEADING_TITLE"
    echo
    printf '<!-- scope-generation: %s stamped: %s -->\n' "$SCOPE_HASH" "$SCOPE_STAMP"
    echo
    echo "Source: Kanboard task KB-$(jq -r '.task.id' "$TICKET_JSON")"
    echo
    echo "## Problem (documented reproduction)"
    echo
    echo "$DESC"
    echo
    echo "## Task comments (evidence history)"
    echo
    jq -r '.comments[]? | "### comment\n\n" + .comment + "\n"' "$TICKET_JSON"
    echo "## Required behavior"
    echo
    echo "Implement the fix described above. The reproduction in the task"
    echo "is authoritative: preserve the observed error signatures and verify"
    echo "the fix against the documented mechanism. Add or update tests that"
    echo "exercise the failing path."
} > "$WORKSTREAM"

# Guard: non-empty workstream or the bypass failed
if [ ! -s "$WORKSTREAM" ]; then
    echo "workstream file is empty" >&2
    exit 1
fi

echo "workstream written: $WORKSTREAM"