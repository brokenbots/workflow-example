criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
criteria_value_4={{ .criteria_value_4 | shellquote }}
set -euo pipefail
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set -- export it before criteria apply}"
: "${KANBOARD_URL:?KANBOARD_URL is not set -- export it before criteria apply}"
run_dir="$criteria_value_1/$criteria_value_2"
task_id="${criteria_value_2#KB-}"

# Ported from linear_triage_v1's set_classification_label.sh.tftpl. Kanboard
# has no global label registry to look up ids against: createTag ensures the
# project-level tag exists (idempotent), then setTaskTags applies the task's
# desired tag set — the same REMOVE-conflicting + ADD-desired semantics, since
# setTaskTags replaces the task's whole tag list.
project_id=$(jq -r '.task.project_id' "$run_dir/ticket.json")

# Read the file directly: the printf-pipes-the-path-string form made jq parse
# the literal filename (exit 5, 'Invalid literal at EOF'), so desired was
# always empty and setTaskTags received an empty tags value (invalid params).
desired=$(jq -c \
    --arg desired "$criteria_value_3" \
    --arg conflicting "$criteria_value_4" \
    '[.tags[]?.name
      | select((. | ascii_downcase) != ($desired | ascii_downcase))
      | select((. | ascii_downcase) != ($conflicting | ascii_downcase))] + [$desired] | unique' "$run_dir/ticket.json")

# KB-231: deterministic-catches contract — curl transport failure, empty or
# non-JSON-RPC body, and a JSON-RPC .error each fail with a named fatal for
# the exact method; no retries (the workflow's step-retry policy owns it).
rpc() {
    method=$1
    payload=$2
    resp=$(curl -sS -f -u "jsonrpc:$KANBOARD_APP_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg m "$method" --argjson p "$payload" '{jsonrpc:"2.0",method:$m,params:$p,id:1}')" \
        "$KANBOARD_URL") || {
        echo "kanboard rpc transport: $method" >&2
        exit 1
    }
    [ -n "$resp" ] || {
        echo "kanboard rpc transport: $method (empty response)" >&2
        exit 1
    }
    verdict=$(printf '%s' "$resp" | jq -r '
        # KB-231: classify the envelope in one jq pass so an empty or non-JSON-RPC
        # body can never ride through as an rc-0 jq result.
        if (type == "object") and has("jsonrpc") and has("id") then
            if has("error") then
                "ERROR:" + (.error | if (type == "object") and (.message != null) then .message else tostring end)
            else
                "RESULT:" + tostring
            end
        else
            "TRANSPORT"
        end' 2>/dev/null) || verdict=TRANSPORT
    case $verdict in
        RESULT:*)
            printf '%s' "${verdict#RESULT:}"
            ;;
        ERROR:*)
            echo "kanboard rpc error: $method: ${verdict#ERROR:}" >&2
            exit 1
            ;;
        *)
            echo "kanboard rpc transport: $method (non-JSON-RPC body)" >&2
            exit 1
            ;;
    esac
}

tag_params=$(jq -n --argjson project_id "$project_id" --arg tag "$criteria_value_3" '{project_id:$project_id,tag:$tag}')
rpc createTag "$tag_params" >/dev/null
rpc setTaskTags "{\"project_id\":$project_id,\"task_id\":$task_id,\"tags\":$desired}" | jq -e '.result == true' >/dev/null

echo "tag $criteria_value_3 applied; conflicting $criteria_value_4 removed"