#!/usr/bin/env bash
# Template inputs (shellquoted): the port dropped linear_triage_v1's two
# assignment lines, leaving $ticket_id / $intake_root unset under set -u —
# every fetch_ticket step died in 1ms with 'parameter not set'.
intake_root={{ .intake_root | shellquote }}
ticket_id={{ .ticket_id | shellquote }}
# Fetch a Kanboard task and its comment history into ticket.json.
# Ported from linear_triage_v1's fetch_ticket.sh.tftpl: the Linear GraphQL
# issue(id:) lookup becomes Kanboard's getTask + getTaskTags + getAllComments.
#
# ticket_id here is the Kanboard TASK ID (a bare integer, e.g. "10"); the
# KB- prefix is added by the watcher's Identifier() and stripped here so
# filesystem paths stay plain digits. Output envelope shape is kept analogous
# to the Linear fetch: {"task": {...}, "tags": [...], "comments": [...]} so
# downstream scripts read .task.* instead of .data.issue.*.
set -euo pipefail
command -v curl jq >/dev/null
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set -- export it before criteria apply}"
: "${KANBOARD_URL:?KANBOARD_URL is not set -- export it before criteria apply}"

# Accept both "10" and "KB-10" (the watcher's Identifier form).
case "$ticket_id" in
    ''|*[!A-Za-z0-9-]*)
        echo "ticket_id fails identifier validation: '$ticket_id'" >&2
        exit 1
        ;;
esac
task_id="${ticket_id#KB-}"
case "$task_id" in
    ''|*[!0-9]*|*[0-9]*[!0-9]*)
        echo "ticket_id is not a Kanboard task id: '$ticket_id'" >&2
        exit 1
        ;;
esac

run_dir="$intake_root/$ticket_id"
if [ ! -d "$run_dir/workstreams" ]; then
    mkdir -p "$run_dir/workstreams"
fi

# KB-231: deterministic-catches contract — curl transport failure, empty or
# non-JSON-RPC body, and a JSON-RPC .error each fail with a named fatal for
# the exact method; no retries (the workflow's step-retry policy owns it).
rpc() {
    method=$1
    payload=$2
    resp=$(curl -sS -f -u "jsonrpc:$KANBOARD_APP_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg m "$method" --argjson p "$payload" '{jsonrpc:"2.0",method:$m,params:$p,id:1}')" \
        "$KANBOARD_URL") || {
        echo "kanboard rpc transport: $method" >&2
        exit 1
    }
    [ -n "$resp" ] || {
        echo "kanboard rpc transport: $method (empty response)" >&2
        exit 1
    }
    verdict=$(printf '%s' "$resp" | jq -r '
        # KB-231: classify the envelope in one jq pass so an empty or non-JSON-RPC
        # body can never ride through as an rc-0 jq result.
        if (type == "object") and has("jsonrpc") and has("id") then
            if has("error") then
                "ERROR:" + (.error | if (type == "object") and (.message != null) then .message else tostring end)
            else
                "RESULT:" + tostring
            end
        else
            "TRANSPORT"
        end' 2>/dev/null) || verdict=TRANSPORT
    case $verdict in
        RESULT:*)
            printf '%s' "${verdict#RESULT:}"
            ;;
        ERROR:*)
            echo "kanboard rpc error: $method: ${verdict#ERROR:}" >&2
            exit 1
            ;;
        *)
            echo "kanboard rpc transport: $method (non-JSON-RPC body)" >&2
            exit 1
            ;;
    esac
}

envelope=$(rpc getTask "{\"task_id\":$task_id}") || exit 1
# KB-231: an outage must have died inside rpc() with its named fatal; an
# empty result here is the caller-visible not-found condition.
task=$(printf '%s' "$envelope" | jq -c '.result // empty')
if [ -z "$task" ]; then
    echo "Kanboard task not found: $task_id" >&2
    exit 1
fi
# getTaskTags takes ONLY task_id (project_id too fails with -32602) and
# returns a map {tag_link_id: tag_name}; normalize to [{name}] so downstream
# scripts read a stable .tags[].name shape.
tags=$(rpc getTaskTags "{\"task_id\":$task_id}") || exit 1
# KB-231: normalize an absent result to no tags instead of letting jq fail
# unnamed on null.
tags=$(printf '%s' "$tags" | jq -c '[(.result // {})[]] | map({name: .})')
comments=$(rpc getAllComments "{\"task_id\":$task_id}") || exit 1
comments=$(printf '%s' "$comments" | jq -c '.result // []')

jq -n --argjson task "$task" --argjson tags "$tags" --argjson comments "$comments" \
    '{task: $task, tags: $tags, comments: $comments}' > "$run_dir/ticket.json"

printf '%s' "fetched KB-$task_id: $(printf '%s' "$task" | jq -r '.title') [column: $(printf '%s' "$task" | jq -r '.column_id')]"