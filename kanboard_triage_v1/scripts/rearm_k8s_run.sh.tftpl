criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
set -euo pipefail
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set -- export it before criteria apply}"
: "${KANBOARD_URL:?KANBOARD_URL is not set -- export it before criteria apply}"
# KB-235: transport surfaces (TLS timeout, connection refused/reset) hit
# 60-90s blackout windows where an immediate retry fails identically
# (KB-48/KB-225). The shared gh_retry shim (vendored per tree) retries
# those classes with the exponential 30s/60s/120s schedule; HTTP 4xx
# passes through in a single call, so the KB-231 named fatals below keep
# firing exactly once for deterministic failures.
{{ .gh_retry }}
run_dir="$criteria_value_1/$criteria_value_2"
task_id="${criteria_value_2#KB-}"

# Ready-for-development re-arm: re-attach the run-arming tag so the
# development route fires automatically once the task lands in the ready
# column. Ported from linear_triage_v1's rearm_k8s_run.sh.tftpl. Kanboard's
# setTaskTags has REPLACE semantics, so the fresh tag set is read from the
# API (not from ticket.json — setTaskTags in set_classification_label may
# have rewritten tags earlier in this run) and merged with the arming tag.
project_id=$(jq -r '.task.project_id' "$run_dir/ticket.json")

# KB-231: deterministic-catches contract — curl transport failure, empty or
# non-JSON-RPC body, and a JSON-RPC .error each fail with a named fatal for
# the exact method. KB-235: curl transport classes now retry INSIDE
# gh_retry with the bounded 30s/60s/120s schedule; the KB-231
# deterministic catches stay single-shot.
rpc() {
    method=$1
    payload=$2
    resp=$(gh_retry curl -sS -f -u "jsonrpc:$KANBOARD_APP_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg m "$method" --argjson p "$payload" '{jsonrpc:"2.0",method:$m,params:$p,id:1}')" \
        "$KANBOARD_URL") || {
        echo "kanboard rpc transport: $method" >&2
        exit 1
    }
    [ -n "$resp" ] || {
        echo "kanboard rpc transport: $method (empty response)" >&2
        exit 1
    }
    verdict=$(printf '%s' "$resp" | jq -r '
        # KB-231: classify the envelope in one jq pass so an empty or non-JSON-RPC
        # body can never ride through as an rc-0 jq result.
        if (type == "object") and has("jsonrpc") and has("id") then
            if has("error") then
                "ERROR:" + (.error | if (type == "object") and (.message != null) then .message else tostring end)
            else
                "RESULT:" + tostring
            end
        else
            "TRANSPORT"
        end' 2>/dev/null) || verdict=TRANSPORT
    case $verdict in
        RESULT:*)
            printf '%s' "${verdict#RESULT:}"
            ;;
        ERROR:*)
            echo "kanboard rpc error: $method: ${verdict#ERROR:}" >&2
            exit 1
            ;;
        *)
            echo "kanboard rpc transport: $method (non-JSON-RPC body)" >&2
            exit 1
            ;;
    esac
}

# getTaskTags takes ONLY task_id (project_id too fails with -32602) and
# returns a map {tag_link_id: tag_name}; unwrap and normalize to names.
current=$(rpc getTaskTags "{\"task_id\":$task_id}")
current_tags=$(printf '%s' "$current" | jq -c '[(.result // {})[]]')
# KB-231: normalize an absent result to no tags instead of letting jq fail
# unnamed on null.

if printf '%s' "$current_tags" | jq -e --arg wanted "$criteria_value_3" 'index($wanted)' >/dev/null; then
    echo "task already carries $criteria_value_3; no re-arm write needed"
    exit 0
fi

tags=$(printf '%s' "$current_tags" | jq -c --arg arm "$criteria_value_3" '. + [$arm] | unique')

tag_params=$(jq -n --argjson project_id "$project_id" --arg tag "$criteria_value_3" '{project_id:$project_id,tag:$tag}')
rpc createTag "$tag_params" >/dev/null
rpc setTaskTags "{\"project_id\":$project_id,\"task_id\":$task_id,\"tags\":$tags}" | jq -e '.result == true' >/dev/null

echo "task re-armed with $criteria_value_3"