// Fixture F8 (C18b): the never-finalize stimulus — the session produces no
// finalize, so the turn budget exhausts. The step's declared fallback arm
// catches that no-finalize path BY NAME and routes it to the failed
// terminal: the observation is loud AND routed (a committed StepOutcome
// carrying the typed fallback name, the run ends on the failure terminal),
// not the retired outcome_not_allowed routing class.
workflow {
    name             = "harness_contracts_v1_f8_unmapped"
    version          = "1"
    criteria_version = ">=0.5.9, >=0.5.52-rc1, <0.6.0"
    initial_state    = "contract_unmapped"
    target_state     = "done"
    policy { max_total_steps = 6 }
}

step "contract_unmapped" {
    outcome "approved" {
        schema = object({ reason = string })
        next   = state.done
    }
    outcome "finalize_exhausted" {
        fallback = true
        next     = state.failed
    }
    target      = adapter.copilot.main
    allow_tools = []
    input {
        prompt = templatefile("./agents/contract_unmapped.md.tftpl", {})
    }
}

state "done" {
    terminal = true
    success  = true
}
state "failed" {
    terminal = true
    success  = false
}
