probe_root={{ .probe_root | shellquote }}
record_name={{ .record_name | shellquote }}
record_value={{ .record_value | shellquote }}
set -eu
command -v printf >/dev/null

# Fixed-content composition probe records (KB-278): every record carries the
# static identity value AND the two runtime environment markers:
#   composition_env_shadow — reads "parent" on substituted pods (G7); this
#     callee's own contrast value ("callee-shadow") must NEVER be observed —
#     substituting this declaration away IS the ADR-0009 stimulus.
#   iteration_env_marker — reads empty inside the callee (the iteration body
#     environment exists only in the parent's iteration scopes, G2 evidence).
records_dir="$probe_root/composition_probe_records"
mkdir -p "$records_dir"
record="$records_dir/$record_name"
{
    printf 'record_name=%s\n' "$record_name"
    printf 'record_value=%s\n' "$record_value"
    printf 'composition_env_shadow=%s\n' "$COMPOSITION_ENV_SHADING"
    printf 'iteration_env_marker=%s\n' "$ITERATION_ENV_MARKER"
} > "$record"
echo "composition record written: $record"