// KB-278 G5 fixture environments/adapters: one remote environment and the
// copilot member it hosts — the copilot kind deliberately lacks the
// parallel_safe capability.

environment "remote" "guard_env" {
    per_scope_sessions = true
    working_directory  = var.guard_root
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

adapter "copilot" "guarded" {
    source      = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version     = "0.5.15"
    environment = remote.guard_env
}