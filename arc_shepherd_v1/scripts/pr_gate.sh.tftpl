#!/bin/sh
# pr_gate.sh REPO DEV_ACTOR [TICKET_PREFIX] -> JSON {state,author,url,gate} for
# the ticket's OWN open PR (branch naming convention kb-<id>-* from develop runs); other open
# PRs (dependabot, unrelated work) never gate this child's lane. Deterministic gh reads only.
REPO="$1"; DEV_ACTOR="$2"; TICKET_PREFIX="${3:-}"
PR_JSON=$(gh pr list --repo "$REPO" --state all --limit 30 --json number,author,url,headRefName,mergeable,mergeStateStatus,state 2>/dev/null \
  | jq -c --arg pre "$TICKET_PREFIX" \
      'if $pre == "" then . else [.[] | select(.headRefName | ascii_downcase | startswith($pre))] end')
[ -n "$PR_JSON" ] || { echo '{"state":"none","author":"none","url":"","gate":"none"}'; exit 0; }
# newest own PR — MERGED beats OPEN (post-merge reconciliation wins)
PR_OPEN=$(printf '%s' "$PR_JSON" | jq -c '[.[] | select(.state == "OPEN")] | sort_by(.number) | reverse | .[0] // empty')
PR_MERGED=$(printf '%s' "$PR_JSON" | jq -c '[.[] | select(.state == "MERGED")] | sort_by(.number) | reverse | .[0] // empty')
if [ -n "$PR_MERGED" ] && [ -z "$PR_OPEN" ]; then
    MNUM=$(printf '%s' "$PR_MERGED" | jq -r '.number')
    MURL=$(printf '%s' "$PR_MERGED" | jq -r '.url')
    jq -n --arg state merged --arg author "$(printf '%s' "$PR_MERGED" | jq -r '.author.login')" \
        --arg url "$MURL" --arg gate green --argjson num "$MNUM" \
        '{state:$state,author:$author,url:$url,gate:$gate,number:$num}'
    exit 0
fi
PR="$PR_OPEN"
[ -n "$PR" ] || { echo '{"state":"none","author":"none","url":"","gate":"none"}'; exit 0; }
NUM=$(printf '%s' "$PR" | jq -r '.number')
AUTH=$(printf '%s' "$PR" | jq -r '.author.login // "none"')
URL=$(printf '%s' "$PR" | jq -r '.url')
# check rollup: all completed + all success = green; any pending/in_progress = wait; any failure = red
ROLL=$(gh pr view "$NUM" --repo "$REPO" --json statusCheckRollup 2>/dev/null | jq -c '.statusCheckRollup')
if [ -z "$ROLL" ] || [ "$ROLL" = "null" ]; then GATE=none
else
  GATE=$(printf '%s' "$ROLL" | jq -r '
    map(.status) | if length == 0 then "none"
    elif any(. == "IN_PROGRESS" or . == "PENDING" or . == "QUEUED") then "wait"
    elif any(. == "FAILURE" or . == "ERROR" or . == "CANCELLED") then "red"
    else "green" end')
fi
# approvals: >=1 REVIEW from a non-author identity
APPROVED=$(gh pr view "$NUM" --repo "$REPO" --json latestReviews 2>/dev/null | jq -r \
  --arg dev "$DEV_ACTOR" \
  '[.latestReviews[] | select(.author.login != $dev) | select(.state == "APPROVED")] | length > 0')
[ "$APPROVED" = "true" ] && GATE="$GATE" || GATE=$(printf '%s' "$GATE" | sed 's/^green$/wait/')
jq -n --arg state open --arg author "$AUTH" --arg url "$URL" --arg gate "$GATE" \
  '{state:$state,author:$author,url:$url,gate:$gate}'
