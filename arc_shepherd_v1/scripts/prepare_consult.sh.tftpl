#!/bin/sh
# prepare_consult.sh — assemble the read-only material bundle for the guidance
# agent at <run_root>/consult/bundle.md. Deterministic, no judgment.
set -eu
RUN_ROOT="{{ .run_root }}"
export KB_URL="${KB_URL:?KB_URL not in environment}"
export KB_TOKEN="${KB_TOKEN:?KB_TOKEN not in environment}"
CASTLE="{{ .castle_url }}"
SHEP_MANIFEST="{{ .arc_manifest }}"
MATERIAL="{{ .material }}"

BUNDLE="$RUN_ROOT/consult/bundle.md"
mkdir -p "$RUN_ROOT/consult"
: > "$BUNDLE"

# shellcheck source=kb_lib.sh.tftpl
. "$RUN_ROOT/lib/kb_lib.sh"

{
    echo "# Guidance consult bundle — $(date -u +%FT%TZ)"
    echo
    echo "## Ambiguity record (from the shepherd)"
    echo '```'
    printf '%s\n' "$MATERIAL"
    echo '```'
    echo
    if [ -s "$RUN_ROOT/round_action.json" ]; then
        echo "## Decided-but-unconfirmed action"
        echo '```json'
        cat "$RUN_ROOT/round_action.json"
        echo '```'
        echo
    fi
    # ticket context: the ambiguity record usually carries "task <id> ..." —
    # attach body + comment tail for every task id mentioned
    for tid in $(printf '%s' "$MATERIAL" | grep -oE '\b[0-9]{2,3}\b' | sort -u | head -4); do
        echo "## Ticket $tid body"
        echo '```'
        kb_task "$tid" | jq -r '.title, (.description // "")' 2>/dev/null | head -80 || echo "(fetch failed)"
        echo '```'
        echo
        echo "## Ticket $tid comment tail (latest 5)"
        echo '```'
        kb_comments "$tid" | jq -r '[.[]] | reverse | .[0:5][] | "== " + (.date_creation|tostring) + " uid=" + (.user_id|tostring) + " ==\n" + .comment' 2>/dev/null | head -120 || echo "(fetch failed)"
        echo '```'
        echo
    done
    # castle event tail for any run id mentioned
    for rid in $(printf '%s' "$MATERIAL" | grep -oE '\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b' | sort -u | head -2); do
        echo "## Castle events $rid (tail)"
        echo '```'
        curl -sS -m 20 -X POST "$CASTLE/criteria.v1.ServerService/ListRunEvents" \
            -H 'Content-Type: application/json' -d "{\"runId\":\"$rid\"}" \
          | jq -r '[.events[-12:][] | (.stepOutcome // .stepTransition // .runCompleted // .stepEntered // {seq:.seq})] | .[] | tostring' 2>/dev/null \
          || echo "(event fetch failed)"
        echo '```'
        echo
    done
    # cited-but-unsupplied artifacts are the #1 escalation cause: embed them
    echo "## Arc manifest (verbatim)"
    echo '```json'
    cat "$SHEP_MANIFEST" 2>/dev/null || echo "(manifest path not resolvable)"
    echo '```'
    echo
    echo "## Decide log (round_action.json + stall counter)"
    echo '```json'
    cat "$RUN_ROOT/round_action.json" 2>/dev/null || echo "(no action recorded)"
    echo '```'
    echo '```'
    echo "stall_counter=$(cat "$RUN_ROOT/stall_counter" 2>/dev/null || echo 0)"
    echo '```'
    echo
    # pinned doctrine excerpts (checked into the tree; the consult must see
    # the rulings that bound its authority)
    if [ -r "$RUN_ROOT/lib/doctrine.md" ]; then
        echo "## Pinned doctrine excerpts"
        cat "$RUN_ROOT/lib/doctrine.md"
        echo
    fi
} >> "$BUNDLE"

echo "bundle_bytes=$(wc -c < "$BUNDLE")" >&2
exit 0