variable "ticket_id" {
    description = "Kanboard task identifier to process (e.g. \"KB-10\", as the watcher stamps it; a bare task id \"10\" is also accepted). Doubles as the run's slug: every artifact lives under <intake_root>/<ticket_id>/. The workflow assumes the task is triaged — fired on a Ready-column task whose comments carry the triage outputs."
    type        = string
}

variable "provider_base_url" {
    description = "Optional provider base URL override for every agent in the composed workflow. Empty preserves each agent's configured URL."
    type        = string
    default     = ""
}

// Defaults to "" rather than being required: it is referenced from adapter
// config, which must be resolvable at compile time. A required variable leaves
// it unknown and the compile fails. Always pass it at apply time.
variable "repo_dir" {
    description = "Absolute path of the repository's primary working tree. Passed through to workstream_handler_v1, which runs all repo operations itself. Empty runs in the process working directory."
    type        = string
    default     = ""
}

// Deliberately OUTSIDE the repository under test, same discipline as
// qa_triage_v1's triage_root: development artifacts (ticket JSON, confirmed
// workstream, handler worktree) must never land in the repo's working tree.
// Same default as kanboard_triage_v1, so a workstream the triage phase
// published under this root is found and reused as-is.
variable "intake_root" {
    description = "Absolute path under which per-ticket working directories live (<intake_root>/<ticket_id>/). Must be OUTSIDE the repository under test, and under $HOME or CRITERIA_SHELL_ALLOWED_PATHS. Shared with the triage workflow's default so its published workstream is reused."
    type        = string
    default     = "/tmp/criteria-intake"
}

variable "kanboard_review_column" {
    description = "Name of the Kanboard board column the task is moved to whenever the run ends awaiting a human: the reviewer loop could not conclude, a Kanboard write failed, or the confirmed workstream could not be produced. Resolved by name against the task's project (must exist there — e.g. the watcher's review column \"Review\"); an unknown name fails the run loudly."
    type        = string
    default     = "Review"
}

variable "kanboard_work_column" {
    description = "Name of the Kanboard board column set immediately before implementation begins. Resolved against the task's project."
    type        = string
    default     = "Work in progress"
}

variable "kanboard_done_column" {
    description = "Name of the Kanboard board column set after the implementation PR has merged. Resolved against the task's project; an unknown name fails the step loudly and routes the run to the review column with the merge already recorded in a comment."
    type        = string
    default     = "Done"
}

// ── workstream_handler_v1 pass-throughs ──────────────────────────────────────

variable "base_branch" {
    description = "workstream_handler_v1: base branch to fork from and validate against."
    type        = string
    default     = "main"
}

variable "ci_gate_cmd" {
    description = "Command the pair programming loop runs as its CI gate (exit 0 = clean). Empty (the default) skips the gate. Set it to mirror what the remote CI actually runs — a repo's aggregate target often omits gates CI runs separately (e.g. a vulnerability scan), and any gate missing here is one the developer only discovers after the PR is already red (e.g. 'make ci && make vuln-scan')."
    type        = string
    default     = ""
}

variable "merge_ci_max_seconds" {
    description = "merge-gate wait budget in seconds forwarded to workstream_handler_v1: post-merge deadline for the squash commit's own CI to complete green (the standing KB-272 gate). Default 1200 covers the observed normal criteria squash-CI envelope (690s end-to-end on KB-347, 2026-11-03) with 2x headroom; per-project values ride the workflow binding env map via the tree interface (env: MERGE_CI_MAX_SECONDS is a declared env name — a cut-over binding MUST deliver a value; the pre-cut-over path stays on this default). The wait_merge_ci.sh MERGE_CI_MAX_SECONDS env override applies after render; values above 3540 exceed the wait step's 3600s timeout envelope and fail closed before the deadline. Extreme tails beyond any in-run budget park to a human via the KB-272 withhold — KB-328 recovery re-verdicts the already-merged PR."
    type        = number
    default     = 1200
}

variable "allow_dirty" {
    description = "workstream_handler_v1: allow the pair programming loop to run even if the working tree has uncommitted changes."
    type        = bool
    default     = false
}

// ── Kanboard API ─────────────────────────────────────────────────────────────

variable "kanboard_url" {
    description = "Kanboard JSON-RPC endpoint (jsonrpc.php, subpath included). All Kanboard I/O goes through it with the app token."
    type        = string
    secret      = true
}

variable "kanboard_app_token" {
    type   = string
    secret = true
}

variable "workflow_github_token" {
    type   = string
    secret = true
}

// GitHub token for the reviewer identity. Kept separate from
// the workflow token: the handler's reviewer role must authenticate as the
// reviewer identity, which differs from the identity that authors the PR.
variable "reviewer_github_token" {
    type   = string
    secret = true
}

// Upstream credential lane (pair-loop remaster): declared for interface
// parity with secretEnv WORKFLOW_UPSTREAM_TOKEN (KB-304 class — a secretEnv
// name must map to a secret-typed variable). The runner delivers the value
// as env -> CSI file path via the binding env map; the tree passes it to the
// upstream_sync subworkflow chain only as the binding env name, never
// adapter secrets.
variable "workflow_upstream_token" {
    type   = string
    secret = true
}
