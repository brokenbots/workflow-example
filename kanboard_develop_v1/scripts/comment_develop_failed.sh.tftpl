criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
criteria_value_4={{ .criteria_value_4 | shellquote }}
set -euo pipefail
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set -- export it before criteria apply}"
: "${KANBOARD_URL:?KANBOARD_URL is not set -- export it before criteria apply}"
# KB-235: transport surfaces (TLS timeout, connection refused/reset) hit
# 60-90s blackout windows where an immediate retry fails identically
# (KB-48/KB-225). The shared gh_retry shim (vendored per tree) retries
# those classes with the exponential 30s/60s/120s schedule; HTTP 4xx
# passes through in a single call, so the KB-231 named fatals below keep
# firing exactly once for deterministic failures.
{{ .gh_retry }}
run_dir="$criteria_value_1/$criteria_value_2"
task_id="${criteria_value_2#KB-}"

if [ -n "$criteria_value_3" ]; then
    body="**Automated development did not start.** The confirmed workstream could not be produced or the work-state move failed. Workstream: $criteria_value_3. Moving the ticket to $criteria_value_4 for a human. The run record carries the failing step and its error."
else
    body="**Automated development did not start.** The confirmed workstream could not be produced or the work-state move failed. Workstream: (none). Moving the ticket to $criteria_value_4 for a human. The run record carries the failing step and its error."
fi

# KB-51: params must carry both the task id and the body — this jq -n once
# forgot --arg task_id, so the JSON-RPC request body was empty and the step
# failed on every Kanboard develop run. createComment resolves to the new
# comment_id (a number), never boolean true; a `.result == true` check marked
# even successful posts as step failures.
# KB-231: capture the response and fail with a named fatal on curl transport
# errors, empty bodies and non-JSON-RPC (302 HTML) bodies — an empty body
# used to ride through the pipe as an rc-0 jq and surface later as
# "invalid JSON text passed to --argjson" with no failing stage named.
resp=$(gh_retry curl -sS -f \
    -u "jsonrpc:$KANBOARD_APP_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg m 'createComment' \
        --arg task_id "$task_id" \
        --arg body "$body" \
        '{jsonrpc:"2.0",method:$m,params:{task_id:($task_id|tonumber),user_id:0,content:$body},id:1}')" \
    "$KANBOARD_URL") || {
    echo "kanboard rpc transport: createComment (curl rc $?)" >&2
    exit 1
}
[ -n "$resp" ] || {
    echo "kanboard rpc transport: createComment (empty response)" >&2
    exit 1
}
verdict=$(printf '%s' "$resp" | jq -r '
    # KB-231: classify the envelope in one jq pass so an empty or non-JSON-RPC
    # body can never ride through as an rc-0 jq result.
    if (type == "object") and has("jsonrpc") and has("id") then
        if has("error") then
            "ERROR:" + (.error | if (type == "object") and (.message != null) then .message else tostring end)
        else
            "RESULT:" + tostring
        end
    else
        "TRANSPORT"
    end' 2>/dev/null) || verdict=TRANSPORT
case $verdict in
    RESULT:*)
        printf '%s' "${verdict#RESULT:}" | jq -e '.result | type == "number"' >/dev/null \
            || { echo "kanboard rpc error: createComment (non-numeric comment_id, KB-51)" >&2; exit 1; }
        ;;
    ERROR:*)
        echo "kanboard rpc error: createComment: ${verdict#ERROR:}" >&2
        exit 1
        ;;
    *)
        echo "kanboard rpc transport: createComment (non-JSON-RPC body)" >&2
        exit 1
        ;;
esac

echo "comment posted"
