criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
set -euo pipefail
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set -- export it before criteria apply}"
: "${KANBOARD_URL:?KANBOARD_URL is not set -- export it before criteria apply}"
run_dir="$criteria_value_1/$criteria_value_2"
task_id="${criteria_value_2#KB-}"

# Move the task to a named board column. Ported from linear_triage_v1's
# set_review_state.sh.tftpl: Linear's workflowStates name->id resolution +
# issueUpdate becomes getColumns name->id resolution + moveTaskPosition.
# The move is idempotent (no-op when the task is already in the column).
# An unknown column name fails loudly rather than silently leaving the task
# unmoved — same fail-loud contract as the Linear original.
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set}"
project_id=$(jq -r '.task.project_id' "$run_dir/ticket.json")

# KB-231: deterministic-catches contract — curl transport failure, empty or
# non-JSON-RPC body, and a JSON-RPC .error each fail with a named fatal for
# the exact method; no retries (the workflow's step-retry policy owns it).
rpc() {
    method=$1
    payload=$2
    resp=$(curl -sS -f -u "jsonrpc:$KANBOARD_APP_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg m "$method" --argjson p "$payload" '{jsonrpc:"2.0",method:$m,params:$p,id:1}')" \
        "$KANBOARD_URL") || {
        echo "kanboard rpc transport: $method" >&2
        exit 1
    }
    [ -n "$resp" ] || {
        echo "kanboard rpc transport: $method (empty response)" >&2
        exit 1
    }
    verdict=$(printf '%s' "$resp" | jq -r '
    # KB-231: classify the envelope in one jq pass so an empty or non-JSON-RPC
    # body can never ride through as an rc-0 jq result.
    if (type == "object") and has("jsonrpc") and has("id") then
        if has("error") then
            "ERROR:" + (.error | if (type == "object") and (.message != null) then .message else tostring end)
        else
            "RESULT:" + tostring
        end
    else
        "TRANSPORT"
    end' 2>/dev/null) || verdict=TRANSPORT
    case $verdict in
        RESULT:*)
            printf '%s' "${verdict#RESULT:}"
            ;;
        ERROR:*)
            echo "kanboard rpc error: $method: ${verdict#ERROR:}" >&2
            exit 1
            ;;
        *)
            echo "kanboard rpc transport: $method (non-JSON-RPC body)" >&2
            exit 1
            ;;
    esac
}

envelope=$(rpc getTask "{\"task_id\":$task_id}") || exit 1
# KB-231: an outage must have died inside rpc() with its named fatal; an
# empty result here is the caller-visible not-found condition. Feeding an
# empty $task downstream would defer the failure to a later jq (previously
# surfacing as "invalid JSON text passed to --argjson").
task=$(printf '%s' "$envelope" | jq -c '.result // empty')
if [ -z "$task" ]; then
    echo "Kanboard task not found: $task_id" >&2
    exit 1
fi
current_col=$(printf '%s' "$task" | jq -r '.column_id')

envelope=$(rpc getColumns "{\"project_id\":$project_id}") || exit 1
cols=$(printf '%s' "$envelope" | jq -c '.result // []')
target_col=$(printf '%s' "$cols" | jq -r --arg name "$criteria_value_3" 'map(select(.title == $name)) | .[0].id // empty')

if [ -z "$target_col" ]; then
    echo "Kanboard column '$criteria_value_3' not found on project $project_id" >&2
    exit 1
fi

if [ "$target_col" = "$current_col" ]; then
    echo "task already in column '$criteria_value_3'"
    exit 0
fi

swimlane_id=$(printf '%s' "$task" | jq -r '.swimlane_id // 1')
swimlane_id=$(printf '%s' "$task" | jq -r '.swimlane_id // 1')
rpc moveTaskPosition "{\"project_id\":$project_id,\"task_id\":$task_id,\"column_id\":$target_col,\"position\":1,\"swimlane_id\":$swimlane_id}" \
    | jq -e '.result == true' >/dev/null

echo "task moved to $criteria_value_3"