criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
criteria_value_4={{ .criteria_value_4 | shellquote }}
criteria_value_5={{ .criteria_value_5 | shellquote }}
set -euo pipefail
: "${KANBOARD_APP_TOKEN:?KANBOARD_APP_TOKEN is not set -- export it before criteria apply}"
: "${KANBOARD_URL:?KANBOARD_URL is not set -- export it before criteria apply}"
# KB-235: transport surfaces (TLS timeout, connection refused/reset) hit
# 60-90s blackout windows where an immediate retry fails identically
# (KB-48/KB-225). The shared gh_retry shim (vendored per tree) retries
# those classes with the exponential 30s/60s/120s schedule; HTTP 4xx
# passes through in a single call, so the KB-231 named fatals below keep
# firing exactly once for deterministic failures.
{{ .gh_retry }}
run_dir="$criteria_value_1/$criteria_value_2"
task_id="${criteria_value_2#KB-}"

body="**The implementation handler failed.** Workstream: $criteria_value_3. Moving the ticket to $criteria_value_4 for a human. The handler's reviewer loop could not conclude (no reviewer verdict, or the bounded fix cycle did not converge), or an infrastructure step inside the handler failed. The handler's run record carries the step-level error."
# KB-24: the handler now reports a typed failure reason (empty when it died
# without one) — surface it on the parked ticket for the human.
if [ -n "$criteria_value_5" ]; then
    body="$body Handler failure reason: $criteria_value_5."
fi

# KB-57: persist the request/response/rc (see comment_handler_started.tftpl).
mkdir -p "$run_dir"
diag="$run_dir/comment_diag.log"
{
    echo "=== createComment(handler_failed) attempt $(date -u +%FT%TZ)"
    echo "KANBOARD_URL=[$KANBOARD_URL] task_id=$task_id body_len=${#body}"
} >> "$diag" 2>&1
resp=$(gh_retry curl -sS -f \
    -u "jsonrpc:$KANBOARD_APP_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg m 'createComment' \
        --arg task_id "$task_id" \
        --arg body "$body" \
        '{jsonrpc:"2.0",method:$m,params:{task_id:($task_id|tonumber),user_id:0,content:$body},id:1}')" \
    "$KANBOARD_URL" 2>>"$diag") || {
    # KB-231: name the failing stage — curl already logged its detail to $diag.
    echo "kanboard rpc transport: createComment (see $diag)" >&2
    exit 1
}
echo "response_len=${#resp}" >> "$diag" 2>&1
# KB-231: an empty or non-JSON-RPC (302 HTML) body is the same transport
# failure — never let an empty body ride through as an rc-0 jq.
[ -n "$resp" ] || {
    echo "kanboard rpc transport: createComment (empty response, see $diag)" >&2
    exit 1
}
verdict=$(printf '%s' "$resp" | jq -r '
    # KB-231: classify the envelope in one jq pass so an empty or non-JSON-RPC
    # body can never ride through as an rc-0 jq result.
    if (type == "object") and has("jsonrpc") and has("id") then
        if has("error") then
            "ERROR:" + (.error | if (type == "object") and (.message != null) then .message else tostring end)
        else
            "RESULT:" + tostring
        end
    else
        "TRANSPORT"
    end' 2>>"$diag") || verdict=TRANSPORT
case $verdict in
    RESULT:*)
        printf '%s' "${verdict#RESULT:}" | jq -e '.result | type == "number"' >>"$diag" 2>&1 \
            || { echo "kanboard rpc error: createComment (non-numeric comment_id, KB-51), see $diag" >&2; exit 1; }
        ;;
    ERROR:*)
        echo "kanboard rpc error: createComment: ${verdict#ERROR:} (see $diag)" >&2
        exit 1
        ;;
    *)
        echo "kanboard rpc transport: createComment (non-JSON-RPC body, see $diag)" >&2
        exit 1
        ;;
esac
# KB-51: createComment resolves to the new comment_id (a number), never the
# boolean true moveTaskPosition-style calls return — a `.result == true`
# check marked every successful post as a step failure.

echo "comment posted"
