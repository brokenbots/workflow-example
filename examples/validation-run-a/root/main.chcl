// validation_run_a — the root fixture of the CRI-244 validation run A
// (M10.2, plan CRI-214 exit condition 1): a REMOTE workflow whose subworkflow
// is also remote (cascade per CRI-227), executed through the criteria-base
// image entrypoint contract (WORKFLOW_URL + optional WORKFLOW_REF).
//
// In the live validation run the entrypoint is invoked with
//   WORKFLOW_URL=git::https://github.com/brokenbots/workflow-example.git//examples/validation-run-a/root?ref=<commit>
//   WORKFLOW_REF=<commit>
// so the base image fetches this module from its git URL and enforces the
// declared pin (D7, CRI-226) before anything executes.
//
// The child module lives at its own git URL — this module's tree carries no
// child copy, so the fetch cascades into the nested cache layout
// cache/workflows/<root-slug>/subworkflows/<child-slug>/<version>. D7 pinning
// is exercised twice on the child: `ref` below (compile-time, fail closed)
// and the workflow_ref entry `criteria adapter lock` records in
// .criteria.lock.hcl.

workflow {
    name             = "validation_run_a"
    version          = "1"
    criteria_version = ">=0.5.24-10, <0.6.0"
    initial_state    = "invoke_child"
    target_state     = "done"
}

variable "ticket_id" {
    type    = string
    default = ""
}

variable "linear_api_key" {
    type        = string
    secret      = true
    description = "Linear API key; handed to the child for its evidence comment, bound to the child's adapter over the secret channel. Secret variables are masked ((sensitive)) in run transcripts, step inputs, and the variable.set event stream."
}

// REMOTE subworkflow source (cascade). The ref pin names the child commit the
// root's lockfile records; a drifted child fails closed at compile.
subworkflow "child" {
    source = "git::https://github.com/brokenbots/workflow-example.git//examples/validation-run-a/child?ref=2197d4fbedf6be57a8dcf7ca646fe43aa96c2302"
    ref    = "2197d4fbedf6be57a8dcf7ca646fe43aa96c2302"
    input = {
        ticket_id      = var.ticket_id
        linear_api_key = var.linear_api_key
    }
}

adapter "shell" "ack" {
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.3"
}

step "invoke_child" {
    target = subworkflow.child
    outcome "success" { next = step.ack }
    outcome "failure" { next = state.failed }
}

step "ack" {
    target = adapter.shell.ack
    input {
        command = templatefile("./scripts/ack.sh.tftpl", {
            child_evidence = steps.invoke_child.evidence
        })
    }
    outcome "success" { next = state.done }
    outcome "failure" { next = state.failed }
}

state "done" {
    terminal = true
    success  = true
}

state "failed" {
    terminal = true
    success  = false
}