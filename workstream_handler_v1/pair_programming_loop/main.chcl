workflow {
    version       = "1"
    name          = "pair_loop"
    initial_state = "get_branch_name"
    target_state  = "done"

    policy {
        max_total_steps = 100
    }
}

data "internal" "branch" {
    type  = string
    value = ""
}

data "internal" "status" {
    type  = string
    value = ""
}

data "internal" "_log_file" {
    type  = string
    value = ""
}

data "internal" "developer_prompt" {
    type  = string
    value = "if you get this prompt there is a serious error, use the `submit_outcome` tool get help with an outcome of `need_help` and a reason of `default error prompt, should be development prompt`"
}

data "internal" "reviewer_prompt" {
    type  = string
    value = ""
}

// Verdict of the last review pass ("approved" / "changes_requested"). Written
// by the review step's outcome handlers and read by triage_review — the copilot
// adapter does not expose an `outcome` step output, so the workflow tracks the
// verdict itself rather than reading steps.review.outcome.
data "internal" "review_verdict" {
    type  = string
    value = ""
}

step "get_branch_name" {
    target = adapter.shell.sh

    input {
        command = "basename '${var.workstream_file}' .md"
    }

    outcome "success" { next = step.read_workstream }
    outcome "failure" { next = state.failed }
}

step "read_workstream" {
    target = adapter.shell.sh

    input {
        command = "cat ${var.workstream_file}"
    }

    outcome "success" { next = step.init_variables }
    outcome "failure" { next = state.failed }
}

step "init_variables" {
    target = adapter.noop.default
    input  {}
    outcome "success" {
        next = step.checkout_branch
        write {
            target = data.internal.branch.value
            value  = steps.get_branch_name.stdout
        }
        write {
            target = data.internal._log_file.value
            value  = (var.log_file != null && var.log_file != "") ? var.log_file : "/tmp/${trimspace(steps.get_branch_name.stdout)}.log"
        }
        write {
            target = data.internal.developer_prompt.value
            value  = var.developer_initial_prompt != "" ? var.developer_initial_prompt : (var.developer.initial_prompt != "" ? var.developer.initial_prompt : "Review the details for this workstream and then work through each item until its complete and addresses the workstream requirements, when finished call the submit_outcome tool with details of the work in the reason field.\n\nworkstream details:\n${steps.read_workstream.stdout}\n\nmake sure to end the session by calling the `submit_outcome` tool with the correct value.")
        }
        write {
            target = data.internal.reviewer_prompt.value
            value  = "Review the changes for this workstream. Inspect the actual diffs and commits yourself (git diff, git log) — do not rely on the developer's notes alone. Verify the changes match what the developer stated and meet the workstream requirements.\n\nworkstream details:\n${steps.read_workstream.stdout}"
        }
    }
}

// The isolated worktree is already on the feature branch (branch_manager created
// it). Assert that rather than checking out, so a misconfigured worktree fails
// loudly instead of silently developing on the wrong branch.
step "checkout_branch" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail
            expected=$(basename '${var.workstream_file}' .md)
            current=$(git branch --show-current)
            if [ "$current" != "$expected" ]; then
                echo "expected branch '$expected' but worktree is on '$current'" >&2
                exit 1
            fi
            echo "on_branch=$current"
        SHELL
    }
    timeout = "10s"
    outcome "success" { next = step.check_working_tree }
    outcome "failure" { next = state.failed }
}

// Inspect the working tree before handing off to the developer. A dirty tree is
// no longer rejected — branch_manager intentionally restores stashed work after a
// rebase, so uncommitted changes here are expected. Instead, fold the status (and
// any branch_manager stash report) into the developer's prompt so they can commit
// what belongs to the workstream and discard the rest.

step "check_working_tree" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail
            if [ "${var.allow_dirty}" = "true" ]; then
                echo "working_tree_check=skipped" >&2
                exit 0
            fi
            notes='${var.branch_notes}'
            status=$(git status --porcelain)
            if [ -n "$status" ]; then
                if [ -n "$notes" ]; then
                    printf '%s\n\n' "$notes"
                fi
                printf 'The working tree has uncommitted changes. Review them, commit anything that belongs to this workstream, and discard the rest:\n%s\n' "$status"
            fi
            exit 0
        SHELL
    }
    outcome "success" {
        next = step.develop
        write {
            target = data.internal.developer_prompt.value
            value  = trimspace(output.stdout) != "" ? "${data.internal.developer_prompt.value}\n\n${output.stdout}" : data.internal.developer_prompt.value
        }
    }
    outcome "failure" { next = state.failed }
}

// max_visits bounds the develop <-> review / ci_gate / verify_committed
// cycles — a stuck exchange fails the run instead of looping forever.
step "develop" {
    target     = adapter.copilot.developer
    max_visits = 10

    allow_tools = ["*"]

    input {
        prompt = data.internal.developer_prompt.value
    }

    outcome "ready_for_review" { next = step.write_work_log }
    outcome "need_help"        { next = state.failed }
    outcome "default"          { next = state.failed }
}

step "write_work_log" {
    target = adapter.shell.sh

    input {
        command = <<-SHELL
            cat >> '${data.internal._log_file.value}' <<'____CRITERIA_EOF____'
${steps.develop.reason}
____CRITERIA_EOF____
        SHELL
    }

    outcome "success" { next = step.commit_work_log }
    outcome "failure" { next = state.failed }
}

// Auto-commit the log file if it is tracked in the repo so verify_committed
// does not see a dirty tree caused by the log write above.
step "commit_work_log" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail
            log="${data.internal._log_file.value}"
            if git ls-files --error-unmatch "$log" 2>/dev/null; then
                git add "$log"
                git commit -m "chore: update work log"
            fi
        SHELL
    }
    outcome "success" { next = step.verify_committed }
    outcome "failure" { next = state.failed }
}

// Ensure the developer committed all changes before we run CI or review.
// Uncommitted files at this point mean the agent forgot to commit; send it back.

step "verify_committed" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail
            status=$(git status --porcelain)
            if [ -n "$status" ]; then
                echo "uncommitted_changes:"
                echo "$status"
                exit 1
            fi
            echo "all_changes_committed=true"
        SHELL
    }
    outcome "success" { next = step.ci_gate }
    outcome "failure" {
        next = step.develop
        write {
            target = data.internal.developer_prompt.value
            value  = "You have uncommitted changes. Stage and commit everything before calling submit_outcome.\n\nCurrent git status:\n${output.stdout}"
        }
    }
}

// Runs var.ci_gate_cmd when set; skipped (trivially succeeds) when empty so
// the workflow works on repos without a standard CI entry point.
step "ci_gate" {
    target = adapter.shell.sh

    input {
        command = var.ci_gate_cmd != "" ? var.ci_gate_cmd : "echo 'ci_gate skipped: no ci_gate_cmd configured'"
    }

    outcome "success" { next = step.review }

    outcome "failure" {
        next = step.develop
        write {
            target = data.internal.developer_prompt.value
            value  = "the ci gate is failing with the following outputs.\n\nstdout:\n${output.stdout}\n\nstderr:\n${output.stderr}"
        }
    }
}

step "review" {
    target     = adapter.copilot.reviewer
    max_visits = 10

    allow_tools = ["*"]

    input {
        prompt = "${data.internal.reviewer_prompt.value}\n\nLast developer update:\n${steps.develop.reason}"
    }

    outcome "need_help" { next = state.failed }
    outcome "approved" {
        next = step.write_review_log
        write {
            target = data.internal.review_verdict.value
            value  = "approved"
        }
    }
    outcome "changes_requested" {
        next = step.write_review_log
        write {
            target = data.internal.review_verdict.value
            value  = "changes_requested"
        }
        // Feed the findings forward on both sides of the loop: the developer
        // gets the remediation list as its next prompt, and the reviewer gets
        // its own prior findings for the re-review pass.
        write {
            target = data.internal.developer_prompt.value
            value  = "The reviewer requested changes. Address every finding below, commit your work, and call submit_outcome with outcome `ready_for_review` when done.\n\nReview findings:\n${output.reason}"
        }
        write {
            target = data.internal.reviewer_prompt.value
            value  = "Re-review: verify the developer's latest commits resolve every finding from your previous review. Inspect the diffs yourself — do not take the developer's notes at face value.\n\nYour previous findings were:\n${output.reason}"
        }
    }
    // The copilot adapter emits "failure" if the session dies or the agent
    // never calls submit_outcome after re-prompts — route it somewhere terminal.
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

step "write_review_log" {
    target = adapter.shell.sh

    input {
        command = <<-SHELL
            cat >> '${data.internal._log_file.value}' <<'____CRITERIA_EOF____'
${steps.review.reason}
____CRITERIA_EOF____
        SHELL
    }

    outcome "success" { next = step.commit_review_log }
    outcome "failure" { next = state.failed }
}

step "commit_review_log" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail
            log="${data.internal._log_file.value}"
            if git ls-files --error-unmatch "$log" 2>/dev/null; then
                git add "$log"
                git commit -m "chore: update review log"
            fi
        SHELL
    }
    outcome "success" { next = switch.triage_review }
    outcome "failure" { next = state.failed }
}

switch "triage_review" {
    match {
        condition = data.internal.review_verdict.value == "approved"
        next      = step.mark_done
    }
    // changes_requested: back to the developer, whose prompt now carries the
    // review findings (written by the review step's changes_requested outcome).
    default {
        next = step.develop
    }
}

// Stamp status="ok" and flush the snapshot before the terminal state so the
// parent's route switch can read it (engine bug: DataStore writes are not
// included in finalVars without an intervening step — mirrors branch_manager).
step "mark_done" {
    target = adapter.noop.default
    input  {}
    outcome "success" {
        next = step.finish
        write {
            target = data.internal.status.value
            value  = "ok"
        }
    }
    outcome "failure" { next = step.finish }
}

step "finish" {
    target = adapter.noop.default
    input  {}
    outcome "success" { next = state.done }
    outcome "failure" { next = state.done }
}

state "done" {
    terminal = true
    success  = true
}

state "failed" {
    terminal = true
    success  = false
}

output "status" {
    type  = string
    value = data.internal.status.value
}
