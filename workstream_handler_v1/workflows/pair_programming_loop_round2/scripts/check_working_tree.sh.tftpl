criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
set -euo pipefail
if [ "$criteria_value_1" = "true" ]; then
    echo "working_tree_check=skipped" >&2
    exit 0
fi
notes="$criteria_value_2"
status=$(git status --porcelain)
if [ -n "$status" ]; then
    if [ -n "$notes" ]; then
        printf '%s\n\n' "$notes"
    fi
    printf 'The working tree has uncommitted changes. Review them, commit anything that belongs to this workstream, and discard the rest:\n%s\n' "$status"
fi
exit 0
