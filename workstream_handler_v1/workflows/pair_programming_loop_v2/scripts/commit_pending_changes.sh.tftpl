# Checkpoint failure arm — commit pending changes (settled ruling 2)
#
# When develop or planner dies mid-turn (timeout, session loss), pending
# changes must not evaporate. This is the accepted durability trade: the
# loss is bounded to one turn's deltas, and this arm preserves them when
# they exist.
#
# Mechanics (ruling 2, verbatim): wholesale `git add -A`, own commit message
# prefixed `wip:` — NEVER an amend, never a push. The workflow owns upstream;
# the caller then delegates the push to upstream_sync.

set -eu 2>/dev/null || true

# Nothing to do when the tree is already clean.
if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
    echo "commit_pending_changes: tree clean; nothing to preserve"
    exit 0
fi

git add -A
git commit -m "wip: preserve pending changes (checkpoint failure arm)" >/dev/null 2>&1 || {
    # `git commit` can still fail on identity config (user.name/email unset)
    # or a locked index; report it as a distinct failure shape.
    echo "commit_pending_changes: commit failed after add -A" >&2
    exit 1
}

echo "commit_pending_changes: committed $(git rev-parse --short HEAD)"
exit 0
