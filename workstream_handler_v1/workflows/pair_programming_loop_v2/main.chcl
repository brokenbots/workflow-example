            target = data.internal.pair_verdict.value
            value  = "part_lost_session"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4 (fast lane) lost its session before a verdict could land: ${try(output.reason, "")}"
        }
    }
    outcome "default" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.pair_verdict.value
            value  = "part_lost_session"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4 (fast lane) returned a malformed response: ${try(output.reason, "malformed part response (no valid outcome)")}"
        }
    }
}

step "run_part_p4_deep" {
    target     = adapter.copilot.pair_part_p4_dev_deep
    max_visits = var.max_agent_visits
    timeout    = "60m"
    allow_tools = ["*"]
    input {
        prompt = templatefile("./agents/pair_part_brief.md.tftpl", {
            part_id        = "p4"
            effort         = try(jsondecode(data.internal.plan_json.value).per_part[3].effort, "deep")
            files_claimed  = join(", ", try(jsondecode(data.internal.plan_json.value).per_part[3].files_claimed, []))
            brief          = try(jsondecode(data.internal.plan_json.value).per_part[3].brief, "")
            acceptance     = try(jsondecode(data.internal.plan_json.value).per_part[3].acceptance, "")
            workstream     = data.internal.workstream_text.value
        })
    }

    outcome "part_ready" {
        next      = step.p4_verify
        schema    = object({ reason = string })
        write {
            target = data.internal.pair_slot_p4_findings.value
            value  = output.reason
        }
    }
    outcome "part_help" {
        next   = step.pair_part_p4_remediate
        schema = object({ reason = string })
        write {
            target = data.internal.pair_slot_p4_verdict.value
            value  = "part_help"
        }
        write {
            target = data.internal.pair_slot_p4_findings.value
            value  = try(output.reason, "") != "" ? try(output.reason, "") : "part_help without a reason"
        }
    }
    outcome "failure" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.pair_verdict.value
            value  = "part_lost_session"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4 (deep lane) lost its session before a verdict could land: ${try(output.reason, "")}"
        }
    }
    outcome "default" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.pair_verdict.value
            value  = "part_lost_session"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4 (deep lane) returned a malformed response: ${try(output.reason, "malformed part response (no valid outcome)")}"
        }
    }
}

step "p4_verify" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = templatefile("./scripts/pair_part_verify.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
            criteria_value_2 = "part_ready"
            criteria_value_3 = data.internal.entry_sha.value
        })
    }
    outcome "success" {
        next = switch.route_slot_p4
        write {
            target = data.internal.pair_slot_p4_verdict.value
            value  = "part_ready"
        }
    }
    outcome "failure" { next = step.p4_refute }
}

step "p4_refute" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "printf '%s\\n' 'slot p4 verify failed; findings follow'; exit 1"
    }
    // Unreachable in practice (p4_verify exits 1 on every findings lane);
    // declared for outcome completeness (KB-374: both paths handled).
    outcome "success" { next = step.pair_part_p4_remediate }
    outcome "failure" {
        next   = step.pair_part_p4_remediate
        write {
            target = data.internal.pair_slot_p4_findings.value
            value  = "p4 verify: ${steps.p4_verify.stderr}"
        }
    }
}

step "pair_part_p4_remediate" {
    target     = adapter.copilot.pair_part_p4_remediator
    max_visits = var.max_agent_visits
    timeout    = "60m"
    allow_tools = ["*"]
    input {
        prompt = templatefile("./agents/pair_part_remediate.md.tftpl", {
            findings       = data.internal.pair_slot_p4_findings.value
            files_claimed  = join(", ", try(jsondecode(data.internal.plan_json.value).per_part[3].files_claimed, []))
        })
    }

    outcome "remediated" {
        next      = step.p4_reverify
        schema    = object({ reason = string })
    }
    outcome "still_broken" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.pair_verdict.value
            value  = "part_remediation_still_broken"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4's remediation did not resolve the findings: ${try(output.reason, "") != "" ? try(output.reason, "") : "still_broken without a reason (the remediation agent's session)"}"
        }
    }
    outcome "failure" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.pair_verdict.value
            value  = "part_remediation_lost_session"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4's remediation lost its session before a verdict could land: ${try(output.reason, "")}"
        }
    }
    outcome "default" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.pair_verdict.value
            value  = "part_remediation_lost_session"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair part slot 4's remediation returned a malformed response: ${try(output.reason, "malformed remediation response (no valid outcome)")}"
        }
    }
}

step "p4_reverify" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = templatefile("./scripts/pair_part_verify.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
            criteria_value_2 = "part_ready"
            criteria_value_3 = data.internal.entry_sha.value
        })
    }
    outcome "success" {
        next = switch.route_slot_p4
        write {
            target = data.internal.pair_slot_p4_verdict.value
            value  = "part_ready"
        }
    }
    outcome "failure" {
        next   = step.pair_part_p4_remediate
        write {
            target = data.internal.pair_slot_p4_findings.value
            value  = "p4 reverify: ${output.stderr}"
        }
    }
}

// The LAST slot's route — the slot chain's exit. Verdict==part_ready with
// any remaining reduced count is IMPOSSIBLE (p4 is the last slot) — the
// only part_ready shape here is count==4, the chain exit to the checkpoint
// push. TODO-5's stale part_help siblings (reading p1..p3's verdicts) are
// REMOVED — remediation re-entries are max_visits-bounded inside the
// slot's own (verify/refute -> remediate -> reverify) sub-chains.
switch "route_slot_p4" {
    match {
        condition = data.internal.pair_slot_p4_verdict.value == "part_ready" && data.internal.part_count.value == "4"
        next      = step.push_checkpoint
    }
    default {
        next = step.fail_verdict_mismatch
    }
}

// ── Checkpoint / upstream (v1 verbatim) ─────────────────────────────────────

// The LOCAL checkpoint verify after the slot chain. TODO-10's widened
// verify inputs: the four slot verdicts + the part plan ride the script's
// criteria inputs; the script asserts the PLANNED slots' part_ready
// before printing checkpoint_local semantics. Keep the entry_sha compare
// semantics (KB-211 re-based, Wave-1 verified); the push stays delegated
// to upstream_sync.
step "push_checkpoint" {
    target     = adapter.shell.sh
    max_visits = var.max_checkpoint_push_visits
    timeout    = "120s"

    input {
        command = templatefile("./scripts/verify_checkpoint_pushed.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
            criteria_value_2 = data.internal.entry_sha.value
            criteria_value_3 = data.internal.part_count.value
            criteria_value_4 = data.internal.pair_slot_p1_verdict.value
            criteria_value_5 = data.internal.pair_slot_p2_verdict.value
            criteria_value_6 = data.internal.pair_slot_p3_verdict.value
            criteria_value_7 = data.internal.pair_slot_p4_verdict.value
        })
    }

    // v1 verbatim (CRI-272 slim continuation prompt + KB-211 benign-resume
    // correction): the per-part verdict chain's LOCAL verify outcome.
    outcome "success" {
        next = step.switch_verdict_route
        write {
            target = data.internal.developer_prompt.value
            value = contains(split(output.stdout, "\n"), "resumed_no_work=1") ? templatefile("./agents/checkpoint_recover.md.tftpl", {
                workstream = data.internal.workstream_text.value
            }) : templatefile("./agents/develop_continue.md.tftpl", {
                workstream = data.internal.workstream_text.value
            })
        }
    }
    outcome "failure" { next = step.preserve_pending }
}

// v1 verbatim (ruling 2): a dead part turn must not evaporate pending
// changes.
step "preserve_pending" {
    target  = adapter.shell.sh
    timeout = "30s"
    input {
        command = templatefile("./scripts/commit_pending_changes.sh.tftpl", {})
    }
    outcome "success" { next = step.sync_checkpoint_upstream }
    outcome "failure" { next = state.failed }
}

// v1 verbatim (LOCAL-ONLY contract, ruling 1): every network op leaves the
// loop through this subworkflow. Best-effort durability; a sync failure
// must not fail the run.
step "sync_checkpoint_upstream" {
    target = subworkflow.upstream_sync
    outcome "success" { next = step.resume_after_preservation }
    outcome "failure" { next = step.resume_after_preservation }
}

// v1 verbatim.
step "resume_after_preservation" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'pending changes preserved and pushed upstream; resuming the part chain'"
    }
    outcome "success" {
        next = step.switch_verdict_route
        write {
            target = data.internal.developer_prompt.value
            value = templatefile("./agents/develop_continue.md.tftpl", {
                workstream = data.internal.workstream_text.value
            })
        }
    }
    // KB-374: engine 0.5.57 static FSM verification requires the adapter
    // failure/error path on every non-iterating step.
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "resume_after_preservation bookkeeping step failed before the part-chain re-entry (KB-374)"
        }
    }
}

// ── Whole-loop verdict ───────────────────────────────────────────────────────

// The tree's OWN verdict aggregation hop: the deterministic shell truth
// composes the whole-tree aggregate over the STAMPED slot verdicts
// (data.internal.pair_slot_p1..p4_verdict) inside the REDUCED count —
// the tree asserts the aggregate, never the agent (KB-151). part attempt
// bookkeeping rides the same hop: part_attempted counts up.
step "switch_verdict_route" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/switch_verdict_route.sh.tftpl", {
            criteria_value_1 = data.internal.part_count.value
            criteria_value_2 = data.internal.pair_slot_p1_verdict.value
            criteria_value_3 = data.internal.pair_slot_p2_verdict.value
            criteria_value_4 = data.internal.pair_slot_p3_verdict.value
            criteria_value_5 = data.internal.pair_slot_p4_verdict.value
        })
    }
    outcome "success" {
        next = step.write_review_log
        write {
            target = data.internal.pair_verdict.value
            value  = trimspace(output.stdout)
        }
        write {
            target = data.internal.part_attempted.value
            value  = "1"
        }
    }
    // KB-374.
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "switch_verdict_route's verdict aggregation failed: ${output.stderr}"
        }
    }
}

// The per-part verdict log write (v1's write_work_log shape): the body
// renders the per-part verdicts + findings over the PLANNED parts and the
// whole-tree aggregate.
step "write_review_log" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/write_review_log.sh.tftpl", {
            criteria_value_1 = data.internal._log_file.value
            criteria_value_2 = "pair loop v2: whole-tree verdict ${data.internal.pair_verdict.value} over ${data.internal.part_count.value} planned part(s); slot verdicts ${data.internal.pair_slot_p1_verdict.value}/${data.internal.pair_slot_p2_verdict.value}/${data.internal.pair_slot_p3_verdict.value}/${data.internal.pair_slot_p4_verdict.value}; findings: ${data.internal.pair_slot_p1_findings.value} | ${data.internal.pair_slot_p2_findings.value} | ${data.internal.pair_slot_p3_findings.value} | ${data.internal.pair_slot_p4_findings.value}"
        })
    }
    outcome "success" { next = step.commit_review_log }
    outcome "failure" { next = state.failed }
}

// v1 verbatim: auto-commit the log file if it is tracked in the repo.
step "commit_review_log" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/commit_review_log.sh.tftpl", {
            criteria_value_1 = data.internal._log_file.value
        })
    }
    outcome "success" { next = step.push_review_checkpoint }
    outcome "failure" { next = state.failed }
}

// v1 verbatim: the second durability checkpoint after the verdict pass —
// an approved head (or a findings-carrying head) is exactly the state a
// restart must be able to find on the remote. Best-effort, upstream-
// delegated semantics (LOCAL-ONLY contract, ruling 1).
step "push_review_checkpoint" {
    target = subworkflow.upstream_sync
    outcome "success" { next = switch.triage_review }
    outcome "failure" { next = switch.triage_review }
}

// v1 verbatim SHAPE, v2 semantics: the whole-loop triage. The KB-151
// pattern's single source of truth is this tree's own data.internal
// (pair_verdict); the pair_ready verdict routes done, anything else is
// the typed-fail parking lane.
switch "triage_review" {
    match {
        condition = data.internal.pair_verdict.value == "pair_ready"
        next      = state.done
    }
    default {
        next = step.fail_pair_verdict_parking
    }
}

// ── Terminal states ─────────────────────────────────────────────────────────

state "done" {
    terminal = true
    success  = true
}

state "failed" {
    terminal = true
    success  = false
}

// ── Typed-fail bookkeeping ──────────────────────────────────────────────────
// Every non-iterating step above carries an adapter failure/error path
// (KB-374). The fail-* bookkeeping steps mirror v1's fail_merge_ci /
// resume_after_preservation KB-374 shape: BOTH outcomes route to
// state.failed and write the typed reason.

step "fail_no_parts_attempted" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'fail_no_parts: the planner planned zero parts'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.pair_verdict.value
            value  = "no_parts_planned"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair loop v2 failed: no parts were planned (part_count=0)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "fail_no_parts_attempted's bookkeeping step failed (KB-374)"
        }
    }
}

step "fail_parts_overflow" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'fail_parts_overflow: the planner planned beyond the slot budget or the effort lane was unresolvable'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.pair_verdict.value
            value  = "parts_overflow"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair loop v2 failed: the planner planned ${data.internal.part_count.value} parts (or a slot effort outside fast/deep) — beyond the tree's 4-slot budget (fail_parts_overflow)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "fail_parts_overflow's bookkeeping step failed (KB-374)"
        }
    }
}

step "fail_verdict_mismatch" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'fail_verdict_mismatch: a slot verify landed without the expected part_ready stamp'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.pair_verdict.value
            value  = "verdict_mismatch"
        }
        write {
            target = data.internal.failure_reason.value
            value  = "pair loop v2 failed: a slot's verdict landed without the expected part_ready stamp (fail_verdict_mismatch)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "fail_verdict_mismatch's bookkeeping step failed (KB-374)"
        }
    }
}

step "fail_pair_verdict_parking" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'fail_pair_verdict_parking: the whole-tree verdict was not pair_ready'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "pair loop v2's whole-tree verdict was \"${data.internal.pair_verdict.value},\" not pair_ready (fail_pair_verdict_parking)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "fail_pair_verdict_parking's bookkeeping step failed (KB-374)"
        }
    }
}

// ── Interface outputs ───────────────────────────────────────────────────────
// Declared subworkflow outputs read data.internal blocks. Every verdict
// whose value the PARENT consumes copies the value into its paired
// data.internal on its route (the "copies value = output.<field>" rule).
// The parent's dial step routes on these — TODO-7 (the parent dial) stays
// SKIPPED in this pass: tree-internal surface only.

output "pair_verdict" {
    type  = string
    value = data.internal.pair_verdict.value
}

output "failure_reason" {
    type  = string
    value = data.internal.failure_reason.value
}
