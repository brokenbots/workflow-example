// Per-part remediation agents (agents/pair_part_remediate.md.tftpl prompt;
// pair_part_rem.md's unreferenced charter was never a system_prompt — the
// adapter config reads agents/developer.md) — the same slot-instance-name/
// fresh-conversation discipline as the developers. TODO-6's reverify loop
// (verify failure -> remediate max_visits) bounds this step's re-entries.
adapter "copilot" "pair_part_p1_remediator" {
    environment = remote.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.21"
    config {
        model             = var.remediator.model
        max_turns         = "${var.remediator.max_turns}"
        reasoning_effort  = var.remediator.reasoning_effort
        system_prompt     = file("./agents/developer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.remediator.provider.base_url
        provider_wire_api = var.remediator.provider.wire_api
        working_directory = var.worktree_dir
    }
}

