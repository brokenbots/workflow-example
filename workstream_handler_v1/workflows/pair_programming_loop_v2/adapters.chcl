// Pair-part developer agents — the four SLOTS' deep lane. Same developer
// charter (agents/developer.md), same slot-naming discipline as above;
// model/reasoning_effort/provider ride var.planner (ruling 6/9's effort
// split: deep parts get the planner's heavier model config), max_turns
// stays the developer's budget. The lockfile carries matching NEW
// block-copies at the same digests (.criteria.lock.hcl).
adapter "copilot" "pair_part_p1_dev_deep" {
    environment = remote.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.21"
    config {
        model             = var.planner.model
        max_turns         = "${var.developer.max_turns}"
        reasoning_effort  = var.planner.reasoning_effort
        system_prompt     = file("./agents/developer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.planner.provider.base_url
