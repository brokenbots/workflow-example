environment "sandbox" "worktree" {
    working_directory = var.worktree_dir
    network = {
        allow = ["*"]
    }
}

adapter "shell" "reviewer" {
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.2"
    environment = sandbox.worktree
    secrets {
        GH_TOKEN = var.REVIEWER_GITHUB_TOKEN
    }
}

// PR review runs on the copilot harness, resolving through the local Ollama
// endpoint. glm-5.2 is the review model.
adapter "copilot" "pr_reviewer" {
    environment = sandbox.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.4"
    // copilot >= 0.5.2 requires a GitHub token over the secret channel.
    //
    // Both adapters in this child receive only the reviewer token. No
    // coordinator adapter can access it or switch to the reviewer identity.
    secrets {
        GITHUB_TOKEN = var.REVIEWER_GITHUB_TOKEN
        GH_TOKEN     = var.REVIEWER_GITHUB_TOKEN
    }
    config {
        model             = var.pr_reviewer.model
        max_turns         = "${var.pr_reviewer.max_turns}"
        reasoning_effort  = var.pr_reviewer.reasoning_effort
        system_prompt     = file("./agents/pr_reviewer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.pr_reviewer.provider.base_url
        provider_wire_api = var.pr_reviewer.provider.wire_api
        working_directory = var.worktree_dir
    }
}
