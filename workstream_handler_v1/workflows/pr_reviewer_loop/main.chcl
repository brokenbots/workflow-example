workflow {
    name          = "pr_reviewer_loop"
    version       = "1"
    criteria_version = ">=0.5.9, <0.6.0"
    initial_state = "resolve_pr_number"
    target_state  = "approved"

    policy {
        max_total_steps = 200
    }
}

// Internal PR number, derived once from pr_url or current branch.
data "internal" "_pr_number" {
    type  = string
    value = ""
}

// Captured output of the last check_pr_status run; forwarded to the reviewer
// so it has full context without re-fetching.
data "internal" "_status_output" {
    type  = string
    value = ""
}

// Review result distinguishes approval, requested changes, and failed checks
// for the parent's routing decision.
data "internal" "review_result" {
    type  = string
    value = ""
}

data "internal" "_review_body" {
    type  = string
    value = ""
}

// Counter for reviewer attempts that ended in a malformed or missing outcome.
// Used to enforce the bounded retry path; reset is implicit because the
// subworkflow is invoked fresh for each review pass.
data "internal" "_review_attempts" {
    type  = number
    value = 0
}

// Context fed back into the reviewer prompt after a failed/malformed attempt.
// Empty on the first attempt and whenever the reviewer returns a valid outcome.
data "internal" "_review_repair_context" {
    type  = string
    value = ""
}

// KB-24: typed reason from the attempt that failed. Empty means the failure
// was engine-synthesized (timeout / crash / lost scope session — no output
// object exists), which routes to state.failed so the parent re-provisions
// the scope; non-empty means the session was live and the in-place repair
// retry applies.
data "internal" "_failure_reason" {
    type  = string
    value = ""
}

// ── PR number resolution ──────────────────────────────────────────────────────
// Accept a full PR URL (e.g. https://github.com/org/repo/pull/42, or a
// multi-line string that contains such a URL) or fall back to the current branch.

step "resolve_pr_number" {
    target = adapter.shell.reviewer
    // KB-219: gh_retry's worst-case budget adds ~105s; keep the step
    // timeout comfortably above it (matches check_pr_status).
    timeout    = "300s"
    input {
        command = templatefile("./scripts/resolve_pr_number.sh.tftpl", {
            criteria_value_1 = var.pr_url
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = step.check_pr_status
        write {
            target = data.internal._pr_number.value
            value  = output.stdout
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal._failure_reason.value
            // KB-24: a live deterministic failure must never reach the parent
            // with an empty reason — an empty value is reserved for
            // engine-synthesized session loss and would trigger a pointless
            // scope re-provision.
            value  = "PR number resolution failed (KB-24)"
        }
    }
}

// ── PR status check ───────────────────────────────────────────────────────────
// Mirrors pr-status.sh logic inline so the loop is self-contained.
// First stdout line is always one of:
//   status:merged             — PR already merged; treat as approved
//   status:ready              — CI green, no blocking threads
//   status:threads_open       — unresolved threads; reviewer triages
//   status:changes_requested  — reviewDecision=CHANGES_REQUESTED; reviewer re-evaluates
//   status:pending            — CI still running; caller backs off
//   status:checks_failed      — required CI check failed; escalate

step "check_pr_status" {
    target     = adapter.shell.reviewer
    timeout    = "300s"
    max_visits = var.max_poll_visits
    input {
        command = templatefile("./scripts/check_pr_status.sh.tftpl", {
            criteria_value_1 = data.internal._pr_number.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = switch.route_pr_status
        write {
            target = data.internal._status_output.value
            value  = output.stdout
        }
        write {
            target = data.internal.review_result.value
            value  = startswith(output.stdout, "status:checks_failed") ? "checks_failed" : (startswith(output.stdout, "status:merged") || startswith(output.stdout, "status:approved") ? "approved" : "")
        }
        write {
            target = data.internal._failure_reason.value
            // KB-24: an unrecognized status line still reaches state.failed
            // via route_pr_status's default arm. Give that route a non-empty
            // reason so the parent fails the run with the actual status
            // output instead of misclassifying it as a lost scope session.
            // Recognized statuses reset the reason (empty on success paths).
            value  = startswith(output.stdout, "status:merged") || startswith(output.stdout, "status:approved") || startswith(output.stdout, "status:ready") || startswith(output.stdout, "status:threads_open") || startswith(output.stdout, "status:changes_requested") || startswith(output.stdout, "status:pending") || startswith(output.stdout, "status:checks_failed") ? "" : "unrecognized PR status output: ${output.stdout}"
        }
    }
    outcome "failure" {
        next = step.retry_check_pr_status
        write {
            target = data.internal._failure_reason.value
            // KB-24: a live deterministic failure must never reach the parent
            // with an empty reason — an empty value is reserved for
            // engine-synthesized session loss and would trigger a pointless
            // scope re-provision.
            value  = "PR status check failed (KB-24)"
        }
    }
}

// TRANSIENT-RETRY (2026-10-02, dave ruling): check_pr_status is a NETWORK
// surface (gh api to api.github.com) and dies on transient transport errors
// (TLS handshake timeout observed live on KB-48's merge leg, 2026-10-02 — a
// one-off blip parked the run at awaiting_human for a green approved PR).
// KB-219: the transport layer is now handled INSIDE the step body by the
// shared gh_retry shim (bounded backoff, ~105s worst case — hence the 300s
// step timeout); the verdict shape is untouched, so this KB-24-era single
// step-level retry stays exactly as-is and keeps covering non-transport
// step failures. Its failure arm retains the original KB-24 typed reason.
step "retry_check_pr_status" {
    target     = adapter.shell.reviewer
    timeout    = "300s"
    max_visits = var.max_poll_visits
    input {
        command = templatefile("./scripts/check_pr_status.sh.tftpl", {
            criteria_value_1 = data.internal._pr_number.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = switch.route_pr_status
        write {
            target = data.internal._status_output.value
            value  = output.stdout
        }
        write {
            target = data.internal.review_result.value
            value  = startswith(output.stdout, "status:checks_failed") ? "checks_failed" : (startswith(output.stdout, "status:merged") || startswith(output.stdout, "status:approved") ? "approved" : "")
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal._failure_reason.value
            value  = "PR status check failed after retry (KB-24, transient-surface)"
        }
    }
}

switch "route_pr_status" {
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:merged")
        next      = state.approved
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:approved")
        next      = state.approved
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:ready")
        next      = step.pr_review
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:threads_open")
        next      = step.pr_review
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:changes_requested")
        next      = step.pr_review
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:pending")
        next      = step.backoff
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:checks_failed")
        next      = state.checks_failed
    }
    default { next = state.failed }
}

// ── CI backoff ────────────────────────────────────────────────────────────────

step "backoff" {
    target     = adapter.shell.reviewer
    timeout    = "300s"
    max_visits = var.max_backoff_visits
    input {
        command = "echo 'CI pending — sleeping ${var.ci_backoff_seconds}s'; sleep ${var.ci_backoff_seconds}"
    }
    outcome "success" { next = step.check_pr_status }
    outcome "failure" { next = step.check_pr_status }
}

// ── PR review agent ───────────────────────────────────────────────────────────
// Distinct persona from the pair-programming inner reviewer. Arrives cold,
// reviews from the diff, resolves any addressable threads, then approves or
// posts a REQUEST_CHANGES review to GitHub and returns a precise changes list
// for the coordinator to triage.
//
// Malformed tool-call or missing-outcome failures are not terminal on the
// first occurrence. They route through switch.route_review_retry, which counts
// the attempt and re-enters pr_review with a repair prompt so long as the
// total number of attempts stays within max_review_visits.

step "pr_review" {
    target      = adapter.copilot.pr_reviewer
    allow_tools = ["*"]
    max_visits  = var.max_review_visits
    // KB-24: bound each attempt so a lost scope session (the remote shim keeps
    // failing to accept the dead scope's connections) becomes a failure
    // outcome instead of a step that never concludes.
    timeout = "3600s"

    input {
                prompt = templatefile("./agents/review_pr.md.tftpl", {
                        pr_number       = data.internal._pr_number.value
                        workstream_file = var.workstream_file
                        status_output   = data.internal._status_output.value
                        repair_context  = data.internal._review_repair_context.value
                })
    }

    outcome "approve" {
        next = step.post_approval
        write {
            target = data.internal.review_result.value
            value  = "approved"
        }
        write {
            target = data.internal._review_body.value
            value  = output.reason
        }
        write {
            target = data.internal._review_repair_context.value
            value  = ""
        }
        require_comment = true
    }
    outcome "changes_requested" {
        next = step.post_changes_requested
        write {
            target = data.internal.review_result.value
            value  = "changes_requested"
        }
        write {
            target = data.internal._review_body.value
            value  = output.reason
        }
        write {
            target = data.internal._review_repair_context.value
            value  = ""
        }
        require_comment = true
    }
    outcome "failure" {
        next = switch.route_review_retry
        write {
            target = data.internal._failure_reason.value
            // try(): an engine-synthesized failure (timeout / crash / lost
            // scope session) exposes no output object at all — an empty
            // reason marks the scope loss for the retry switch.
            value  = try(output.reason, "")
        }
        write {
            target = data.internal._review_attempts.value
            value  = data.internal._review_attempts.value + 1
        }
        write {
            target = data.internal._review_repair_context.value
            value  = "The previous reviewer attempt reported failure: ${try(output.reason, "no reason reported")}\n\nRetry now. You must call submit_outcome with outcome 'approve' or 'changes_requested', and you must not emit malformed tool-call text."
        }
        require_comment = true
    }
    outcome "default" {
        next = switch.route_review_retry
        write {
            target = data.internal._failure_reason.value
            // The engine classified a response but not its outcome name, so
            // the session was live; a reported reason (if any) travels to the
            // parent as failure_reason. submit_outcome reason is optional and
            // the copilot adapter reports it as an empty string when the
            // agent supplies none, so try(...) alone would still pass ""
            // through: guard the empty case explicitly.
            value  = try(output.reason, "") != "" ? try(output.reason, "") : "malformed reviewer response (no valid outcome)"
        }
        write {
            target = data.internal._review_attempts.value
            value  = data.internal._review_attempts.value + 1
        }
        write {
            target = data.internal._review_repair_context.value
            value  = "The previous reviewer attempt returned an unrecognised or malformed outcome (e.g. malformed tool-call text, missing submit_outcome, or an invalid outcome name).\n\nRetry now. You must call submit_outcome with outcome 'approve' or 'changes_requested', and you must not emit malformed tool-call text."
        }
        require_comment = true
    }
}

// Bounded retry decision for reviewer failures. The failure reason (written by
// the pr_review failure/default outcomes before this switch is evaluated)
// gates the retry: an engine-synthesized failure — empty reason — is a lost
// scope session, so an in-place retry would dial the same dead session; it
// fails the run and the parent re-provisions the scope instead (KB-24). For
// live-session failures the counter (also incremented before this switch)
// enforces: attempts < max_review_visits => one more try, otherwise fail the
// run. This keeps the loop finite and makes the existing max_visits budget
// the hard ceiling.
switch "route_review_retry" {
    match {
        condition = data.internal._failure_reason.value == ""
        next      = state.failed
    }
    match {
        condition = data.internal._review_attempts.value < var.max_review_visits
        next      = step.pr_review
    }
    default {
        next = state.failed
    }
}

step "post_approval" {
    target = adapter.shell.reviewer
    // KB-219: gh_retry's worst-case budget adds ~105s; keep the step
    // timeout comfortably above it (matches check_pr_status).
    timeout    = "300s"
    input {
        command = templatefile("./scripts/post_review.sh.tftpl", {
            criteria_value_1 = data.internal._pr_number.value
            criteria_value_2 = "APPROVE"
            criteria_value_3 = data.internal._review_body.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" { next = state.approved }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal._failure_reason.value
            // KB-24: a live deterministic failure must never reach the parent
            // with an empty reason — an empty value is reserved for
            // engine-synthesized session loss and would trigger a pointless
            // scope re-provision.
            value  = "posting the approval review failed (KB-24)"
        }
    }
}

step "post_changes_requested" {
    target = adapter.shell.reviewer
    // KB-219: gh_retry's worst-case budget adds ~105s; keep the step
    // timeout comfortably above it (matches check_pr_status).
    timeout    = "300s"
    input {
        command = templatefile("./scripts/post_review.sh.tftpl", {
            criteria_value_1 = data.internal._pr_number.value
            criteria_value_2 = "REQUEST_CHANGES"
            criteria_value_3 = data.internal._review_body.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" { next = state.changes_requested }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal._failure_reason.value
            // KB-24: a live deterministic failure must never reach the parent
            // with an empty reason — an empty value is reserved for
            // engine-synthesized session loss and would trigger a pointless
            // scope re-provision.
            value  = "posting the changes-requested review failed (KB-24)"
        }
    }
}

// ── Terminal states ───────────────────────────────────────────────────────────

state "approved" {
    terminal = true
    success  = true
}

state "changes_requested" {
    terminal = true
    success  = false
}

state "checks_failed" {
    terminal = true
    success  = false
}

state "failed" {
    terminal = true
    success  = false
}

// ── Outputs ───────────────────────────────────────────────────────────────────

output "review_result" {
    type  = string
    value = data.internal.review_result.value
}

output "status_output" {
    type  = string
    value = data.internal._status_output.value
}

// KB-24: typed failure reason from the last attempt; empty on success paths.
// The parent re-provisions the scope when this is empty on failure.
output "failure_reason" {
    type  = string
    value = data.internal._failure_reason.value
}
