criteria_value_1={{ .criteria_value_1 | shellquote }}
set -eu
pr="$criteria_value_1"

pr_state=$(gh pr view "$pr" --json state --jq '.state')
if [ "$pr_state" = "MERGED" ]; then
    echo "status:merged"
    echo "pr_number=$pr"
    exit 0
fi
if [ "$pr_state" = "CLOSED" ]; then
    echo "status:error closed pr=$pr" >&2
    exit 1
fi

# Check classification via the REST API: the pinned gh CLI in the reviewer
# adapter image (2.47.0) predates `gh pr checks --json` (added 2.49+), and the
# usage error it prints was classified as checks_failed, wedging every review
# round in a no_work cycle until max_visits (observed live on CRI-265: PR #61,
# green CI, six rounds of "status:checks_failed"). The API path is
# version-stable and needs only `gh api`.
owner=$(gh repo view --json owner --jq '.owner.login')
repo=$(gh repo view --json name --jq '.name')

checks_rc=0
checks_json=$(gh api "repos/$owner/$repo/commits/$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')/check-runs" \
    --jq '[.check_runs[] | {name: .name, state: .status, conclusion: .conclusion}]' 2>&1) || checks_rc=$?

if [ "$checks_rc" -ne 0 ]; then
    echo "status:pending"
    echo "pr_number=$pr"
    echo "checks=api_unreachable"
    echo "$checks_json" >&2
    exit 0
fi

# No check runs at all: CI has not registered yet (common right after a push)
# OR the repo has no Actions workflows at all (would loop pending forever,
# observed: CRI-90 on workflow-example). Distinguish by counting the repo's
# workflows; zero workflows means there is no CI to wait for.
if [ "$(printf '%s' "$checks_json" | jq 'length')" = "0" ]; then
    wf_count=$(gh api "repos/$owner/$repo/actions/workflows" --jq '.total_count' 2>/dev/null || echo "-1")
    if [ "$wf_count" = "0" ]; then
        echo "checks=none (repo has no Actions workflows; skipping CI wait)" >&2
    else
        echo "status:pending"
        echo "pr_number=$pr"
        echo "checks=not_yet_reported"
        exit 0
    fi
fi

# Classify by state+conclusion (check-runs API): a run still in flight has
# status != COMPLETED with conclusion null.
any_failing=$(printf '%s' "$checks_json" | jq '[.[] | select(.conclusion != null and (.conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral"))] | length' 2>/dev/null || echo "0")
any_pending=$(printf '%s' "$checks_json" | jq '[.[] | select(.conclusion == null and .state != "COMPLETED")] | length' 2>/dev/null || echo "0")
if [ "$any_pending" -gt 0 ] && [ "$any_failing" -eq 0 ]; then
    echo "status:pending"
    echo "pr_number=$pr"
    printf '%s\n' "$checks_json" | jq -r '.[] | select(.conclusion == null and .state != "COMPLETED") | "pending_check=\(.name)"' 2>/dev/null || true
    exit 0
fi
if [ "$any_failing" -gt 0 ]; then
    echo "status:checks_failed"
    echo "pr_number=$pr"
    printf '%s\n' "$checks_json" | jq -r '.[] | select(.conclusion != null and (.conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral")) | "failing_check=\(.name)"' 2>/dev/null || true
    exit 0
fi

review_decision=$(gh pr view "$pr" --json reviewDecision --jq '.reviewDecision // "REVIEW_REQUIRED"')

# Viewer-agnostic approval check (mirrors the parent's check_pr):
# reviewDecision comes back empty for the PR author, and on repos
# with no required-reviews rule, so an already-approved head would
# otherwise be sent back for a full re-review every cycle. Match
# approvals against the CURRENT head SHA only — an approval of an
# earlier commit must not count for code pushed after it.
if [ -z "$review_decision" ] || [ "$review_decision" = "REVIEW_REQUIRED" ]; then
    head_sha=$(gh pr view "$pr" --json headRefOid --jq '.headRefOid' 2>/dev/null || echo "")
    if [ -n "$head_sha" ]; then
        approved_head=$(gh api "repos/$owner/$repo/pulls/$pr/reviews" \
            --jq "[.[] | select(.state == \"APPROVED\") | select(.commit_id == \"$head_sha\")] | length" 2>/dev/null || echo "0")
        if [ "$approved_head" -gt 0 ]; then
            review_decision="APPROVED"
        fi
    fi
fi

threads_json=$(gh api graphql \
    -f query='query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){pullRequest(number:$number){reviewThreads(first:100){nodes{id isResolved isOutdated}}}}}' \
    -f owner="$owner" \
    -f repo="$repo" \
    -F number="$pr")
unresolved=$(printf '%s' "$threads_json" | \
    jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select((.isOutdated|not) and (.isResolved|not))] | length')

if [ "$review_decision" = "CHANGES_REQUESTED" ]; then
    echo "status:changes_requested"
    echo "pr_number=$pr"
    echo "review_decision=$review_decision"
    echo "unresolved_threads=$unresolved"
    exit 0
fi

if [ "$review_decision" = "APPROVED" ] && [ "$unresolved" -eq 0 ]; then
    echo "status:approved"
    echo "pr_number=$pr"
    echo "review_decision=$review_decision"
    echo "checks=passed"
    exit 0
fi

if [ "$unresolved" -gt 0 ]; then
    echo "status:threads_open"
    echo "pr_number=$pr"
    echo "unresolved_threads=$unresolved"
    exit 0
fi

echo "status:ready"
echo "pr_number=$pr"
echo "review_decision=$review_decision"
echo "checks=passed"
printf '%s\n' "$checks_json" | \
    jq -r 'group_by(.state) | map([.[0].state, (length|tostring)] | join("=")) | .[]' 2>/dev/null || true