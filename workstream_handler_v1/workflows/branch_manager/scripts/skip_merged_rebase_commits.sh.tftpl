criteria_value_1={{ .criteria_value_1 | shellquote }}
exec 2>&1
set -u
base="$criteria_value_1"
# Resolve rebase-state dirs via git: in a linked worktree they live under
# the per-worktree gitdir, not a literal .git/ in the working tree.
rm=$(git rev-parse --git-path rebase-merge)
ra=$(git rev-parse --git-path rebase-apply)
MAX_SKIPS=20
skips=0
while [ "$skips" -lt "$MAX_SKIPS" ]; do
    if [ ! -d "$rm" ] && [ ! -d "$ra" ]; then
        echo "status=completed skips=$skips"
        exit 0
    fi
    rebase_head=""
    if [ -f "$rm/stopped-sha" ]; then
        rebase_head=$(cat "$rm/stopped-sha")
    elif [ -f "$ra/original-commit" ]; then
        rebase_head=$(cat "$ra/original-commit")
    fi
    if [ -z "$rebase_head" ]; then
        echo "status=error cannot identify stalled commit"
        exit 1
    fi
    msg=$(git log --format='%s' -1 "$rebase_head" 2>/dev/null || echo unknown)
    echo "rebase stalled at: $rebase_head ($msg)"
    if git merge-base --is-ancestor "$rebase_head" "origin/$base" 2>/dev/null; then
        echo "commit already in origin/$base — skipping"
        prev="$rebase_head"
        git rebase --skip 2>&1 || true
        skips=$((skips + 1))
        # Safety: if we're still on the same commit the skip had no effect
        if [ -f "$rm/stopped-sha" ] && \
           [ "$(cat "$rm/stopped-sha")" = "$prev" ]; then
            echo "status=error skip had no effect on $prev"
            git rebase --abort 2>/dev/null || true
            exit 1
        fi
    else
        echo "status=genuine_conflict commit $rebase_head not in origin/$base"
        git rebase --abort 2>/dev/null || true
        exit 1
    fi
done
echo "status=error exceeded max skips ($MAX_SKIPS)"
git rebase --abort 2>/dev/null || true
exit 1
