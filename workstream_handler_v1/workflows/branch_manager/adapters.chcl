environment "remote" "worktree" {
    // Per-scope sessions: each scope gets its own adapter pod, torn down at
    // scope exit. Requires the run data dir wiring (CRI-128).
    per_scope_sessions = true
    working_directory = var.worktree_dir
    process = {
        exec = ["*"]
    }
    listen_address = "127.0.0.1:7778"
    accept_token = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

environment "remote" "primary" {
    // Per-scope sessions: each scope gets its own adapter pod, torn down at
    // scope exit. Requires the run data dir wiring (CRI-128).
    per_scope_sessions = true
    working_directory = var.repo_dir
    process = {
        exec = ["*"]
    }
    listen_address = "127.0.0.1:7778"
    accept_token = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

// Branch-scoped git ops run inside the isolated worktree.
adapter "shell" "sh" {
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.3"
    environment = remote.worktree
    secrets {
        GH_TOKEN = var.workflow_github_token
    }
}

// Worktree lifecycle (fetch, worktree add) runs in the repo's primary tree —
// it must work before the per-run worktree exists.
adapter "shell" "repo" {
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.3"
    environment = remote.primary
    secrets {
        GH_TOKEN = var.workflow_github_token
    }
}

adapter "copilot" "branch_repair" {
    environment = remote.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.6"
    // copilot >= 0.5.2 requires a GitHub token over the secret channel.
    secrets {
        GITHUB_TOKEN = var.workflow_github_token
        GH_TOKEN     = var.workflow_github_token
    }
    config {
        model             = var.repair_agent.model
        max_turns         = "${var.repair_agent.max_turns}"
        reasoning_effort  = var.repair_agent.reasoning_effort
        system_prompt     = file("./agents/branch-repair.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.repair_agent.provider.base_url
        provider_wire_api = var.repair_agent.provider.wire_api
        working_directory = var.worktree_dir
    }
}
