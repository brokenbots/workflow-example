criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
# Checkpoint verification — LOCAL ONLY (pair-loop remaster, settled rulings
# 1 and 2). The loop performs zero network operations: pushed-state truth
# lives in upstream_sync after the develop turn; this step verifies the
# checkpoint verdict's LOCAL precondition.
#
# Semantics:
#   entry_sha (captured by checkout_branch at loop entry) == HEAD
#     -> "resumed_no_work=1", benign resume (KB-211): the agent ended a
#        checkpoint turn without committing anything. Deterministic, not
#        agent judgment; the continuation prompt is the correction template.
#   entry_sha != HEAD
#     -> committed work exists; print the protocol line and let the tree
#        delegate the actual push to upstream_sync.
#
# The FATAL remote cases of the old design ("local commits exist but the
# push never landed") move wholesale to upstream_sync — the loop never sees
# remote state, by contract.

# The branch value travels through stdout writes on its way here and can
# carry stray edge whitespace (observed: a trailing newline from an untrimmed
# `basename` write — CRI-295). Trim the edges; internal whitespace in a real
# branch name survives.
branch="$(printf '%s' "$criteria_value_1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
if [ -z "$branch" ]; then
    echo "checkpoint verification: branch value is empty" >&2
    exit 1
fi

head_sha=$(git rev-parse HEAD)
entry_sha="${criteria_value_2}"
if [ -z "$entry_sha" ]; then
    echo "checkpoint verification: entry_sha is empty (checkout_branch must capture it)" >&2
    exit 1
fi

if [ "$head_sha" = "$entry_sha" ]; then
    echo "resumed_no_work=1"
    exit 0
fi

echo "checkpoint_local=head:${head_sha} entry:${entry_sha}"
exit 0
