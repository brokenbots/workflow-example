set -euo pipefail
# Durability checkpoint: push the current branch so committed work survives
# container loss. Never fails the run — a checkpoint miss must not block the
# develop/review cycle. Offsets churn from the work/review log commits so the
# PR sees few or no new commits per pass.
branch=$(git branch --show-current)
if [ -z "$branch" ]; then
    echo "wip-checkpoint: no branch (detached HEAD); skipping push"
    exit 0
fi
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
ahead=0
if [ -n "$upstream" ]; then
    ahead=$(git rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)
fi
if [ "$ahead" -le 1 ]; then
    echo "wip-checkpoint: branch=$branch ahead=$ahead (log/noise only or nothing); skipping push"
    exit 0
fi
if ! git push origin "$branch" 2>&1; then
    echo "wip-checkpoint: push failed for $branch (non-fatal); continuing"
fi
exit 0
