environment "remote" "worktree" {
    // Per-scope sessions: each scope gets its own adapter pod, torn down at
    // scope exit. Requires the run data dir wiring (CRI-128).
    per_scope_sessions = true
    working_directory = var.worktree_dir
    process = {
        exec = ["*"]
    }
    listen_address = "0.0.0.0:0"
    accept_token = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

adapter "shell" "sh" {
    continuation = "reuse"
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.5"
    environment = remote.worktree
    // No secrets: LOCAL-ONLY contract (remaster ruling 1). Upstream placement
    // is delegated to the upstream_sync subworkflow; this tree holds zero
    // credentials (credential blast radius becomes physics, not policy).
}

adapter "copilot" "developer" {
    environment = remote.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.21"
    // No secrets: the developer is local-only. It commits to the worktree;
    // it never authenticates against any remote. (Remaster rulings 1+2.)
    config {
        model             = var.developer.model
        max_turns         = "${var.developer.max_turns}"
        system_prompt     = file("./agents/developer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.developer.provider.base_url
        provider_wire_api = var.developer.provider.wire_api
        working_directory = var.worktree_dir
    }
}

// Review runs on the copilot harness alongside the developer, resolving
// through the local Ollama endpoint. deepseek-v4.1-flash is the review model.
// KB-72/KB-65: max_turns is bounded low on purpose — a review leg that
// exhausts its turns without emitting a verdict routes as failure (agents/
// reviewer.md carries the matching turn-discipline rule).
adapter "copilot" "reviewer" {
    environment = remote.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.21"
    // No secrets: the reviewer is local-only (read-only on the worktree).
    // (Remaster ruling 1.)
    config {
        model             = var.reviewer.model
        max_turns         = "${var.reviewer.max_turns}"
        reasoning_effort  = var.reviewer.reasoning_effort
        system_prompt     = file("./agents/reviewer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.reviewer.provider.base_url
        provider_wire_api = var.reviewer.provider.wire_api
        working_directory = var.worktree_dir
    }
}
