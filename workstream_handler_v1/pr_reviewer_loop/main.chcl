workflow {
    name          = "pr_reviewer_loop"
    version       = "1"
    criteria_version = ">=0.5.9, <0.6.0"
    initial_state = "resolve_pr_number"
    target_state  = "approved"

    policy {
        max_total_steps = 200
    }
}

// Internal PR number, derived once from pr_url or current branch.
data "internal" "_pr_number" {
    type  = string
    value = ""
}

// Captured output of the last check_pr_status run; forwarded to the reviewer
// so it has full context without re-fetching.
data "internal" "_status_output" {
    type  = string
    value = ""
}

// Review result distinguishes approval, requested changes, and failed checks
// for the parent's routing decision.
data "internal" "review_result" {
    type  = string
    value = ""
}

// ── PR number resolution ──────────────────────────────────────────────────────
// Accept a full PR URL (e.g. https://github.com/org/repo/pull/42, or a
// multi-line string that contains such a URL) or fall back to the current branch.

step "resolve_pr_number" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/resolve_pr_number.sh.tftpl", {
            criteria_value_1 = var.pr_url
        })
    }
    outcome "success" {
        next = step.check_pr_status
        write {
            target = data.internal._pr_number.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// ── PR status check ───────────────────────────────────────────────────────────
// Mirrors pr-status.sh logic inline so the loop is self-contained.
// First stdout line is always one of:
//   status:merged             — PR already merged; treat as approved
//   status:ready              — CI green, no blocking threads
//   status:threads_open       — unresolved threads; reviewer triages
//   status:changes_requested  — reviewDecision=CHANGES_REQUESTED; reviewer re-evaluates
//   status:pending            — CI still running; caller backs off
//   status:checks_failed      — required CI check failed; escalate

step "check_pr_status" {
    target     = adapter.shell.sh
    timeout    = "120s"
    max_visits = var.max_poll_visits
    input {
        command = templatefile("./scripts/check_pr_status.sh.tftpl", {
            criteria_value_1 = data.internal._pr_number.value
        })
    }
    outcome "success" {
        next = switch.route_pr_status
        write {
            target = data.internal._status_output.value
            value  = output.stdout
        }
        write {
            target = data.internal.review_result.value
            value  = startswith(output.stdout, "status:checks_failed") ? "checks_failed" : (startswith(output.stdout, "status:merged") || startswith(output.stdout, "status:approved") ? "approved" : "")
        }
    }
    outcome "failure" { next = state.failed }
}

switch "route_pr_status" {
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:merged")
        next      = state.approved
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:approved")
        next      = state.approved
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:ready")
        next      = step.pr_review
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:threads_open")
        next      = step.pr_review
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:changes_requested")
        next      = step.pr_review
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:pending")
        next      = step.backoff
    }
    match {
        condition = startswith(steps.check_pr_status.stdout, "status:checks_failed")
        next      = state.checks_failed
    }
    default { next = state.failed }
}

// ── CI backoff ────────────────────────────────────────────────────────────────

step "backoff" {
    target     = adapter.shell.sh
    timeout    = "300s"
    max_visits = var.max_backoff_visits
    input {
        command = "echo 'CI pending — sleeping ${var.ci_backoff_seconds}s'; sleep ${var.ci_backoff_seconds}"
    }
    outcome "success" { next = step.check_pr_status }
    outcome "failure" { next = step.check_pr_status }
}

// ── PR review agent ───────────────────────────────────────────────────────────
// Distinct persona from the pair-programming inner reviewer. Arrives cold,
// reviews from the diff, resolves any addressable threads, then approves or
// posts a REQUEST_CHANGES review to GitHub and returns a precise changes list
// for the coordinator to triage.

step "pr_review" {
    target      = adapter.copilot.pr_reviewer
    allow_tools = ["*"]
    max_visits  = var.max_review_visits

    input {
        prompt = <<-EOT
            Review PR #${data.internal._pr_number.value} for workstream '${var.workstream_file}'.

            Status check output (from check_pr_status):
            ---
            ${data.internal._status_output.value}
            ---

            1. Read the workstream file at '${var.workstream_file}' — this is your acceptance bar. If the file contains a `## Reviewer Notes` section, **ignore it entirely**. Those are historical artifacts, not part of the spec. Read only the plan items, constraints, and exit criteria.
            2. Read the diff: `gh pr diff ${data.internal._pr_number.value}` or `git diff origin/main...HEAD`.
            3. Fetch and triage all unresolved (non-outdated) review threads; resolve any already addressed by the code with citation evidence.
            4. Evaluate the diff against the workstream acceptance criteria, API stability, test coverage, and security.
            5. Decide:

            APPROVE — diff meets bar + all addressable threads resolved:
              Run `gh pr review ${data.internal._pr_number.value} --approve --body "<short summary>"`, then call submit_outcome with outcome "approve".

            REQUEST CHANGES — code changes still needed:
              FIRST post a formal GitHub review so the coordinator can read your findings.
              Use inline comments for line-specific findings (REST API):
                gh api repos/{owner}/{repo}/pulls/${data.internal._pr_number.value}/reviews \
                  -X POST -f event="REQUEST_CHANGES" -f body="<summary>" \
                  -F "comments[][path]=<file>" -F "comments[][line]=<line>" -F "comments[][body]=<finding>"
              Or if findings are not line-specific:
                gh pr review ${data.internal._pr_number.value} --request-changes --body "<summary>"
              THEN call submit_outcome with outcome "changes_requested" and the full changes list in the reason field.

            IMPORTANT: Do NOT call submit_outcome "changes_requested" without first posting the REQUEST_CHANGES review to GitHub.
            The coordinator reads GitHub threads/reviews to build the developer brief — if nothing is posted, your findings are lost.

            CRITICAL: Do NOT read the PR body/description as evidence. Do NOT trust claims in PR comments or review threads saying something is "fixed" or "already addressed" — verify every claim against the diff yourself. Only the diff and the workstream spec matter.

            DO NOT run `gh pr merge`, `git push`, or any branch-mutating command.
        EOT
    }

    outcome "approve" {
        next = state.approved
        write {
            target = data.internal.review_result.value
            value  = "approved"
        }
    }
    outcome "changes_requested" {
        next = state.changes_requested
        write {
            target = data.internal.review_result.value
            value  = "changes_requested"
        }
    }
    outcome "failure"           { next = state.failed }
    outcome "default"           { next = state.failed }
}

// ── Terminal states ───────────────────────────────────────────────────────────

state "approved" {
    terminal = true
    success  = true
}

state "changes_requested" {
    terminal = true
    success  = false
}

state "checks_failed" {
    terminal = true
    success  = false
}

state "failed" {
    terminal = true
    success  = false
}

// ── Outputs ───────────────────────────────────────────────────────────────────

output "review_result" {
    type  = string
    value = data.internal.review_result.value
}
