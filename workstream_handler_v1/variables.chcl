variable "workstream_file" {
    description = "path to workstream file for processing."
    type        = string
}

variable "ticket_id" {
    description = "Linear ticket identifier associated with this workstream. When set, the ticket is moved to linear_review_state before each PR review. Empty disables Linear updates for standalone runs."
    type        = string
    default     = ""
}

variable "linear_review_state" {
    description = "Linear workflow state to set before PR review, resolved by name against the ticket's team."
    type        = string
    default     = "In Review"
}

variable "repo_dir" {
    description = "Absolute path of the repo's primary working tree. Worktree lifecycle steps (git fetch / worktree add / worktree remove) run here. The operator's main checkout is fine — git worktree add only reads its .git. Empty = run in the process working directory (no isolation)."
    type        = string
    default     = ""
}

variable "provider_base_url" {
    description = "Optional provider base URL override for every agent in this workflow and its subworkflows."
    type        = string
    default     = ""
}

variable "worktree_dir" {
    description = "Absolute path of the isolated per-run git worktree the workstream develops in. Created by branch_manager and torn down after merge. Must be under $HOME (or CRITERIA_SHELL_ALLOWED_PATHS) and contain no '..' (e.g. <repo_dir>/.worktrees/<branch>). Empty = run in the process working directory (no isolation)."
    type        = string
    default     = ""
}

variable "base_branch" {
    description = "Base branch to fork from and validate against. Defaults to main."
    type        = string
    default     = "main"
}

variable "ci_gate_cmd" {
    description = "Command the pair programming loop runs as its CI gate (exit 0 = clean). Empty (the default) skips the gate. Set it to mirror what the remote CI actually runs — a repo's aggregate target often omits gates CI runs separately (e.g. a vulnerability scan), and any gate missing here is one the developer only discovers after the PR is already red (e.g. 'make ci && make vuln-scan')."
    type        = string
    default     = ""
}

variable "log_file" {
    description = "path the workstream log file, if not set its equivalent to `{replace(var.workstream_file, '.md', '.log')}`"
    type        = string
    default     = ""
}

variable "allow_dirty" {
    description = "allow the paired programming loop to run even if the working tree has uncommitted changes"
    type        = bool
    default     = false
}

variable "max_pr_poll_visits" {
    description = "Maximum PR status checks and corresponding backoff cycles before failing."
    type        = number
    default     = 30
}

variable "max_feedback_visits" {
    description = "Maximum coordinator attempts when triaging PR feedback."
    type        = number
    default     = 10
}

variable "max_pair_cycles" {
    description = "Maximum pair-programming reruns used to address PR feedback."
    type        = number
    default     = 5
}

variable "max_branch_repair_visits" {
    description = "Maximum branch-repair agent attempts in branch_manager."
    type        = number
    default     = 3
}

variable "max_pair_agent_visits" {
    description = "Maximum attempts for each developer and reviewer gate in pair_programming_loop."
    type        = number
    default     = 10
}

variable "max_reviewer_poll_visits" {
    description = "Maximum PR status checks in pr_reviewer_loop."
    type        = number
    default     = 60
}

variable "max_reviewer_backoff_visits" {
    description = "Maximum CI backoff cycles in pr_reviewer_loop."
    type        = number
    default     = 30
}

variable "max_review_visits" {
    description = "Maximum PR reviewer agent attempts."
    type        = number
    default     = 5
}

variable "WORKFLOW_GITHUB_TOKEN" {
    type        = string
    default     = ""
    secret      = true
    description = "GitHub token for the workflow identity. Resolved from the host environment and referenced by adapter secret bindings."
}

variable "LINEAR_API_KEY" {
    type        = string
    default     = ""
    secret      = true
    description = "Linear API key used by intake shell adapters. Resolved from the host environment and referenced by adapter secret bindings."
}
