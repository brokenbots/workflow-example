workflow {
    name          = "workstream_handler_v1"
    version       = "1"
    criteria_version = ">=0.5.9, >=0.5.52-rc1, <0.6.0"
    initial_state = "read_workstream"
    target_state  = "done"

    policy {
        max_total_steps = 200
    }
}

data "internal" "branch" {
    type  = string
    value = ""
}

data "internal" "pr_url" {
    type  = string
    value = ""
}

// KB-49: count of PR-step retries for a create_pr/store_pr_url result that
// carried no PR URL. The PR guard spends this budget before failing the run
// loudly at the PR step; the counter resets never — the budget covers the
// whole handler run.
data "internal" "pr_url_retries" {
    type  = number
    value = 0
}

// Note from branch_manager describing any uncommitted work it stashed for a
// rebase and restored to the tree. Surfaced to the developer so they know the
// tree was dirty on arrival and can commit/discard accordingly.
data "internal" "branch_notes" {
    type  = string
    value = ""
}

// Coordinator's distilled brief for the developer, written by triage_pr_feedback
// and updated by validate_developer_response on needs_work cycles.
// KB-265: feedback rounds spent (incremented per needs_work pass; read by
// validate_round_check against var.max_pair_cycles).
data "internal" "validate_rounds" {
    type  = string
    value = "0"
}

data "internal" "developer_feedback" {
    type  = string
    value = ""
}

// KB-267: branch-manager hand-off accounting. hand_off_count — remediation
// hand-offs already emitted by branch_manager_final_say; two fresh-context
// rounds are provisioned (pair_programming_loop_feedback_r2/_r3), so the
// manager must verdict blocked beyond the second. last_hand_off_brief — the
// prior hand-off's brief, so the manager can name the same finding returning
// with no state change as the typed blocked reason.
data "internal" "hand_off_count" {
    type  = string
    value = "0"
}

data "internal" "last_hand_off_brief" {
    type  = string
    value = ""
}

data "internal" "review_result" {
    type  = string
    value = ""
}

data "internal" "review_status_output" {
    type  = string
    value = ""
}

// KB-24: typed failure reason surfaced by this tree or its subworkflows.
// Empty means the failure was engine-synthesized (timeout / crash / lost
// adapter-scope session) — the signal the scope-reprovision routes act on.
data "internal" "failure_reason" {
    type  = string
    value = ""
}

// KB-24: bounded re-provision budgets for lost scope sessions. The reviewer
// counter resets on every successful review round so each round gets a full
// budget.
data "internal" "reviewer_scope_retries" {
    type  = number
    value = 0
}

data "internal" "branch_scope_retries" {
    type  = number
    value = 0
}

// KB-272: merge_pr's post-merge wait verdict (wait_merge_ci stdout, first
// line "merge_ci=green|failed|timeout" plus sha/evidence lines). On a
// non-green verdict the fail_merge_ci bookkeeping step composes the typed
// failure_reason from it; the parent trees park the ticket in Review.
data "internal" "merge_ci_verdict" {
    type  = string
    value = ""
}

// KB-272: merge_pr's protocol stdout, captured for wait_merge_ci — the PR
// number and the squash sha travel from the merge step to the wait step so
// the wait never re-derives them.
data "internal" "merge_pr_result" {
    type  = string
    value = ""
}

// KB-328: merged-PR recovery marker. Set by recover_merged_pr when check_pr
// found the branch's PR already MERGED — route_pr_action then reconciles
// straight through the standing merge gate instead of re-running the
// developer loop over shipped work.
data "internal" "merged_recovery" {
    type  = string
    value = ""
}

subworkflow "branch_manager" {
    source = "./workflows/branch_manager"
    input = {
        workstream_file = var.workstream_file
        base_branch     = var.base_branch
        repo_dir        = var.repo_dir
        worktree_dir    = var.worktree_dir
        max_repair_visits = var.max_branch_repair_visits
        provider_base_url = var.provider_base_url
        workflow_github_token = var.workflow_github_token
    }
}

subworkflow "pr_reviewer_loop" {
    source = "./workflows/pr_reviewer_loop"
    input = {
        pr_url          = data.internal.pr_url.value
        workstream_file = var.workstream_file
        worktree_dir    = var.worktree_dir
        max_poll_visits    = var.max_reviewer_poll_visits
        max_backoff_visits = var.max_reviewer_backoff_visits
        max_review_visits  = var.max_review_visits
        provider_base_url  = var.provider_base_url
        reviewer_github_token = var.reviewer_github_token
    }
}

subworkflow "pair_programming_loop" {
    source = "./workflows/pair_programming_loop"
    input = {
        workstream_file       = var.workstream_file
        ci_gate_cmd           = var.ci_gate_cmd
        log_file              = var.log_file != "" ? var.log_file : null
        allow_dirty           = var.allow_dirty
        branch_notes          = data.internal.branch_notes.value
        worktree_dir          = var.worktree_dir
        max_agent_visits      = var.max_pair_agent_visits
        provider_base_url     = var.provider_base_url
        workflow_github_token = var.workflow_github_token
        git_credential_helper = file("./scripts/_github_token_git_credentials.sh.tftpl")
        base_branch           = var.base_branch
    }
}

// Re-uses the same loop with coordinator feedback injected as the initial prompt.
subworkflow "pair_programming_loop_feedback" {
    source = "./workflows/pair_programming_loop"
    input = {
        workstream_file          = var.workstream_file
        ci_gate_cmd              = var.ci_gate_cmd
        developer_initial_prompt = data.internal.developer_feedback.value
        log_file                 = var.log_file != "" ? var.log_file : null
        allow_dirty              = var.allow_dirty
        branch_notes             = data.internal.branch_notes.value
        worktree_dir             = var.worktree_dir
        max_agent_visits         = var.max_pair_agent_visits
        provider_base_url        = var.provider_base_url
        workflow_github_token    = var.workflow_github_token
        git_credential_helper    = file("./scripts/_github_token_git_credentials.sh.tftpl")
        base_branch              = var.base_branch
    }
}

// KB-267: round-fresh feedback rounds for post-budget hand-offs. Each
// re-entry of the develop leg after a hand-off goes through a NEW dial step
// whose subworkspace declares round-suffixed copilot instances
// (developer_r2/reviewer_r2, developer_r3/reviewer_r3). The engine keys
// copilot conversations by adapter instance name and reuses open sessions on
// re-entry (KB-257 detach + the CRI-145 open-session skip), so only a
// never-opened instance yields a conversation wipe — plain re-entry of the
// base dial inherits the prior round's developer session. The branch
// manager's remediation brief travels as developer_initial_prompt, so the
// fresh session's first prompt IS the brief (KB-262 developer_feedback
// boundary write); the shell instance stays shared on purpose: commands are
// stateless and the worktree/branch must stay the same.
subworkflow "pair_programming_loop_feedback_r2" {
    source = "./workflows/pair_programming_loop_round2"
    input = {
        workstream_file          = var.workstream_file
        ci_gate_cmd              = var.ci_gate_cmd
        developer_initial_prompt = data.internal.developer_feedback.value
        log_file                 = var.log_file != "" ? var.log_file : null
        allow_dirty              = var.allow_dirty
        branch_notes             = data.internal.branch_notes.value
        worktree_dir             = var.worktree_dir
        max_agent_visits         = var.max_pair_agent_visits
        provider_base_url        = var.provider_base_url
        workflow_github_token    = var.workflow_github_token
        git_credential_helper    = file("./scripts/_github_token_git_credentials.sh.tftpl")
        base_branch              = var.base_branch
    }
}

subworkflow "pair_programming_loop_feedback_r3" {
    source = "./workflows/pair_programming_loop_round3"
    input = {
        workstream_file          = var.workstream_file
        ci_gate_cmd              = var.ci_gate_cmd
        developer_initial_prompt = data.internal.developer_feedback.value
        log_file                 = var.log_file != "" ? var.log_file : null
        allow_dirty              = var.allow_dirty
        branch_notes             = data.internal.branch_notes.value
        worktree_dir             = var.worktree_dir
        max_agent_visits         = var.max_pair_agent_visits
        provider_base_url        = var.provider_base_url
        workflow_github_token    = var.workflow_github_token
        git_credential_helper    = file("./scripts/_github_token_git_credentials.sh.tftpl")
        base_branch              = var.base_branch
    }
}

// ── Initial delivery ──────────────────────────────────────────────────────────

// Runs in the repo's primary tree (adapter.shell.repo): the per-run worktree is
// not created until branch_manager, so this first step must not depend on it.
step "read_workstream" {
    target = adapter.shell.repo
    input {
        command = "cat '${var.workstream_file}'"
    }
    outcome "success" { next = step.run_branch_manager }
    outcome "failure" { next = state.failed }
}

step "run_branch_manager" {
    target = subworkflow.branch_manager
    outcome "success" {
        next = step.check_pr
        write {
            target = data.internal.branch.value
            value  = subworkflow.branch
        }
        write {
            target = data.internal.branch_notes.value
            value  = subworkflow.stash_report
        }
    }
    outcome "failure" {
        next = switch.route_branch_scope_reprovision
        write {
            target = data.internal.failure_reason.value
            // try(): a scope that lost its session exposes no outputs at all.
            // Empty means engine-synthesized (timeout / crash / lost session)
            // — the reprovision route re-provisions the scope (fresh rotate +
            // re-dial) instead of failing on the dead session.
            value  = try(subworkflow.failure_reason, "")
        }
    }
}

// KB-24: route the branch_manager failure. A reported reason is a genuine
// failure (agent-decided escalation), so fail with it; an empty reason is a
// lost scope session, so re-provision (fresh rotate + re-dial), bounded by
// the branch scope retry budget.
switch "route_branch_scope_reprovision" {
    match {
        condition = data.internal.failure_reason.value != ""
        next      = state.failed
    }
    match {
        condition = data.internal.branch_scope_retries.value < var.max_branch_scope_retries
        next      = step.reprovision_branch_scope
    }
    default { next = step.exhausted_branch_scope }
}

// KB-24: bookkeeping step that gives the fresh coordinator scope a live
// session before the coordinator subworkflow is re-entered (the subworkflow's
// copilot scope is provisioned anew on its next invocation — fresh rotate +
// re-dial).
step "reprovision_branch_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'branch scope lost its session — re-provisioning scope (fresh rotate + re-dial)'"
    }
    outcome "success" {
        next = step.run_branch_manager
        write {
            target = data.internal.branch_scope_retries.value
            value  = data.internal.branch_scope_retries.value + 1
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "branch scope reprovision step failed before the branch re-run (KB-24)"
        }
    }
}

// KB-24: the reprovision budget is spent with nothing to show for it. Fail
// with a typed reason so the parent's failure path carries actionable text.
step "exhausted_branch_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'branch scope reprovision budget exhausted — failing the run'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "branch scope reprovision budget exhausted (${var.max_branch_scope_retries} retries) without a reported reason (KB-24)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "branch scope reprovision exhaustion step failed while failing the run (KB-24)"
        }
    }
}

// ── PR state check ────────────────────────────────────────────────────────────
//
// Determines what to do before touching developer or reviewer loops.
// First line of stdout (read by route_pr and route_pr_action):
//   status:no_pr         — no PR; need developer work first
//   status:merged        — already merged; run developer then open fresh PR
//   status:closed        — PR closed; run developer then open fresh PR
//   status:pending       — CI still running; back off and retry
//   status:checks_failed — required check failed
//   status:ready         — APPROVED + CI green + no unresolved threads; merge now
//   status:needs_work    — CHANGES_REQUESTED or unresolved threads; triage
//   status:open          — PR exists, CI green, not yet reviewed

step "check_pr" {
    target     = adapter.shell.sh
    // KB-235: backoff budget doubled (30/60/120s => ~210s worst case) so the
    // step timeout stays comfortably above the wrapper's ceiling.
    timeout    = "600s"
    max_visits = var.max_pr_poll_visits
    input {
        command = templatefile("./scripts/check_pr.sh.tftpl", {
            gh_retry = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" { next = switch.route_pr }
    outcome "failure" { next = state.failed }
}

// Merge-gate verification with `gh` — branch-head CI arrives on the PR's
// statusCheckRollup in the reviewer loop; here we only classify the PR.
switch "route_pr" {
    match {
        condition = startswith(steps.check_pr.stdout, "status:no_pr")
        next      = step.run_pair_programming_loop
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:merged")
        // KB-328: the branch's PR is already MERGED. Reconcile at the
        // standing merge gate instead of re-running development — the
        // developer loop over shipped work re-derived the branch from the
        // worktree scan and hijacked an unrelated open branch (observed:
        // dependabot #534 adopted while the card's PR #543 sat merged).
        next      = step.recover_merged_pr
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:closed")
        next      = step.run_pair_programming_loop
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:pending")
        next      = step.backoff_pr
    }
    // ready / open / needs_work / checks_failed — load URL then re-route
    default { next = step.store_pr_url }
}

// Back off while CI is running, then re-check.
step "backoff_pr" {
    target     = adapter.shell.sh
    timeout    = "300s"
    max_visits = var.max_pr_poll_visits
    input {
        command = "echo 'CI pending — sleeping 60s'; sleep 60"
    }
    outcome "success" { next = step.check_pr }
    outcome "failure" { next = step.check_pr }
}

// Fetch and store the PR URL. Kept separate from check_pr so that
// steps.check_pr.stdout remains readable by route_pr_action.
// KB-49: the command must not mask a failed gh call as success — capture the
// view result directly so a gh failure fails the step, and let the route
// guard below reject an empty URL loudly.
step "store_pr_url" {
    target = adapter.shell.sh
    // KB-219: bounded-backoff retries on the gh call — worst case ~210s extra
    // inside the wrapper (KB-235 doubled the schedule to 30/60/120s), so the
    // timeout leaves room for it.
    timeout = "600s"
    input {
        command = templatefile("./scripts/store_pr_url.sh.tftpl", {
            gh_retry = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = switch.route_stored_pr
        write {
            target = data.internal.pr_url.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// KB-49: the PR step completed without a PR URL. Retry create_pr a bounded
// number of times — its reuse branch fetches an existing OPEN PR by URL, so a
// flaky gh call or a PR created late self-heals here — and keep the run OFF
// every review/reconcile path until data.internal.pr_url is non-empty.
switch "route_stored_pr" {
    match {
        condition = data.internal.pr_url.value != ""
        next      = switch.route_pr_action
    }
    match {
        condition = data.internal.pr_url_retries.value < var.max_pr_url_retries
        next      = step.retry_store_pr_url
    }
    default { next = step.fail_missing_pr_url }
}

// KB-49: bookkeeping step that re-views the branch for its existing PR before
// failing the run. Bounded by the same pr_url retry budget as create_pr.
step "retry_store_pr_url" {
    target  = adapter.shell.sh
    timeout = "30s"
    input {
        command = "echo 'PR step completed without a pr_url (KB-49) — retrying the PR URL resolution (bounded)'"
    }
    outcome "success" {
        next = step.store_pr_url
        write {
            target = data.internal.pr_url_retries.value
            value  = data.internal.pr_url_retries.value + 1
        }
    }
    outcome "failure" {
        next = step.fail_missing_pr_url
        write {
            target = data.internal.pr_url_retries.value
            value  = data.internal.pr_url_retries.value + 1
        }
    }
}

// Re-read check_pr.stdout (still in scope) to choose the action now that
// pr_url is available.
switch "route_pr_action" {
    // The recovery arm is terminal by design: its PR is already merged, its
    // squash CI was verified green by recover_merged_ci (same standing gate),
    // and pr_url is stamped — nothing left for review/merge loops to do.
    // This match MUST sit above the stdout-based matches: a recovery run's
    // stale check_pr stdout would otherwise route it back into them.
    match {
        condition = data.internal.merged_recovery.value != ""
        next      = state.done
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:ready")
        next      = step.merge_pr
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:open")
        next      = step.run_pr_reviewer_loop
    }
    // needs_work or checks_failed: skip developer, straight to coordinator triage
    default { next = step.triage_pr_feedback }
}

// ── Developer work ────────────────────────────────────────────────────────────

step "run_pair_programming_loop" {
    target = subworkflow.pair_programming_loop
    outcome "success" { next = step.sync_head_branch }
    outcome "failure" {
        next = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value = try(output.reason, "")
        }
    }
}

// CRI-273 defense in depth: the developer may have worked in a second clone
// it created itself, leaving the worktree on the empty ticket branch —
// create_pr would then fail with "No commits between <base> and <ticket>"
// and the merge would never run. Before creating the PR, resolve the branch
// that actually carries the work (the agent's most recently pushed branch
// naming this ticket, or ahead of base with no other ticket's name) and
// check it out in the worktree. On the happy path this is a no-op: the
// worktree branch already has commits ahead of base and is echoed back.
// stdout (the resolved branch) is stored into data.internal.branch so
// create_pr, push_and_respond and teardown all operate on the same branch.
step "sync_head_branch" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/resolve_head_branch.sh.tftpl", {
            criteria_value_1 = var.base_branch
            criteria_value_2 = var.workstream_file
            helper           = file("./scripts/_github_token_git_credentials.sh.tftpl")
        })
    }
    timeout = "60s"
    outcome "success" {
        next = step.create_pr
        write {
            target = data.internal.branch.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" { next = state.failed }
}

// Create a PR from the current branch; idempotent — reuses existing PR if present.
// KB-49: both outcomes route through the PR guard — a run may leave this step
// for review/reconcile only when data.internal.pr_url actually holds a URL.
step "create_pr" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/create_pr.sh.tftpl", {
            criteria_value_1 = var.base_branch
            criteria_value_2 = var.workstream_file
            helper           = file("./scripts/_github_token_git_credentials.sh.tftpl")
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    // KB-219: gh_retry wrapper can add up to ~210s of backoff on transient
    // blips (KB-235 doubled the schedule to 30/60/120s); the step timeout
    // covers the worst-case wall clock.
    timeout = "600s"
    outcome "success" {
        next = switch.route_created_pr
        write {
            target = data.internal.pr_url.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = switch.route_created_pr }
}

// KB-49: the PR step reported success with an empty pr_url (or failed
// outright). It must never continue to review/reconcile as success: spend the
// bounded retry budget — create_pr's reuse branch recovers a PR that was
// created late or missed by a flaky gh call — then fail loudly at the PR step,
// naming the missing pr_url.
switch "route_created_pr" {
    match {
        condition = data.internal.pr_url.value != ""
        next      = step.run_pr_reviewer_loop
    }
    match {
        condition = data.internal.pr_url_retries.value < var.max_pr_url_retries
        next      = step.retry_create_pr
    }
    default { next = step.fail_missing_pr_url }
}

// KB-49: bookkeeping step that gives create_pr a bounded second (and third)
// chance before the loud failure. Failing here also spends the budget so a
// persistently failing create_pr cannot loop on the retry step.
step "retry_create_pr" {
    target  = adapter.shell.sh
    timeout = "30s"
    input {
        command = "echo 'PR step did not produce a pr_url (KB-49) — retrying create_pr (bounded)'"
    }
    outcome "success" {
        next = step.create_pr
        write {
            target = data.internal.pr_url_retries.value
            value  = data.internal.pr_url_retries.value + 1
        }
    }
    outcome "failure" {
        next = step.fail_missing_pr_url
        write {
            target = data.internal.pr_url_retries.value
            value  = data.internal.pr_url_retries.value + 1
        }
    }
}

// KB-49: the bounded retries could not produce a PR URL. Fail the run loudly
// AT THE PR STEP instead of walking into the reviewer loop and merge
// bookkeeping as if a PR existed (observed: commits pushed, handler reported
// success with pr_url set to the empty string, run continued into review
// steps; the operator-only refire with a fresh create was the only recovery).
// The typed reason names the missing pr_url so the parent tree's failure
// comment and the run record carry something actionable.
step "fail_missing_pr_url" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'pr_url_missing=true (KB-49) — the PR step completed without a PR URL; failing the run loudly instead of continuing to review/reconcile'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "KB-49: the PR step completed with an empty pr_url (${var.max_pr_url_retries} retries exhausted) — failing loudly at the PR step instead of continuing to review/reconcile without a PR"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "KB-49: the PR step completed with an empty pr_url (retry bookkeeping failed) — failing loudly at the PR step instead of continuing to review/reconcile without a PR"
        }
    }
}

// ── PR review loop ────────────────────────────────────────────────────────────

// Entry point for all reviewer invocations: initial review and re-review after
// fixes. The child workflow's adapters receive only REVIEWER_GITHUB_TOKEN.
step "run_pr_reviewer_loop" {
    target = subworkflow.pr_reviewer_loop
    outcome "success" {
        next = switch.route_pr_reviewer_loop
        write {
            target = data.internal.review_result.value
            value  = subworkflow.review_result
        }
        write {
            target = data.internal.review_status_output.value
            value  = subworkflow.status_output
        }
        // KB-24: a concluded review round renews the scope-reprovision budget
        // for the next round (re-review after developer changes starts fresh).
        write {
            target = data.internal.reviewer_scope_retries.value
            value  = 0
        }
    }
    outcome "failure" {
        next = switch.route_pr_reviewer_loop
        write {
            target = data.internal.review_result.value
            // try(): a child that dies early exposes no outputs at all.
            value  = try(subworkflow.review_result, "")
        }
        write {
            target = data.internal.review_status_output.value
            value  = try(subworkflow.status_output, "")
        }
        write {
            target = data.internal.failure_reason.value
            // try(): a scope that lost its session exposes no outputs at all.
            // Empty means engine-synthesized (timeout / crash / lost session)
            // — the reprovision route re-provisions the scope (fresh rotate +
            // re-dial) instead of failing on the dead session.
            value  = try(subworkflow.failure_reason, "")
        }
    }
}

switch "route_pr_reviewer_loop" {
    match {
        condition = try(steps.run_pr_reviewer_loop.review_result, "") == "approved"
        next      = step.merge_pr
    }
    match {
        condition = try(steps.run_pr_reviewer_loop.review_result, "") == "changes_requested"
        next      = step.triage_pr_feedback
    }
    // Red CI: the coordinator briefs the developer to fix the build. No review
    // pass is spent on code CI has already rejected.
    match {
        condition = try(steps.run_pr_reviewer_loop.review_result, "") == "checks_failed"
        next      = step.triage_pr_feedback
    }
    // No verdict at all: the child never concluded (adapter crashed, provider
    // unreachable, quota exhausted) or died with a reported reason. A reported
    // reason is a genuine child failure rather than a lost session — fail with
    // the true reason instead of burning the reprovision budget on re-running
    // a review that legitimately failed. An empty reason means the child never
    // concluded for an unreported cause: KB-24 re-provisions the reviewer
    // scope (fresh rotate + re-dial, bounded by the retry budget) before
    // re-running the review. On budget exhaustion fail with a typed reason
    // instead of hanging on the dead session.
    match {
        condition = data.internal.failure_reason.value != ""
        next      = state.failed
    }
    match {
        condition = data.internal.reviewer_scope_retries.value < var.max_reviewer_scope_retries
        next      = step.reprovision_reviewer_scope
    }
    default {
        next = step.exhausted_reviewer_scope
    }
}

// KB-24: bookkeeping step that gives the fresh reviewer scope a live session
// before the reviewer subworkflow is re-entered (the subworkflow's adapters
// are provisioned anew on its next invocation — fresh rotate + re-dial).
step "reprovision_reviewer_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'reviewer scope lost its session — re-provisioning scope (fresh rotate + re-dial)'"
    }
    outcome "success" {
        next = step.run_pr_reviewer_loop
        write {
            target = data.internal.reviewer_scope_retries.value
            value  = data.internal.reviewer_scope_retries.value + 1
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "reviewer scope reprovision step failed before the review re-run (KB-24)"
        }
    }
}

// KB-24: the reprovision budget is spent without a review verdict. Fail with
// a typed reason so the parent's failure path (comment + Review column)
// carries actionable text.
step "exhausted_reviewer_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'reviewer scope reprovision budget exhausted — failing the run'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "reviewer scope reprovision budget exhausted (${var.max_reviewer_scope_retries} retries) without a review verdict (KB-24)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "reviewer scope reprovision exhaustion step failed while failing the run (KB-24)"
        }
    }
}

// KB-328: the branch names an already-MERGED PR. Verify the PR state
// authoritatively by branch name (gh keeps PRs resolvable after the head
// branch is squash-deleted) and stamp the recovery blob. rc=2 (unknown /
// not merged) is a fall-through, never an error: the run returns to check_pr,
// which re-classifies with its own eyes.
step "recover_merged_pr" {
    target = adapter.shell.sh
    // KB-219: gh_retry can add ~210s worst case; the timeout covers it.
    timeout = "600s"
    input {
        command = templatefile("./scripts/merged_pr_status.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = step.recover_merged_pr_store_url
        write {
            target = data.internal.merged_recovery.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" { next = step.check_pr }
}

// KB-328 recovery: peel the URL line off the recovery blob into pr_url (the
// parent's route_handler_pr requires a non-empty pr_url and the closing
// comment carries it). Shell-side parsing — the DSL has no regex extract.
step "recover_merged_pr_store_url" {
    target  = adapter.shell.sh
    timeout = "15s"
    input {
        command = templatefile("./scripts/recovery_extract.sh.tftpl", {
            criteria_value_1 = data.internal.merged_recovery.value
            pattern          = "url"
        })
    }
    outcome "success" {
        next = step.recover_merged_pr_store_protocol
        write {
            target = data.internal.pr_url.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" { next = state.failed }
}

// KB-328 recovery: rebuild the merge_pr-shaped protocol (pr=<n>, merge_sha=)
// so the standing merge gate's wait_merge_ci parses recovery exactly like a
// fresh merge — one sha source, one gate.
step "recover_merged_pr_store_protocol" {
    target  = adapter.shell.sh
    timeout = "15s"
    input {
        command = templatefile("./scripts/recovery_extract.sh.tftpl", {
            criteria_value_1 = data.internal.merged_recovery.value
            pattern          = "merge_protocol"
        })
    }
    outcome "success" {
        next = step.recover_merged_ci
        write {
            target = data.internal.merge_pr_result.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" { next = state.failed }
}

// KB-253 (KB-328 recovery leg): close the SAME standing merge gate the
// fresh-merge path closes — the squash commit's own CI must be green before
// the parent reconciles Done. wait_merge_ci receives the merge_pr-shaped
// protocol above, so recovery shares its sha source and poll logic verbatim.
step "recover_merged_ci" {
    target = adapter.shell.sh
    // Recovery usually verdicts on the first poll (squash CI already
    // completed); the step timeout is the same static 3600s envelope as the
    // fresh-merge wait — the configurable budget renders into the script.
    timeout = "3600s"
    input {
        command = templatefile("./scripts/wait_merge_ci.sh.tftpl", {
            criteria_value_1    = data.internal.merge_pr_result.value
            merge_ci_max        = format("%d", var.merge_ci_max_seconds)
            gh_retry            = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = switch.route_recovery_merge_ci
        write {
            target = data.internal.merge_ci_verdict.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            // KB-328 run1 crash class: HCL '+' is arithmetic only — template
            // interpolation instead of string concatenation.
            value  = "merge_ci_failed: recovery arm for ${data.internal.branch.value} — wait_merge_ci failed before reaching a verdict: ${trimspace(output.stderr)}"
        }
    }
}

switch "route_recovery_merge_ci" {
    match {
        condition = startswith(steps.recover_merged_ci.stdout, "merge_ci=green")
        next      = state.done
    }
    default { next = step.fail_merge_ci }
}

// ── Merge ─────────────────────────────────────────────────────────────────────

step "merge_pr" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/merge_pr.sh.tftpl", {
            criteria_value_1 = data.internal.pr_url.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    // KB-219: gh_retry wrapper can add up to ~210s of backoff on transient
    // blips (KB-235 doubled the schedule to 30/60/120s); the step timeout
    // covers the worst-case wall clock.
    timeout = "600s"
    outcome "success" {
        next = step.wait_merge_ci
        write {
            target = data.internal.merge_pr_result.value
            value  = output.stdout
        }
    }
    // A refused merge is usually actionable, not terminal: an unresolved review
    // thread (GitHub's required_conversation_resolution), a bot review that
    // landed after the approving pass, or an approval dismissed by a new commit.
    // Route it to the coordinator with the diagnostics above instead of killing
    // the run — triage_pr_feedback is bounded by max_visits, so a genuinely
    // unmergeable PR still terminates rather than looping forever.
    outcome "failure" {
        next = step.triage_pr_feedback
        write {
            target = data.internal.developer_feedback.value
            value = templatefile("./agents/merge_refused.md.tftpl", {
                stdout = output.stdout
            })
        }
    }
}

// KB-272: close the standing merge gate inside the workflow. The gate binds
// mergers: after ANY merge, wait for the squash commit's OWN CI to complete
// green BEFORE reconciling the kanboard ticket to Done. The parent trees'
// post-merge bookkeeping (comment_handler_done -> set_done_state) trusts this
// handler's success, so the gate must close here: green -> the existing done
// arm; red/timeout -> the assistance lane (typed failure_reason, parent parks
// the ticket in Review, NO Done move). The script is bounded (10 min, 30s
// cadence, gh_retry transport wrapper); the sha comes straight from
// merge_pr's output, so the wait never re-derives it.
step "wait_merge_ci" {
    target = adapter.shell.sh
    // KB-328: the budget is project-configurable via var.merge_ci_max_seconds
    // (rendered into the script's default); the step timeout is a static
    // 3600s ceiling that must exceed any sane budget + gh_retry backoff.
    timeout = "3600s"
    input {
        command = templatefile("./scripts/wait_merge_ci.sh.tftpl", {
            criteria_value_1    = data.internal.merge_pr_result.value
            merge_ci_max        = format("%d", var.merge_ci_max_seconds)
            gh_retry            = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    outcome "success" {
        next = switch.route_merge_ci
        write {
            target = data.internal.merge_ci_verdict.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            // KB-328 run1 crash class: HCL '+' is arithmetic only — a string
            // concat here died at runtime ('Invalid operand; a number is
            // required') AFTER wait_merge_ci produced a verdict, so
            // failure_reason never landed. Template interpolation instead.
            value  = "merge_ci_failed: ${data.internal.pr_url.value} — wait_merge_ci failed before reaching a verdict: ${trimspace(output.stderr)}"
        }
    }
}

// KB-272: only a completed-green merge-commit CI rollup proceeds to the done
// arm. failed/timeout/anything-else falls to the assistance lane — fail
// closed, never a provisional Done.
switch "route_merge_ci" {
    match {
        condition = startswith(steps.wait_merge_ci.stdout, "merge_ci=green")
        next      = step.teardown_worktree
    }
    default { next = step.fail_merge_ci }
}

// KB-272: red or timeout on the squash commit's own CI is exactly the
// "not discoverable state" the failed terminal exists for: the run fails
// loudly with a typed reason and the parent's bookkeeping (comment +
// review-column parking) runs instead of the Done reconcile — the card is
// never stamped Done over a merge whose CI never went green. A red merge
// commit is developer-actionable, but the assistance lane is the right
// terminal here: the tree already converged (reviewer-approved, merged),
// and re-running the develop loop over the same commit cannot help — a human
// or a new push needs to decide.
step "fail_merge_ci" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'merge-commit CI did not complete green after the squash merge — failing the run loudly instead of reconciling Done (KB-272)'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            // KB-328 run1 crash class: HCL '+' is arithmetic only — string
            // concatenation in BOTH arms died at runtime ('Invalid operand;
            // a number is required') and failure_reason never landed even
            // though the merge gate had reached a typed verdict. Template
            // interpolation is the concatenation mechanism.
            value  = "merge_ci_failed: ${data.internal.pr_url.value} — the squash commit's own CI did not complete green after the merge; Done reconcile withheld (KB-272 standing merge gate): ${data.internal.merge_ci_verdict.value}"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            // Same crash class as the success arm — keep the two arms
            // expression-identical so a failure-arm crash can never mask the
            // typed verdict again.
            value  = "merge_ci_failed: ${data.internal.pr_url.value} — the squash commit's own CI did not complete green after the merge; Done reconcile withheld (KB-272 standing merge gate): ${data.internal.merge_ci_verdict.value}"
        }
    }
}

// Remove the isolated worktree after a successful merge. Runs in the repo's
// primary tree (adapter.shell.repo). Only reached on the success path — failure
// terminals deliberately leave the worktree in place for inspection. Cleanup
// problems never fail the run.
step "teardown_worktree" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/teardown_worktree.sh.tftpl", {
            criteria_value_1 = var.worktree_dir
            criteria_value_2 = data.internal.branch.value
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
        })
    }
    // KB-219: gh_retry wrapper can add up to ~210s of backoff on transient
    // blips (KB-235 doubled the schedule to 30/60/120s); the step timeout
    // covers the worst-case wall clock.
    timeout = "600s"
    outcome "success" { next = state.done }
    outcome "failure" { next = state.done }
}

// ── Coordinator feedback loop ─────────────────────────────────────────────────

// Coordinator reads every open review thread on the PR, decides what requires
// code changes vs. can be dismissed, and writes a precise developer brief.
// Outcomes:
//   has_work  — developer must make changes; brief written to data.internal.developer_feedback
//   no_work   — all comments can be resolved by responding; skip developer loop
//   failed    — unrecoverable

step "triage_pr_feedback" {
    target      = adapter.copilot.coordinator
    max_visits  = var.max_feedback_visits
    allow_tools = ["*"]

    input {
                prompt = templatefile("./agents/triage_pr_feedback.md.tftpl", {
                        pr_url          = data.internal.pr_url.value
                        branch          = data.internal.branch.value
                        workstream_file = var.workstream_file
                    status_output   = data.internal.review_status_output.value
                    // Merge-refusal diagnostics (from merge_pr's stdout). Carries
                    // the failed-CI-workflow signal so the coordinator can route a
                    // broken workflow file / absent required checks to the developer
                    // instead of finding no_work and spinning (observed: CRI-93).
                    merge_feedback  = data.internal.developer_feedback.value
                })
    }

    outcome "has_work" {
        next = step.run_pair_programming_loop_with_feedback
        schema = object({ reason = string })
        write {
            target = data.internal.developer_feedback.value
            value  = output.reason
        }

    }
    outcome "no_work" {
        schema = object({ reason = string })
        next = step.push_and_respond
    }
    outcome "failed" {
        schema = object({ reason = string })
        next = state.failed
        // KB-262: carry the typed reason through the boundary — the parent's
        // failure comment interpolates failure_reason; an unwritten
        // data.internal here resolves empty and the reason is lost.
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "failure" {
        schema = object({ reason = string })
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "default" {
        schema = object({ reason = string })
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
}

// KB-265: branch manager has the FINAL SAY on convergence. Reached when the
// feedback round budget is spent: the coordinator re-verifies actual state
// (branch vs PR vs CI) and decides — converge_on_state routes to the normal
// completion path (merge), blocked fails loud with a typed reason.
step "branch_manager_final_say" {
    target      = adapter.copilot.coordinator
    max_visits  = var.max_feedback_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/branch_manager_final_say.md.tftpl", {
            pr_url             = data.internal.pr_url.value
            branch             = data.internal.branch.value
            developer_feedback = data.internal.developer_feedback.value
            rounds             = data.internal.validate_rounds.value
            hand_off_count     = data.internal.hand_off_count.value
            last_hand_off      = data.internal.last_hand_off_brief.value
        })
    }
    outcome "converge_on_state" {
        next   = step.push_and_respond
        schema = object({ reason = string })
    }
    // KB-267: the blocker is developer-actionable — emit the typed
    // remediation brief and hand it back to the develop leg through a
    // FRESH round (new dial step -> round-suffixed instances -> new
    // developer/reviewer sessions whose first prompt is the brief). The
    // hand-off consumes budget: the incremented count routes the next
    // round dial via switch.hand_off_route, and after the second hand-off
    // the manager must verdict blocked (the parked-run protection of
    // KB-265 is preserved — the hand-off is bounded, not a reopen).
    outcome "hand_off" {
        next   = step.increment_hand_off_count
        schema = object({ reason = string })
        write {
            target = data.internal.developer_feedback.value
            value  = output.reason
        }
        write {
            target = data.internal.last_hand_off_brief.value
            value  = output.reason
        }
    }
    outcome "blocked" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "failure" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "default" {
        next   = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
}

// KB-267: deterministic hand-off counter increment. The branch manager
// never counts its own hand-offs (agent math is untrustworthy); a shell
// step increments and the router picks the fresh-round dial from the
// stored count. Failure here is a genuine run failure with a typed reason,
// never a silent hand-off bypass.
step "increment_hand_off_count" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = templatefile("./scripts/increment_hand_off_count.sh.tftpl", {
            criteria_value_1 = data.internal.hand_off_count.value
        })
    }
    outcome "success" {
        next = switch.hand_off_route
        write {
            target = data.internal.hand_off_count.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            // KB-328 run1 crash class: HCL '+' is arithmetic only — template
            // interpolation instead of string concatenation.
            value  = "increment_hand_off_count failed: ${output.stderr}"
        }
    }
}

// KB-267: route the hand-off to the round-fresh develop leg. Two counts are
// representable — two fresh rounds are provisioned (r2, r3) and the branch
// manager template forbids a third hand-off (blocked beyond two with a
// typed reason), so the default arm is a defensive terminus only.
switch "hand_off_route" {
    match {
        condition = trimspace(steps.increment_hand_off_count.stdout) == "1"
        next      = step.run_pair_programming_loop_with_feedback_r2
    }
    match {
        condition = trimspace(steps.increment_hand_off_count.stdout) == "2"
        next      = step.run_pair_programming_loop_with_feedback_r3
    }
    default { next = state.failed }
}

// Round-fresh dial steps mirror the base dial: success flows into the same
// validate_round_check (the budget counter is spent for real by then, so
// the check hands the final say back to the branch manager), failure fails
// loud. max_visits kept form-compliant with the base dial.
step "run_pair_programming_loop_with_feedback_r2" {
    target     = subworkflow.pair_programming_loop_feedback_r2
    max_visits = var.max_pair_cycles
    outcome "success" { next = step.validate_round_check }
    outcome "failure" {
        next = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value = try(output.reason, "")
        }
    }
}

step "run_pair_programming_loop_with_feedback_r3" {
    target     = subworkflow.pair_programming_loop_feedback_r3
    max_visits = var.max_pair_cycles
    outcome "success" { next = step.validate_round_check }
    outcome "failure" {
        next = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value = try(output.reason, "")
        }
    }
}

// max_visits bounds the coordinator's needs_work <-> developer cycle — a brief
// that never converges fails the run instead of looping indefinitely.
step "run_pair_programming_loop_with_feedback" {
    target     = subworkflow.pair_programming_loop_feedback
    max_visits = var.max_pair_cycles
    outcome "success" { next = step.validate_round_check }
    outcome "failure" {
        next = state.failed
        schema = object({ reason = string })
        write {
            target = data.internal.failure_reason.value
            value = try(output.reason, "")
        }
    }
}

// KB-265: the feedback loop is bounded by rounds, not by the validator's
// mood. Each entry into validation increments validate_rounds before
// re-entry; once the round budget is spent the BRANCH MANAGER gets the
// final say on convergence (dave ruling): reviewer-approved + CI-green +
// nothing-new converges (merge), a real blocker fails loud. A validator
// that keeps needs_work'ing a finished diff ends here with a typed
// decision, never an unterminable cycle.
step "validate_round_check" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = templatefile("./scripts/validate_round_check.sh.tftpl", {
            // templatefile vars keep their HCL types: max_pair_cycles is a number and
            // shellquote() in the template rejects int64 (live kb-264-1792105840: died at
            // first arm execution). Render the number canonically BEFORE the template.
            criteria_value_1 = format("%d", var.max_pair_cycles)
            criteria_value_2 = data.internal.validate_rounds.value
        })
    }

    // KB-264: the shell adapter emits only the adapter-default
    // success/failure pair over the default output type
    // (exit_code/stdout/stderr) — custom verdict names never fire on a
    // shell step. The round decision rides stdout instead (KB-265):
    //   "budget_spent"        — no entries remain → the branch manager
    //                           decides (switch below)
    //   "<incremented count>" — validation re-enters with the count
    // The success arm stores the trimmed counter but must not store the
    // budget_spent marker (it feeds branch_manager_final_say's prompt);
    // the guard keeps the step-entry value there, matching the
    // transport-preserving write pattern on the reviewer loop.
    outcome "success" {
        next = switch.validate_round_check_route
        write {
            target = data.internal.validate_rounds.value
            value  = trimspace(output.stdout) == "budget_spent" ? data.internal.validate_rounds.value : trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.failed
        // KB-262: carry the typed reason through the boundary — the
        // parent's failure comment interpolates failure_reason.
        write {
            target = data.internal.failure_reason.value
            // KB-328 run1 crash class: HCL '+' is arithmetic only — template
            // interpolation instead of string concatenation.
            value  = "validate_round_check failed: ${output.stderr}"
        }
    }
}

// KB-265: budget spent → the branch manager's final say on convergence;
// otherwise the coordinator validates the state against the outstanding
// brief (normal completion path).
switch "validate_round_check_route" {
    match {
        condition = trimspace(steps.validate_round_check.stdout) == "budget_spent"
        next      = step.branch_manager_final_say
    }
    default { next = step.validate_developer_response }
}

// Coordinator inspects the developer's commits against the brief it wrote.
// Approves only when every requirement is fully satisfied.
// On needs_work, updates data.internal.developer_feedback with what is still missing
// so the developer gets a targeted brief on the next pass.

step "validate_developer_response" {
    target      = adapter.copilot.coordinator
    allow_tools = ["*"]

    input {
                prompt = templatefile("./agents/validate_developer_response.md.tftpl", {
                        branch             = data.internal.branch.value
                        developer_feedback = data.internal.developer_feedback.value
                })
    }

    outcome "approved" {
        schema = object({ reason = string })
        next = step.push_and_respond
    }
    outcome "needs_work" {
        next = step.run_pair_programming_loop_with_feedback
        schema = object({ reason = string })
        write {
            target = data.internal.developer_feedback.value
            value  = output.reason
        }

    }
    outcome "failed" {
        schema = object({ reason = string })
        next = state.failed
        // KB-262: carry the typed reason through the boundary — the parent's
        // failure comment interpolates failure_reason; an unwritten
        // data.internal here resolves empty and the reason is lost.
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "failure" {
        schema = object({ reason = string })
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "default" {
        schema = object({ reason = string })
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
}

// Coordinator pushes the branch and closes every open review thread on the PR.
// Called after either an approved developer pass or a no_work triage decision.

step "push_and_respond" {
    target      = adapter.copilot.coordinator
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/push_and_respond.md.tftpl", {
            pr_url = data.internal.pr_url.value
            branch = data.internal.branch.value
            helper = file("./scripts/_github_token_git_credentials.sh.tftpl")
        })
    }

    outcome "success" {
        schema = object({ reason = string })
        next = step.run_pr_reviewer_loop
    }
    outcome "failed" {
        schema = object({ reason = string })
        next = state.failed
        // KB-262: carry the typed reason through the boundary — the parent's
        // failure comment interpolates failure_reason; an unwritten
        // data.internal here resolves empty and the reason is lost.
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "failure" {
        schema = object({ reason = string })
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
    outcome "default" {
        schema = object({ reason = string })
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = output.reason
        }
    }
}

// ── Terminal states ───────────────────────────────────────────────────────────

state "done" {
    terminal = true
    success  = true
}

state "failed" {
    terminal = true
    success  = false
}

output "branch" {
    type  = string
    value = data.internal.branch.value
}

output "pr_url" {
    type  = string
    value = data.internal.pr_url.value
}

// KB-24: typed failure reason for the parent tree's failure comment. Empty on
// every non-failure path.
output "failure_reason" {
    type  = string
    value = data.internal.failure_reason.value
}

// KB-51: the reviewer loop's verdict of the final review round ("approved"
// on the merged path; empty when the run failed before any review round
// concluded). Additive, consumed by kanboard_develop_v1's closing evidence
// comment so a develop run posts its verdict on the ticket.
output "review_result" {
    type  = string
    value = data.internal.review_result.value
}
