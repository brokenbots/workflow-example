workflow {
    name          = "workstream_handler_v1"
    version       = "1"
    criteria_version = ">=0.5.9, <0.6.0"
    initial_state = "read_workstream"
    target_state  = "done"

    policy {
        max_total_steps = 200
    }
}

data "internal" "branch" {
    type  = string
    value = ""
}

data "internal" "pr_url" {
    type  = string
    value = ""
}

// Note from branch_manager describing any uncommitted work it stashed for a
// rebase and restored to the tree. Surfaced to the developer so they know the
// tree was dirty on arrival and can commit/discard accordingly.
data "internal" "branch_notes" {
    type  = string
    value = ""
}

// Coordinator's distilled brief for the developer, written by triage_pr_feedback
// and updated by validate_developer_response on needs_work cycles.
data "internal" "developer_feedback" {
    type  = string
    value = ""
}

data "internal" "review_result" {
    type  = string
    value = ""
}

data "internal" "review_status_output" {
    type  = string
    value = ""
}

// KB-24: typed failure reason surfaced by this tree or its subworkflows.
// Empty means the failure was engine-synthesized (timeout / crash / lost
// adapter-scope session) — the signal the scope-reprovision routes act on.
data "internal" "failure_reason" {
    type  = string
    value = ""
}

// KB-24: bounded re-provision budgets for lost scope sessions. The reviewer
// counter resets on every successful review round so each round gets a full
// budget.
data "internal" "reviewer_scope_retries" {
    type  = number
    value = 0
}

data "internal" "branch_scope_retries" {
    type  = number
    value = 0
}

subworkflow "branch_manager" {
    source = "./workflows/branch_manager"
    input = {
        workstream_file = var.workstream_file
        base_branch     = var.base_branch
        repo_dir        = var.repo_dir
        worktree_dir    = var.worktree_dir
        max_repair_visits = var.max_branch_repair_visits
        provider_base_url = var.provider_base_url
        workflow_github_token = var.workflow_github_token
    }
}

subworkflow "pr_reviewer_loop" {
    source = "./workflows/pr_reviewer_loop"
    input = {
        pr_url          = data.internal.pr_url.value
        workstream_file = var.workstream_file
        worktree_dir    = var.worktree_dir
        max_poll_visits    = var.max_reviewer_poll_visits
        max_backoff_visits = var.max_reviewer_backoff_visits
        max_review_visits  = var.max_review_visits
        provider_base_url  = var.provider_base_url
        reviewer_github_token = var.reviewer_github_token
    }
}

subworkflow "pair_programming_loop" {
    source = "./workflows/pair_programming_loop"
    input = {
        workstream_file       = var.workstream_file
        ci_gate_cmd           = var.ci_gate_cmd
        log_file              = var.log_file != "" ? var.log_file : null
        allow_dirty           = var.allow_dirty
        branch_notes          = data.internal.branch_notes.value
        worktree_dir          = var.worktree_dir
        max_agent_visits      = var.max_pair_agent_visits
        provider_base_url     = var.provider_base_url
        workflow_github_token = var.workflow_github_token
        git_credential_helper = file("./scripts/_github_token_git_credentials.sh.tftpl")
    }
}

// Re-uses the same loop with coordinator feedback injected as the initial prompt.
subworkflow "pair_programming_loop_feedback" {
    source = "./workflows/pair_programming_loop"
    input = {
        workstream_file          = var.workstream_file
        ci_gate_cmd              = var.ci_gate_cmd
        developer_initial_prompt = data.internal.developer_feedback.value
        log_file                 = var.log_file != "" ? var.log_file : null
        allow_dirty              = var.allow_dirty
        branch_notes             = data.internal.branch_notes.value
        worktree_dir             = var.worktree_dir
        max_agent_visits         = var.max_pair_agent_visits
        provider_base_url        = var.provider_base_url
        workflow_github_token    = var.workflow_github_token
        git_credential_helper    = file("./scripts/_github_token_git_credentials.sh.tftpl")
    }
}

// ── Initial delivery ──────────────────────────────────────────────────────────

// Runs in the repo's primary tree (adapter.shell.repo): the per-run worktree is
// not created until branch_manager, so this first step must not depend on it.
step "read_workstream" {
    target = adapter.shell.repo
    input {
        command = "cat '${var.workstream_file}'"
    }
    outcome "success" { next = step.run_branch_manager }
    outcome "failure" { next = state.failed }
}

step "run_branch_manager" {
    target = subworkflow.branch_manager
    outcome "success" {
        next = step.check_pr
        write {
            target = data.internal.branch.value
            value  = subworkflow.branch
        }
        write {
            target = data.internal.branch_notes.value
            value  = subworkflow.stash_report
        }
    }
    outcome "failure" {
        next = switch.route_branch_scope_reprovision
        write {
            target = data.internal.failure_reason.value
            // try(): a scope that lost its session exposes no outputs at all.
            // Empty means engine-synthesized (timeout / crash / lost session)
            // — the reprovision route re-provisions the scope (fresh rotate +
            // re-dial) instead of failing on the dead session.
            value  = try(subworkflow.failure_reason, "")
        }
    }
}

// KB-24: route the branch_manager failure. A reported reason is a genuine
// failure (agent-decided escalation), so fail with it; an empty reason is a
// lost scope session, so re-provision (fresh rotate + re-dial), bounded by
// the branch scope retry budget.
switch "route_branch_scope_reprovision" {
    match {
        condition = data.internal.failure_reason.value != ""
        next      = state.failed
    }
    match {
        condition = data.internal.branch_scope_retries.value < var.max_branch_scope_retries
        next      = step.reprovision_branch_scope
    }
    default { next = step.exhausted_branch_scope }
}

// KB-24: bookkeeping step that gives the fresh coordinator scope a live
// session before the coordinator subworkflow is re-entered (the subworkflow's
// copilot scope is provisioned anew on its next invocation — fresh rotate +
// re-dial).
step "reprovision_branch_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'branch scope lost its session — re-provisioning scope (fresh rotate + re-dial)'"
    }
    outcome "success" {
        next = step.run_branch_manager
        write {
            target = data.internal.branch_scope_retries.value
            value  = data.internal.branch_scope_retries.value + 1
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "branch scope reprovision step failed before the branch re-run (KB-24)"
        }
    }
}

// KB-24: the reprovision budget is spent with nothing to show for it. Fail
// with a typed reason so the parent's failure path carries actionable text.
step "exhausted_branch_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'branch scope reprovision budget exhausted — failing the run'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "branch scope reprovision budget exhausted (${var.max_branch_scope_retries} retries) without a reported reason (KB-24)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "branch scope reprovision exhaustion step failed while failing the run (KB-24)"
        }
    }
}

// ── PR state check ────────────────────────────────────────────────────────────
//
// Determines what to do before touching developer or reviewer loops.
// First line of stdout (read by route_pr and route_pr_action):
//   status:no_pr         — no PR; need developer work first
//   status:merged        — already merged; run developer then open fresh PR
//   status:closed        — PR closed; run developer then open fresh PR
//   status:pending       — CI still running; back off and retry
//   status:checks_failed — required check failed
//   status:ready         — APPROVED + CI green + no unresolved threads; merge now
//   status:needs_work    — CHANGES_REQUESTED or unresolved threads; triage
//   status:open          — PR exists, CI green, not yet reviewed

step "check_pr" {
    target     = adapter.shell.sh
    max_visits = var.max_pr_poll_visits
    input {
        command = templatefile("./scripts/check_pr.sh.tftpl", {})
    }
    outcome "success" { next = switch.route_pr }
    outcome "failure" { next = state.failed }
}

switch "route_pr" {
    match {
        condition = startswith(steps.check_pr.stdout, "status:no_pr")
        next      = step.run_pair_programming_loop
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:merged")
        next      = step.run_pair_programming_loop
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:closed")
        next      = step.run_pair_programming_loop
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:pending")
        next      = step.backoff_pr
    }
    // ready / open / needs_work / checks_failed — load URL then re-route
    default { next = step.store_pr_url }
}

// Back off while CI is running, then re-check.
step "backoff_pr" {
    target     = adapter.shell.sh
    timeout    = "300s"
    max_visits = var.max_pr_poll_visits
    input {
        command = "echo 'CI pending — sleeping 60s'; sleep 60"
    }
    outcome "success" { next = step.check_pr }
    outcome "failure" { next = step.check_pr }
}

// Fetch and store the PR URL. Kept separate from check_pr so that
// steps.check_pr.stdout remains readable by route_pr_action.
step "store_pr_url" {
    target = adapter.shell.sh
    input {
        command = "gh pr view \"$(git branch --show-current)\" --json url --jq '.url' | tr -d '\\n'"
    }
    outcome "success" {
        next = switch.route_pr_action
        write {
            target = data.internal.pr_url.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// Re-read check_pr.stdout (still in scope) to choose the action now that
// pr_url is available.
switch "route_pr_action" {
    match {
        condition = startswith(steps.check_pr.stdout, "status:ready")
        next      = step.merge_pr
    }
    match {
        condition = startswith(steps.check_pr.stdout, "status:open")
        next      = switch.route_reviewer_creds
    }
    // needs_work or checks_failed: skip developer, straight to coordinator triage
    default { next = step.triage_pr_feedback }
}

// ── Developer work ────────────────────────────────────────────────────────────

step "run_pair_programming_loop" {
    target = subworkflow.pair_programming_loop
    outcome "success" { next = step.sync_head_branch }
    outcome "failure" { next = state.failed }
}

// CRI-273 defense in depth: the developer may have worked in a second clone
// it created itself, leaving the worktree on the empty ticket branch —
// create_pr would then fail with "No commits between <base> and <ticket>"
// and the merge would never run. Before creating the PR, resolve the branch
// that actually carries the work (the agent's most recently pushed branch
// naming this ticket, or ahead of base with no other ticket's name) and
// check it out in the worktree. On the happy path this is a no-op: the
// worktree branch already has commits ahead of base and is echoed back.
// stdout (the resolved branch) is stored into data.internal.branch so
// create_pr, push_and_respond and teardown all operate on the same branch.
step "sync_head_branch" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/resolve_head_branch.sh.tftpl", {
            criteria_value_1 = var.base_branch
            criteria_value_2 = var.workstream_file
            helper           = file("./scripts/_github_token_git_credentials.sh.tftpl")
        })
    }
    timeout = "60s"
    outcome "success" {
        next = step.create_pr
        write {
            target = data.internal.branch.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" { next = state.failed }
}

// Create a PR from the current branch; idempotent — reuses existing PR if present.

step "create_pr" {
    target = adapter.shell.sh
    input {
        command = templatefile("./scripts/create_pr.sh.tftpl", {
            criteria_value_1 = var.base_branch
            criteria_value_2 = var.workstream_file
            helper           = file("./scripts/_github_token_git_credentials.sh.tftpl")
        })
    }
    timeout = "60s"
    outcome "success" {
        next = switch.route_reviewer_creds
        write {
            target = data.internal.pr_url.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// ── PR review loop ────────────────────────────────────────────────────────────

// Entry point for all reviewer invocations: initial review and re-review after
// fixes. The child workflow's adapters receive only REVIEWER_GITHUB_TOKEN.
switch "route_reviewer_creds" {
    match {
        condition = var.ticket_id != ""
        next      = step.set_linear_review_state
    }
    default { next = step.run_pr_reviewer_loop }
}

// Keep Linear aligned with the delivery lifecycle. This step is idempotent and
// runs before initial review and every re-review after developer changes.
step "set_linear_review_state" {
    target = adapter.shell.linear
    input {
        command = templatefile("./scripts/set_linear_review_state.sh.tftpl", {
            criteria_value_1 = var.ticket_id
            criteria_value_2 = var.linear_review_state
        })
    }
    outcome "success" { next = step.run_pr_reviewer_loop }
    outcome "failure" { next = state.failed }
}

// Restore coordinator credentials on both outcomes before routing the review
// result. A failed child has no actionable review verdict and falls through to
// the terminal failure route below.
step "run_pr_reviewer_loop" {
    target = subworkflow.pr_reviewer_loop
    outcome "success" {
        next = switch.route_pr_reviewer_loop
        write {
            target = data.internal.review_result.value
            value  = subworkflow.review_result
        }
        write {
            target = data.internal.review_status_output.value
            value  = subworkflow.status_output
        }
        // KB-24: a concluded review round renews the scope-reprovision budget
        // for the next round (re-review after developer changes starts fresh).
        write {
            target = data.internal.reviewer_scope_retries.value
            value  = 0
        }
    }
    outcome "failure" {
        next = switch.route_pr_reviewer_loop
        write {
            target = data.internal.review_result.value
            // try(): a child that dies early exposes no outputs at all.
            value  = try(subworkflow.review_result, "")
        }
        write {
            target = data.internal.review_status_output.value
            value  = try(subworkflow.status_output, "")
        }
        write {
            target = data.internal.failure_reason.value
            // try(): a scope that lost its session exposes no outputs at all.
            // Empty means engine-synthesized (timeout / crash / lost session)
            // — the reprovision route re-provisions the scope (fresh rotate +
            // re-dial) instead of failing on the dead session.
            value  = try(subworkflow.failure_reason, "")
        }
    }
}

switch "route_pr_reviewer_loop" {
    match {
        condition = try(steps.run_pr_reviewer_loop.review_result, "") == "approved"
        next      = step.merge_pr
    }
    match {
        condition = try(steps.run_pr_reviewer_loop.review_result, "") == "changes_requested"
        next      = step.triage_pr_feedback
    }
    // Red CI: the coordinator briefs the developer to fix the build. No review
    // pass is spent on code CI has already rejected.
    match {
        condition = try(steps.run_pr_reviewer_loop.review_result, "") == "checks_failed"
        next      = step.triage_pr_feedback
    }
    // No verdict at all: the child never concluded (adapter crashed, provider
    // unreachable, quota exhausted) or died with a reported reason. A reported
    // reason is a genuine child failure rather than a lost session — fail with
    // the true reason instead of burning the reprovision budget on re-running
    // a review that legitimately failed. An empty reason means the child never
    // concluded for an unreported cause: KB-24 re-provisions the reviewer
    // scope (fresh rotate + re-dial, bounded by the retry budget) before
    // re-running the review. On budget exhaustion fail with a typed reason
    // instead of hanging on the dead session.
    match {
        condition = data.internal.failure_reason.value != ""
        next      = state.failed
    }
    match {
        condition = data.internal.reviewer_scope_retries.value < var.max_reviewer_scope_retries
        next      = step.reprovision_reviewer_scope
    }
    default {
        next = step.exhausted_reviewer_scope
    }
}

// KB-24: bookkeeping step that gives the fresh reviewer scope a live session
// before the reviewer subworkflow is re-entered (the subworkflow's adapters
// are provisioned anew on its next invocation — fresh rotate + re-dial).
step "reprovision_reviewer_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'reviewer scope lost its session — re-provisioning scope (fresh rotate + re-dial)'"
    }
    outcome "success" {
        next = step.run_pr_reviewer_loop
        write {
            target = data.internal.reviewer_scope_retries.value
            value  = data.internal.reviewer_scope_retries.value + 1
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "reviewer scope reprovision step failed before the review re-run (KB-24)"
        }
    }
}

// KB-24: the reprovision budget is spent without a review verdict. Fail with
// a typed reason so the parent's failure path (comment + Review column)
// carries actionable text.
step "exhausted_reviewer_scope" {
    target  = adapter.shell.sh
    timeout = "10s"
    input {
        command = "echo 'reviewer scope reprovision budget exhausted — failing the run'"
    }
    outcome "success" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "reviewer scope reprovision budget exhausted (${var.max_reviewer_scope_retries} retries) without a review verdict (KB-24)"
        }
    }
    outcome "failure" {
        next = state.failed
        write {
            target = data.internal.failure_reason.value
            value  = "reviewer scope reprovision exhaustion step failed while failing the run (KB-24)"
        }
    }
}

// ── Merge ─────────────────────────────────────────────────────────────────────

step "merge_pr" {
    target  = adapter.shell.sh
    timeout = "60s"
    input {
        command = templatefile("./scripts/merge_pr.sh.tftpl", {
            criteria_value_1 = data.internal.pr_url.value
        })
    }
    outcome "success" { next = step.teardown_worktree }
    // A refused merge is usually actionable, not terminal: an unresolved review
    // thread (GitHub's required_conversation_resolution), a bot review that
    // landed after the approving pass, or an approval dismissed by a new commit.
    // Route it to the coordinator with the diagnostics above instead of killing
    // the run — triage_pr_feedback is bounded by max_visits, so a genuinely
    // unmergeable PR still terminates rather than looping forever.
    outcome "failure" {
        next = step.triage_pr_feedback
        write {
            target = data.internal.developer_feedback.value
            value = templatefile("./agents/merge_refused.md.tftpl", {
                stdout = output.stdout
            })
        }
    }
}

// Remove the isolated worktree after a successful merge. Runs in the repo's
// primary tree (adapter.shell.repo). Only reached on the success path — failure
// terminals deliberately leave the worktree in place for inspection. Cleanup
// problems never fail the run.
step "teardown_worktree" {
    target  = adapter.shell.repo
    timeout = "30s"
    input {
        command = templatefile("./scripts/teardown_worktree.sh.tftpl", {
            criteria_value_1 = var.worktree_dir
            criteria_value_2 = data.internal.branch.value
        })
    }
    outcome "success" { next = state.done }
    outcome "failure" { next = state.done }
}

// ── Coordinator feedback loop ─────────────────────────────────────────────────

// Coordinator reads every open review thread on the PR, decides what requires
// code changes vs. can be dismissed, and writes a precise developer brief.
// Outcomes:
//   has_work  — developer must make changes; brief written to data.internal.developer_feedback
//   no_work   — all comments can be resolved by responding; skip developer loop
//   failed    — unrecoverable

step "triage_pr_feedback" {
    target      = adapter.copilot.coordinator
    max_visits  = var.max_feedback_visits
    allow_tools = ["*"]

    input {
                prompt = templatefile("./agents/triage_pr_feedback.md.tftpl", {
                        pr_url          = data.internal.pr_url.value
                        branch          = data.internal.branch.value
                        workstream_file = var.workstream_file
                    status_output   = data.internal.review_status_output.value
                    // Merge-refusal diagnostics (from merge_pr's stdout). Carries
                    // the failed-CI-workflow signal so the coordinator can route a
                    // broken workflow file / absent required checks to the developer
                    // instead of finding no_work and spinning (observed: CRI-93).
                    merge_feedback  = data.internal.developer_feedback.value
                })
    }

    outcome "has_work" {
        next = step.run_pair_programming_loop_with_feedback
        write {
            target = data.internal.developer_feedback.value
            value  = output.reason
        }
    }
    outcome "no_work"  { next = step.push_and_respond }
    outcome "failed"   { next = state.failed }
    outcome "failure"  { next = state.failed }
    outcome "default"  { next = state.failed }
}

// max_visits bounds the coordinator's needs_work <-> developer cycle — a brief
// that never converges fails the run instead of looping indefinitely.
step "run_pair_programming_loop_with_feedback" {
    target     = subworkflow.pair_programming_loop_feedback
    max_visits = var.max_pair_cycles
    outcome "success" { next = step.validate_developer_response }
    outcome "failure" { next = state.failed }
}

// Coordinator inspects the developer's commits against the brief it wrote.
// Approves only when every requirement is fully satisfied.
// On needs_work, updates data.internal.developer_feedback with what is still missing
// so the developer gets a targeted brief on the next pass.

step "validate_developer_response" {
    target      = adapter.copilot.coordinator
    allow_tools = ["*"]

    input {
                prompt = templatefile("./agents/validate_developer_response.md.tftpl", {
                        branch             = data.internal.branch.value
                        developer_feedback = data.internal.developer_feedback.value
                })
    }

    outcome "approved"   { next = step.push_and_respond }
    outcome "needs_work" {
        next = step.run_pair_programming_loop_with_feedback
        write {
            target = data.internal.developer_feedback.value
            value  = output.reason
        }
    }
    outcome "failed"     { next = state.failed }
    outcome "failure"    { next = state.failed }
    outcome "default"    { next = state.failed }
}

// Coordinator pushes the branch and closes every open review thread on the PR.
// Called after either an approved developer pass or a no_work triage decision.

step "push_and_respond" {
    target      = adapter.copilot.coordinator
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/push_and_respond.md.tftpl", {
            pr_url = data.internal.pr_url.value
            branch = data.internal.branch.value
            helper = file("./scripts/_github_token_git_credentials.sh.tftpl")
        })
    }

    outcome "success" { next = switch.route_reviewer_creds }
    outcome "failed"  { next = state.failed }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Terminal states ───────────────────────────────────────────────────────────

state "done" {
    terminal = true
    success  = true
}

state "failed" {
    terminal = true
    success  = false
}

output "branch" {
    type  = string
    value = data.internal.branch.value
}

output "pr_url" {
    type  = string
    value = data.internal.pr_url.value
}

// KB-24: typed failure reason for the parent tree's failure comment. Empty on
// every non-failure path.
output "failure_reason" {
    type  = string
    value = data.internal.failure_reason.value
}
