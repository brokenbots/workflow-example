environment "sandbox" "worktree" {
    working_directory = var.worktree_dir
    network = {
        allow = ["*"]
    }
}

environment "sandbox" "primary" {
    working_directory = var.repo_dir
    network = {
        allow = ["*"]
    }
}

adapter "copilot" "coordinator" {
    environment = sandbox.worktree
    source  = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version = "0.5.4"
    // copilot >= 0.5.2 requires a GitHub token over the secret channel.
    //
    // The sandbox strips both source-token variables before adapter launch.
    // Only the non-review identity is reintroduced into this session.
    secrets {
        GITHUB_TOKEN = var.WORKFLOW_GITHUB_TOKEN
        GH_TOKEN     = var.WORKFLOW_GITHUB_TOKEN
    }
    config {
        model             = "minimax-m3:cloud"
        system_prompt     = file("./agents/coordinator.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : "http://localhost:11434/v1"
        provider_wire_api = "responses"
        working_directory = var.worktree_dir
    }
}

// Runs inside the isolated worktree: all branch-scoped git/gh/coordinator ops.
adapter "shell" "sh" {
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.2"
    environment = sandbox.worktree
    secrets {
        GH_TOKEN = var.WORKFLOW_GITHUB_TOKEN
    }
}

// Runs in the repo's primary working tree: worktree lifecycle (read workstream,
// teardown) that must not depend on the per-run worktree existing.
adapter "shell" "repo" {
    source  = "ghcr.io/brokenbots/criteria-adapter-shell"
    version = "0.5.2"
    environment = sandbox.primary
    secrets {
        GH_TOKEN = var.WORKFLOW_GITHUB_TOKEN
    }
}

// Linear status updates do not receive either GitHub token.
adapter "shell" "linear" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.2"
    environment = sandbox.worktree
    secrets {
        LINEAR_API_KEY = var.LINEAR_API_KEY
    }
}
