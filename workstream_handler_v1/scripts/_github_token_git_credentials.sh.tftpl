# Shared git credential helper used by agent shell push paths.
#
# Sourcing this snippet defines setup_gh_token_git_credentials(), which
# configures git to answer HTTPS credential requests for github.com using the
# injected GH_TOKEN / GITHUB_TOKEN / WORKFLOW_GITHUB_TOKEN environment
# variable.  The token is read at runtime and is never written to disk or logs
# by this helper.
#
# Usage in a shell step:
#   setup_gh_token_git_credentials
#   git push origin "$branch"

setup_gh_token_git_credentials() {
    git config --global --replace-all credential.https://github.com.helper '!_gh_token_credential() {
        local op line token
        op="$1"
        while IFS= read -r line && [ -n "$line" ]; do :; done
        [ "$op" != "get" ] && return 0
        token="${GH_TOKEN:-${GITHUB_TOKEN:-${WORKFLOW_GITHUB_TOKEN:-}}}"
        if [ -z "$token" ]; then
            echo "missing GitHub token in environment" >&2
            return 1
        fi
        echo "username=x-access-token"
        echo "password=$token"
    }; _gh_token_credential'
}
