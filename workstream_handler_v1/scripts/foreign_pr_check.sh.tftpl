criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
{{ .gh_retry }}
set -euo pipefail

# KB-328 (2026-10-25): post-merge identity check on the stored pr_url.
#
# The branch-scan recovery (resolve_head_branch's MERGED-skip, check_pr's
# status:merged arm) only protects paths that classify the PR by BRANCH. The
# store_pr_url leg classifies by PR URL: after a squash merge deletes the
# head branch, a later run's develop lane can recreate the ticket-named
# branch, and gh's PR-per-branch lookup then resolves a DIFFERENT PR whose
# head coincidentally carries this branch name (observed live: the empty
# recreated KB-328 branch scanned onto the open dependabot #534 while the
# card's real PR #543 sat MERGED — the run adopted, reviewed, and MERGED the
# wrong PR). This script reads the stored URL's own PR (state + head branch
# name) and compares the head branch to the ticket branch this run carries:
#   * PR is MERGED (ours or not — a merged PR is never an adoption target)
#     or the PR's head branch names a DIFFERENT ticket -> emit
#     "status:foreign_pr <pr_url>" so the caller strips the poisoned pr_url
#     and re-classifies from branch state (recovering into status:merged for
#     our own PR).
#   * otherwise (open PR on our branch OR head-verification impossible) ->
#     "status:ok", the caller proceeds with the existing routing.
#
# stdout protocol:
#   status:ok
#   status:foreign_pr <url>
# Diagnostics go to stderr.

pr_url="$criteria_value_1"
ticket_branch="$criteria_value_2"

ticket_lc=$(printf '%s' "$ticket_branch" | tr '[:upper:]_' '[:lower:]-')
# Boundary-aware ticket matcher out of the pr_url path itself (CRI-27 does
# not match CRI-273; `-` is a literal outside brackets).
ticket_re=$(printf '%s' "$ticket_lc" | sed 's/[^a-z0-9-]/\\&/g')

pr_json=$(gh_retry gh pr view "$pr_url" --json state,headRefName 2>/dev/null) || pr_json=""
if [ -z "$pr_json" ]; then
    # Not resolvable (deleted-branch PRs stay resolvable via URL, so this is
    # rare) — do not guess: keep the URL, caller proceeds as before.
    echo "foreign_pr_check: pr_url '$pr_url' not resolvable; keeping it" >&2
    echo "status:ok"
    exit 0
fi

state=$(printf '%s' "$pr_json" | jq -r '.state // ""')
head_branch=$(printf '%s' "$pr_json" | jq -r '.headRefName // ""')

if [ "$state" = "MERGED" ]; then
    echo "foreign_pr_check: stored pr_url '$pr_url' points at a MERGED PR (head '$head_branch') — stripping it for branch-state re-classification" >&2
    echo "status:foreign_pr $pr_url"
    exit 0
fi

# OPEN/CLOSED PR: it must belong to THIS ticket's branch. A head branch that
# names a different ticket (lowercased/dashed, as the scan matcher does) is
# foreign; an unparseable head falls back to the ticket regex.
head_lc=$(printf '%s' "$head_branch" | tr '[:upper:]_' '[:lower:]-')
if [ -n "$head_lc" ] && ! printf '%s' "$head_lc" | grep -qE "(^|[^0-9a-z])${ticket_re}([^0-9a-z]|$)"; then
    echo "foreign_pr_check: stored pr_url '$pr_url' is a $state PR on foreign branch '$head_branch' (this ticket: $ticket_branch) — stripping it" >&2
    echo "status:foreign_pr $pr_url"
    exit 0
fi

echo "status:ok"