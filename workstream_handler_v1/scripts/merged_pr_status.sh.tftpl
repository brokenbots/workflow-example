criteria_value_1={{ .criteria_value_1 | shellquote }}
{{ .gh_retry }}
set -euo pipefail
# KB-328 (2026-10-25): merged-PR recovery. When the head branch's PR is
# already MERGED (a refire of an already-delivered card lands here: the card's
# PR went through on a prior run, the head branch was squash-deleted, and the
# fresh run finds nothing ahead of base), the run must reconcile the card at
# the standing merge gate instead of re-running development over shipped
# work — re-running it hijacked an unrelated open branch and resolved the
# wrong PR (observed live: dependabot #534 got adopted while the card's real
# PR #543 sat merged).
#
# stdout protocol (same shape check_pr emits, one extra marker line first):
#   marker=merged_recovery
#   status:merged
#   pr_number=<n> pr_url=<url> merge_sha=<oid>
# Diagnostics go to stderr. Unknown/empty PR state exits 2 = "not a merged
# PR; let the caller fall through to its normal arm" — this script never
# guesses.
branch="$criteria_value_1"

pr_json=$(gh pr view "$branch" --json number,state,url,mergeCommit 2>/dev/null) || pr_json=""
if [ -z "$pr_json" ]; then
    echo "merged_recovery: no PR resolves for branch '$branch'" >&2
    exit 2
fi

state=$(printf '%s' "$pr_json" | jq -r '.state // ""')
number=$(printf '%s' "$pr_json" | jq -r '.number // ""')
url=$(printf '%s' "$pr_json" | jq -r '.url // ""')
sha=$(printf '%s' "$pr_json" | jq -r '.mergeCommit.oid // ""')

if [ "$state" != "MERGED" ]; then
    echo "merged_recovery: branch '$branch' PR state=${state:-unknown} — not a merged-PR recovery case" >&2
    exit 2
fi

echo "merged_recovery: branch '$branch' PR #$number already MERGED (sha ${sha:-unknown}) — reconciling through the standing merge gate" >&2
echo "marker=merged_recovery"
echo "status:merged"
printf 'pr_number=%s pr_url=%s merge_sha=%s\n' "$number" "$url" "$sha"