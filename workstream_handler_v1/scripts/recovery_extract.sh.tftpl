criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .pattern | shellquote }}
set -euo pipefail
# KB-328 recovery extract: pull one field out of the merged_pr_status blob
# (criteria_value_1 = its stdout: marker/status/field lines). Shell-side
# parsing — the DSL has no regex extract.
#   pattern=url            -> stdout is exactly the PR URL (lands in pr_url)
#   pattern=merge_protocol -> stdout is merge_pr-shaped: "pr=<n>" then
#                             "merge_sha=<oid>" — the SAME protocol lines
#                             merge_pr.sh emits, so wait_merge_ci's
#                             'pr=[0-9]+' / 'merge_sha=[0-9a-fA-F]+' greps
#                             parse recovery exactly like a fresh merge.
# Unknown pattern is a template wiring error -> exit 1 loudly.
blob="$criteria_value_1"
mode="$criteria_value_2"

num=$(printf '%s\n' "$blob" | sed -n 's/^pr_number=\([0-9]*\) .*$/\1/p')
url=$(printf '%s\n' "$blob" | sed -n 's/^pr_number=[0-9]* pr_url=\([^ ]*\) merge_sha=.*$/\1/p')
sha=$(printf '%s\n' "$blob" | sed -n 's/^pr_number=.* merge_sha=\([0-9a-fA-F]\{7,\}\)$/\1/p')

case "$mode" in
    # KB-328 durable fix: fingerprint stdout carries one protocol line;
    # extract single fields for the stamping steps.
    open_url)
        u=$(printf '%s\n' "$blob" | sed -n 's/^state:open pr=[0-9]* url=\([^ ]*\)$/\1/p')
        [ -n "$u" ] || { echo "recovery_extract: no open-PR url in fingerprint: '$blob'" >&2; exit 1; }
        printf '%s' "$u"
        ;;
    merged_url)
        u=$(printf '%s\n' "$blob" | sed -n 's/^state:merged pr=[0-9]* url=\([^ ]*\) merge_sha=.*$/\1/p')
        [ -n "$u" ] || { echo "recovery_extract: no merged-PR url in fingerprint: '$blob'" >&2; exit 1; }
        printf '%s' "$u"
        ;;
    pr_number)
        n=$(printf '%s\n' "$blob" | sed -n 's/^state:\(open\|merged\|closed\) pr=\([0-9]*\) .*$/\2/p')
        [ -n "$n" ] || { echo "recovery_extract: no pr number in fingerprint: '$blob'" >&2; exit 1; }
        printf '%s' "$n"
        ;;
    url)
        if [ -z "$url" ]; then
            echo "recovery_extract: no pr_url field in the recovery blob: '$blob'" >&2
            exit 1
        fi
        printf '%s' "$url"
        ;;
    merge_protocol)
        # KB-328 durable fix: input is the delivery fingerprint's merged line
        # ('state:merged pr=<n> url=<u> merge_sha=<oid>') — emit the merge_pr
        # protocol ('pr=<n>', 'merge_sha=<oid>') so wait_merge_ci's greps
        # parse recovery exactly like a fresh merge.
        n=$(printf '%s\n' "$blob" | sed -n 's/^state:merged pr=\([0-9]*\) url=[^ ]* merge_sha=.*$/\1/p')
        s=$(printf '%s\n' "$blob" | sed -n 's/^state:merged pr=[0-9]* url=[^ ]* merge_sha=\([0-9a-fA-F]\{7,\}\)$/\1/p')
        if [ -z "$n" ] || [ -z "$s" ]; then
            echo "recovery_extract: fingerprint blob missing pr_number or merge_sha: '$blob'" >&2
            exit 1
        fi
        printf 'pr=%s\nmerge_sha=%s' "$n" "$s"
        ;;    *)
        echo "recovery_extract: unknown pattern '$mode'" >&2
        exit 1
        ;;
esac