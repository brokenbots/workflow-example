criteria_value_1={{ .criteria_value_1 | shellquote }}
workstream_file={{ .workstream_file | shellquote }}
{{ .gh_retry }}
set -euo pipefail

# KB-328 (2026-10-25): one delivery fingerprint for the card's PR, replacing
# every branch-named re-derivation (store_pr_url branch lookup, check_pr
# branch lookup, branch-scan recovery guesses, the foreign-PR patch).
#
# Invariant: a card's PR is identified by TICKET IDENTITY, never by which
# branch the worktree stands on. Scans ALL PRs (every state). Identity =
# head branch EXACTLY the ticket id ('KB-<id>', case-insensitive) OR title
# carrying the full hyphenated token 'KB-<id>' boundary-checked. Suffix
# branches ('kb-<id>-<slug>') and bare id-prefix titles ('KB <id> <slug>')
# are FOREIGN — live: castle PR #55 kb-322-caddyfile hijacked KB-322 under
# the old separator rule. CRI-27 never matches CRI-273; dependabot PRs
# cannot match by construction.
#
# Priority: OPEN > MERGED > CLOSED > none (newest-updated first in class):
# OPEN = live work, MERGED = delivered work to reconcile, CLOSED(unmerged) =
# abandoned -> fresh development.
#
# KB-355 (2026-11-05): scope-generation guard for rewritten tickets. A ticket
# rewritten in place (standing practice for stale cards) keeps its id, so any
# merged PR whose branch/title carries the id stays a PERMANENT identity match
# for every future refire — the predecessor scope's delivery false-closes the
# rewritten card for a scope that was never developed (live: castle PR #54,
# kb-322 run-viewer, merged 2026-10-24, re-closed card 322 three times after
# the P0.5 re-scope; branch-exact identity matches it too). When the workstream
# file carries a scope-generation marker stamped by triage at (re)write time —
# '<!-- scope-generation: <hash> stamped: <RFC3339Z> -->' — a MERGED candidate
# counts as current-scope delivery only when its mergedAt POSTDATES the stamp;
# a merged identity PR older than the stamp is predecessor scope and is
# suppressed (state:none -> fresh development). No marker (legacy file, no
# rewrite ever observed) keeps the pre-KB-355 behavior unchanged.
#
# Marker read (KB-355 round 2): the marker is read ONLY from the header
# region — the file content before the first level-two heading — and only the
# FIRST line there whose entire content matches the canonical marker shape.
# The workstream embeds the ticket description and comment bodies verbatim, so
# a whole-file search would let a forged marker line inside the ticket text
# arm or re-date the guard on every refire. A body copy of the marker line is
# never authoritative; no anchored match means no marker (guard off).
#
# stdout protocol (switch keyed on the first line):
#   state:none
#   state:open pr=<n> url=<url>
#   state:merged pr=<n> url=<url> merge_sha=<oid>
#   state:closed pr=<n> url=<url>
# Exit 0 on every classified shape; exit 1 only on a gh transport collapse
# past gh_retry (a fingerprint that cannot be computed must fail loudly).

# criteria_value_1 arrives as the workstream FILE (KB-<n>.md); the ticket id
# is the basename without extension. Handle a bare id too. workstream_file is
# the full source path of the same file (the scope-generation marker's carrier;
# it may be unreadable in a given run — the guard then stays off).
ticket="${criteria_value_1%.md}"
ticket="${ticket##*/}"
ticket_lc=$(printf '%s' "$ticket" | tr '[:upper:]_ ' '[:lower:]-')
ticket_re=$(printf '%s' "$ticket_lc" | sed 's/[^a-z0-9-]/\\&/g')

# KB-355: the scope-generation stamp, read from the workstream file itself.
# Anchored read (KB-355 round 2): header region only (content before the
# first level-two heading), and only the FIRST line there whose ENTIRE content
# is the canonical marker — the file embeds ticket text verbatim, so a whole
# file search would let a forged marker line in the description or comments
# arm or re-date the guard. No anchored match means no marker: guard off,
# legacy path unchanged. Only an exactly-shaped RFC3339 Z timestamp arms the
# guard — anything else (no file, no marker, malformed stamp) keeps the
# legacy ungated behavior.
scope_ts=""
if [ -n "$workstream_file" ] && [ -r "$workstream_file" ]; then
    scope_line=$(awk '/^## /{exit} {print}' "$workstream_file" 2>/dev/null \
        | grep -E -m1 '^<!-- scope-generation: [0-9a-f]{12} stamped: [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z -->$' \
        || true)
    scope_ts=$(printf '%s' "$scope_line" | sed -n 's/.*stamped: \([0-9T:-]*Z\).*/\1/p')
    case "$scope_ts" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
        *) scope_ts="" ;;
    esac
fi
if [ -n "$scope_ts" ]; then
    echo "delivery-fingerprint: scope generation stamped $scope_ts (from ${workstream_file##*/})" >&2
fi

ticket_json=$(gh_retry gh pr list --state all --limit 60 \
    --json number,state,headRefName,title,url,mergeCommit,updatedAt,mergedAt)

# TSV: state \t number \t head \t url \t sha \t updatedAt \t mergedAt
# (sorted newest-updated first; mergedAt feeds the KB-355 scope guard)
rows=$(printf '%s' "$ticket_json" | jq -r '
    .[]
    | [.state, (.number|tostring), (.headRefName // ""), (.url // ""),
      ((.mergeCommit // {}) | (.oid // "")), (.updatedAt // ""), (.mergedAt // "")]
    | @tsv' | sort -t$'\t' -k6,6r)

open_row=""
merged_row=""
closed_row=""

# Identity matchers (2026-11-04 correction of the 10-25 KB-328 shape; live evidence:
# castle PR #55 'kb-322-caddyfile' hijacked ticket KB-322's fingerprint because the old
# boundary rule treats '-' as a separator after the id):
#   branch_owner PR -> head branch is EXACTLY the ticket id (case-insensitive). The develop
#     pipeline always branches exactly KB-<id> (checkout_branch re-asserts the workstream
#     basename), so only this shape carries the identity. Suffix branches are foreign.
#   title_owner PR -> title contains the full hyphenated token KB-<id> (case-insensitive,
#     boundary-checked). A space form ('KB 322') is NOT identity: foreign PRs can carry
#     '<id> <slug>' prefixes (castle PR #55 title 'parapet: ... kb-322-caddyfile' branch).
ticket_exact_lc=$(printf '%s' "$ticket_lc")
title_token_re=$(printf '(^|[^0-9a-z])%s([^0-9a-z]|$)' "$ticket_lc")

branch_owner() {
    [ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = "$ticket_exact_lc" ]
}

title_owner() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | grep -qE "$title_token_re"
}

title_of() {
    printf '%s' "$ticket_json" | jq -r --argjson n "$1" '
        .[] | select(.number == $n) | (.title // "")' | head -1
}

# KB-355 scope-generation guard: true when mergedAt is strictly BEFORE the
# workstream's scope stamp. Both values are same-width RFC3339 Z stamps, so a
# lexical compare is chronological. An unparseable merge time never counts as
# predating (the legacy ungated classification survives data-shape drift).
is_stamp() {
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) return 0 ;;
        *) return 1 ;;
    esac
}
predates_scope() {
    [ -n "$scope_ts" ] || return 1
    is_stamp "$1" || return 1
    older=$(printf '%s\n%s\n' "$1" "$scope_ts" | LC_ALL=C sort | head -1)
    [ "$older" = "$1" ] && [ "$1" != "$scope_ts" ]
}

while IFS="$(printf '\t')" read -r st num head url sha ts ma; do
    [ -n "$st" ] || continue
    if branch_owner "$head" || title_owner "$(title_of "$num")"; then
        case "$st" in
            OPEN)   [ -n "$open_row" ]   || open_row="$num|$url" ;;
            MERGED)
                if predates_scope "$ma"; then
                    echo "delivery-fingerprint: merged PR #$num ($ma) predates the current scope generation $scope_ts — predecessor scope, suppressed" >&2
                elif [ -n "$scope_ts" ] && ! is_stamp "$ma"; then
                    # KB-355 round 2: with the guard ARMED (a well-formed scope
                    # stamp was read), current-scope delivery cannot be
                    # established without a parseable merge time — and the
                    # guard exists precisely to keep a predecessor-scope PR
                    # from closing a rewritten card, so failing toward
                    # re-development (state:none) is the intended direction.
                    # Without a stamp the legacy classification is unchanged.
                    echo "delivery-fingerprint: merged PR #$num carries no parseable merge time while the scope generation $scope_ts is armed — delivery cannot be established, suppressed" >&2
                else
                    [ -n "$merged_row" ] || { [ -n "$sha" ] && merged_row="$num|$url|$sha"; }
                fi ;;
            CLOSED) [ -n "$closed_row" ] || closed_row="$num|$url" ;;
        esac
    fi
done <<EOF2
$rows
EOF2

if [ -n "$open_row" ]; then
    num="${open_row%%|*}"; url="${open_row#*|}"
    echo "delivery-fingerprint: OPEN PR #$num on the ticket identity" >&2
    printf 'state:open pr=%s url=%s\n' "$num" "$url"
    exit 0
fi
if [ -n "$merged_row" ]; then
    num="${merged_row%%|*}"; rest="${merged_row#*|}"; url="${rest%%|*}"; sha="${rest#*|}"
    echo "delivery-fingerprint: PR #$num already MERGED (sha ${sha}) — delivery on the mainline" >&2
    printf 'state:merged pr=%s url=%s merge_sha=%s\n' "$num" "$url" "$sha"
    exit 0
fi
if [ -n "$closed_row" ]; then
    num="${closed_row%%|*}"; url="${closed_row#*|}"
    echo "delivery-fingerprint: only a CLOSED (unmerged) PR #$num exists — fresh development recovers" >&2
    printf 'state:closed pr=%s url=%s\n' "$num" "$url"
    exit 0
fi
echo "delivery-fingerprint: no PR carries the ticket identity" >&2
printf 'state:none\n' 