criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
set -uo pipefail; exec 2>&1
wt="$criteria_value_1"
branch="$criteria_value_2"
git worktree remove --force "$wt" 2>&1 || true
git worktree prune 2>&1 || true
echo "removed worktree $wt"

# Delete the local branch, but only once its PR is actually merged.
# The PR state is the authority, not git: PRs here are squash-merged,
# which leaves the branch's own commits outside main's history, so
# `git branch -d` refuses and `git branch --merged` cannot see them.
# Without this, every run leaves a branch behind forever — 16 had
# accumulated before it was noticed.
#
# -D is safe *only* because the MERGED check gates it. Never move
# this deletion outside that guard.
if [ -n "$branch" ]; then
    state=$(gh pr view "$branch" --json state --jq .state 2>/dev/null || echo "")
    if [ "$state" = "MERGED" ]; then
        git branch -D "$branch" 2>&1 || true
        echo "deleted merged branch $branch"
    else
        echo "kept branch $branch (PR state: ${state:-unknown}) — not merged, nothing discarded"
    fi
fi
git fetch --prune --quiet 2>&1 || true
