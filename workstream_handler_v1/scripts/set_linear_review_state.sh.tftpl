criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
set -euo pipefail
: "${LINEAR_API_KEY:?LINEAR_API_KEY is not set}"

ticket=$(curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'query($id: String!) { issue(id: $id) { id team { id } } }' \
        --arg id "$criteria_value_1" \
        '{query: $q, variables: {id: $id}}')" \
    https://api.linear.app/graphql)

issue_id=$(printf '%s' "$ticket" | jq -er '.data.issue.id')
team_id=$(printf '%s' "$ticket" | jq -er '.data.issue.team.id')
states=$(curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'query($team: ID!, $name: String!) { workflowStates(filter: {team: {id: {eq: $team}}, name: {eq: $name}}) { nodes { id } } }' \
        --arg team "$team_id" \
        --arg name "$criteria_value_2" \
        '{query: $q, variables: {team: $team, name: $name}}')" \
    https://api.linear.app/graphql)

state_id=$(printf '%s' "$states" | jq -er '.data.workflowStates.nodes[0].id')
curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'mutation($id: String!, $state: String!) { issueUpdate(id: $id, input: {stateId: $state}) { success } }' \
        --arg id "$issue_id" \
        --arg state "$state_id" \
        '{query: $q, variables: {id: $id, state: $state}}')" \
    https://api.linear.app/graphql \
    | jq -e '.data.issueUpdate.success == true' >/dev/null