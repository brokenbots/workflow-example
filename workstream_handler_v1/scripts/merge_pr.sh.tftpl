criteria_value_1={{ .criteria_value_1 | shellquote }}
set -uo pipefail
pr=$(printf '%s' "$criteria_value_1" | grep -oE 'pull/[0-9]+' | cut -d/ -f2 | tail -1 | tr -d '\n')
owner=$(gh repo view --json owner --jq '.owner.login' 2>/dev/null || echo "")
repo=$(gh repo view --json name --jq '.name' 2>/dev/null || echo "")

if [ -z "$pr" ]; then
    echo "merge_failed=true pr=<missing>"
    echo "merge_error=could not parse pull request number from $criteria_value_1"
    exit 1
fi

# Capture stderr rather than discarding it: a merge can be refused for
# reasons the operator cannot guess from an exit code alone (branch
# protection, unresolved conversations, stale approval). Swallowing it
# turns a precise GitHub error into a bare "merge_failed".
merge_rc=0
merge_err=$(gh pr merge "$pr" --squash --delete-branch 2>&1) || merge_rc=$?

if [ "$merge_rc" -eq 0 ]; then
    echo "merged=true pr=$pr"
    exit 0
fi

# gh may return non-zero even after the merge succeeds (branch deletion race, etc.)
# Treat as success if GitHub says the PR is already merged.
state=$(gh pr view "$pr" --json state --jq '.state' 2>/dev/null || echo "")
if [ "$state" = "MERGED" ]; then
    echo "already_merged=true pr=$pr"
    exit 0
fi

echo "merge_failed=true pr=$pr"
echo "merge_error=$merge_err"

# Report the mergeability facts the error alone may not name, so the
# coordinator can act without a human reproducing the merge by hand.
gh pr view "$pr" --json mergeStateStatus,mergeable,reviewDecision \
    --jq '"merge_state=\(.mergeStateStatus) mergeable=\(.mergeable) review_decision=\(.reviewDecision)"' 2>&1 || true

# A blocked merge with green review is often a CI failure the status rollup
# misses (e.g. an invalid workflow file that prevents required checks from ever
# registering — observed in CRI-93). Detect a failed Actions run for this
# branch and name it, so the coordinator can route it to the developer as
# actionable feedback instead of finding no_work and spinning.
branch_name=$(gh pr view "$pr" --json headRefName --jq '.headRefName' 2>/dev/null || echo "")
if [ -n "$branch_name" ]; then
    failed_wf=$(gh api "repos/$owner/$repo/actions/runs?branch=$branch_name&per_page=10" \
        --jq '[.workflow_runs[] | select(.conclusion == "failure")] | .[0] | "\(.name) (\(.event))"' 2>/dev/null || echo "")
    if [ -n "$failed_wf" ] && [ "$failed_wf" != "null" ]; then
        echo "ci_workflow_failed=true"
        echo "failed_workflow=$failed_wf"
        echo "ci_detail=a GitHub Actions workflow run failed for branch $branch_name; if it failed at workflow-file validation, no required checks ran and the merge stays blocked until the workflow file is fixed"
    fi
fi

unresolved=$(gh api graphql \
        -f query='query($owner: String!, $repo: String!, $pr: Int!) {
            repository(owner: $owner, name: $repo) {
                pullRequest(number: $pr) {
                    reviewThreads(first: 50) { nodes { isResolved } }
                }
            }
        }' \
        -F owner="$owner" \
        -F repo="$repo" \
        -F pr="$pr" \
    --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo "unknown")
echo "unresolved_threads=$unresolved"
exit 1
