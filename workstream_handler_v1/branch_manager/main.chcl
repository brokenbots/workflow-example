workflow {
    name          = "branch_manager"
    version       = "1"
    initial_state = "resolve_branch"
    target_state  = "done"

    policy {
        max_total_steps = 60
    }
}

// Internal resolved branch name, prefixed to avoid conflict with var.branch.
data "internal" "_branch" {
    type  = string
    value = ""
}

// Error output from whichever shell step failed, passed verbatim to the agent.
data "internal" "triage_context" {
    type  = string
    value = ""
}

// Set to "ok" only on the success path; empty on failure.
// Workaround for engine bug: subworkflow success=false is ignored by parent.
data "internal" "status" {
    type  = string
    value = ""
}

// Human-readable note describing any uncommitted work that was stashed to allow
// a rebase and then restored to the working tree. Reported up to the parent so
// the developer can be informed. Empty when nothing was stashed.
data "internal" "stash_report" {
    type  = string
    value = ""
}

// ── Branch name resolution ────────────────────────────────────────────────────

step "resolve_branch" {
    target = adapter.shell.repo
    input {
        command = <<-SHELL
            set -euo pipefail
            if [ -n '${var.branch}' ]; then
                printf '%s' '${var.branch}'
            else
                printf '%s' "$(basename '${var.workstream_file}' .md)"
            fi
        SHELL
    }
    outcome "success" {
        next = step.setup_worktree
        write {
            target = data.internal._branch.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// ── Isolated worktree setup ───────────────────────────────────────────────────
//
// Creates (or reuses) a dedicated git worktree for this run so the workstream
// never touches the operator's main checkout. Runs in the repo's primary tree
// (adapter.shell.repo) because the per-run worktree does not exist yet. All
// subsequent branch-scoped steps run inside the worktree (adapter.shell.sh,
// working_directory = var.worktree_dir).
//
// Branch resolution is folded in here: attach an existing local/remote branch,
// or create a new one off origin/base. A failure here means the worktree does
// not exist, so it routes to needs_human rather than the worktree-pinned triage
// agent.

step "setup_worktree" {
    target  = adapter.shell.repo
    timeout = "60s"
    input {
        command = <<-SHELL
            set -euo pipefail; exec 2>&1
            branch='${data.internal._branch.value}'
            base='${var.base_branch}'
            wt='${var.worktree_dir}'
            echo "branch=$branch base=$base worktree=$wt"

            git fetch origin 2>&1 || true
            git worktree prune 2>&1 || true

            # Reuse a worktree already present at this path (resume case). Detect by
            # asking git directly rather than string-matching paths, which differ
            # under symlinks (e.g. /tmp vs /private/tmp on macOS).
            if [ -d "$wt" ]; then
                if git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                    echo "reusing existing worktree at $wt (on '$(git -C "$wt" branch --show-current)')"
                    exit 0
                fi
                echo "path $wt exists but is not a git worktree"
                exit 1
            fi

            if git show-ref --verify --quiet "refs/heads/$branch"; then
                git worktree add --force "$wt" "$branch"
            elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
                git worktree add --force -b "$branch" "$wt" "origin/$branch"
            elif git show-ref --verify --quiet "refs/remotes/origin/$base"; then
                git worktree add --force -b "$branch" "$wt" "origin/$base"
            else
                echo "base_branch_remote_not_found=true using local base as-is"
                git worktree add --force -b "$branch" "$wt" "$base"
            fi

            # If the worktree lives inside the repo, keep it out of the operator's
            # git status via the repo-local exclude (no tracked-file changes).
            # Canonicalize both paths so the prefix test survives symlinks
            # (e.g. /tmp vs /private/tmp on macOS).
            top=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
            top_real=$(cd "$top" 2>/dev/null && pwd -P || echo "$top")
            wt_real=$(cd "$wt" 2>/dev/null && pwd -P || echo "$wt")
            case "$wt_real" in
                "$top_real"/*)
                    rel="$${wt_real#$top_real/}"
                    excl=$(git rev-parse --git-path info/exclude)
                    grep -qxF "/$rel" "$excl" 2>/dev/null || printf '/%s\n' "$rel" >> "$excl"
                    ;;
            esac
            echo "worktree_ready=$wt on_branch=$branch"
        SHELL
    }
    outcome "success" { next = step.validate_base_branch }
    outcome "failure" {
        next = state.needs_human
        write {
            target = data.internal.triage_context.value
            value  = output.stdout
        }
    }
}

// ── Base branch validation ────────────────────────────────────────────────────
//
// Finds the oldest commit on the feature branch not on base_branch, then
// confirms its parent is an ancestor of base_branch.  An empty unique-commit
// set (branch is even with base) is also valid.
//
//   exit 0 — base branch is correct (or branch has no unique commits)
//   exit 1 — base branch mismatch

step "validate_base_branch" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail; exec 2>&1
            branch='${data.internal._branch.value}'
            base='${var.base_branch}'
            echo "branch=$branch base=$base"

            unique=$(git log --format='%H' "origin/$base..$branch" 2>/dev/null \
                     || git log --format='%H' "$base..$branch")

            if [ -z "$unique" ]; then
                echo "base_ok=true no_unique_commits"
                exit 0
            fi

            oldest=$(printf '%s' "$unique" | tail -1)
            parent=$(git rev-parse "$${oldest}^" 2>/dev/null || git rev-parse "$oldest")
            echo "oldest_unique_commit=$oldest"
            echo "fork_point=$parent"

            if git merge-base --is-ancestor "$parent" "$base" 2>/dev/null; then
                echo "base_ok=true"
                exit 0
            fi

            echo "base_mismatch=true expected=$base"
            exit 1
        SHELL
    }
    outcome "success" { next = switch.route_base_validation }
    outcome "failure" { next = switch.route_base_validation }
}

switch "route_base_validation" {
    match {
        condition = steps.validate_base_branch.exit_code == "0"
        next      = step.check_rebase_needed
    }
    default {
        next = step.rebase_onto_base
    }
}

// ── Rebase-needed check ───────────────────────────────────────────────────────
//
//   exit 0 — branch is current, no rebase required
//   exit 1 — base has advanced, rebase needed

step "check_rebase_needed" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail
            branch='${data.internal._branch.value}'
            base='${var.base_branch}'
            behind=$(git rev-list --count "$branch..origin/$base" 2>/dev/null || echo "0")
            echo "commits_behind=$behind"
            if [ "$behind" -gt 0 ]; then
                exit 1
            fi
            exit 0
        SHELL
    }
    outcome "success" { next = switch.route_rebase_needed }
    outcome "failure" { next = switch.route_rebase_needed }
}

switch "route_rebase_needed" {
    match {
        condition = steps.check_rebase_needed.exit_code == "0"
        next      = step.checkout_branch
    }
    default {
        next = step.rebase_branch
    }
}

// ── Rebase: bring branch current with base ────────────────────────────────────

step "rebase_branch" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail; exec 2>&1
            branch='${data.internal._branch.value}'
            base='${var.base_branch}'
            # Already on $branch inside the isolated worktree — no checkout needed.
            # Stash any uncommitted work (incl. untracked) so the rebase can run
            # on a clean tree; restore_stash pops it back onto the rebased branch.
            if [ -n "$(git status --porcelain)" ]; then
                git stash push -u -m criteria-branch-manager-wip
                echo "stashed uncommitted changes before rebase"
            fi
            echo "rebasing $branch onto origin/$base..."
            git rebase "origin/$base"
        SHELL
    }
    timeout = "60s"
    outcome "success" { next = step.restore_stash }
    outcome "failure" {
        next = step.skip_merged_rebase_commits
        write {
            target = data.internal.triage_context.value
            value  = output.stdout
        }
    }
}

// ── Skip already-merged commits blocking a rebase ─────────────────────────────
//
// When rebase_branch fails, the branch may be stalled on commits that were
// already squash-merged into origin/base. Such commits are ancestors of
// origin/base by SHA — git rebase --skip removes them cleanly.
//
// Loop: after each skip git may pause on the next commit; keep skipping as long
// as the failing commit is an ancestor of origin/base. Exit 0 when the rebase
// completes. Exit 1 (genuine conflict, rebase aborted) routes to the AI agent.

step "skip_merged_rebase_commits" {
    target  = adapter.shell.sh
    timeout = "60s"
    input {
        command = <<-SHELL
            exec 2>&1
            set -u
            base='${var.base_branch}'
            # Resolve rebase-state dirs via git: in a linked worktree they live under
            # the per-worktree gitdir, not a literal .git/ in the working tree.
            rm=$(git rev-parse --git-path rebase-merge)
            ra=$(git rev-parse --git-path rebase-apply)
            MAX_SKIPS=20
            skips=0
            while [ "$skips" -lt "$MAX_SKIPS" ]; do
                if [ ! -d "$rm" ] && [ ! -d "$ra" ]; then
                    echo "status=completed skips=$skips"
                    exit 0
                fi
                rebase_head=""
                if [ -f "$rm/stopped-sha" ]; then
                    rebase_head=$(cat "$rm/stopped-sha")
                elif [ -f "$ra/original-commit" ]; then
                    rebase_head=$(cat "$ra/original-commit")
                fi
                if [ -z "$rebase_head" ]; then
                    echo "status=error cannot identify stalled commit"
                    exit 1
                fi
                msg=$(git log --format='%s' -1 "$rebase_head" 2>/dev/null || echo unknown)
                echo "rebase stalled at: $rebase_head ($msg)"
                if git merge-base --is-ancestor "$rebase_head" "origin/$base" 2>/dev/null; then
                    echo "commit already in origin/$base — skipping"
                    prev="$rebase_head"
                    git rebase --skip 2>&1 || true
                    skips=$((skips + 1))
                    # Safety: if we're still on the same commit the skip had no effect
                    if [ -f "$rm/stopped-sha" ] && \
                       [ "$(cat "$rm/stopped-sha")" = "$prev" ]; then
                        echo "status=error skip had no effect on $prev"
                        git rebase --abort 2>/dev/null || true
                        exit 1
                    fi
                else
                    echo "status=genuine_conflict commit $rebase_head not in origin/$base"
                    git rebase --abort 2>/dev/null || true
                    exit 1
                fi
            done
            echo "status=error exceeded max skips ($MAX_SKIPS)"
            git rebase --abort 2>/dev/null || true
            exit 1
        SHELL
    }
    outcome "success" { next = step.restore_stash }
    outcome "failure" {
        next = step.branch_triage_agent
        write {
            target = data.internal.triage_context.value
            value  = output.stdout
        }
    }
}

// ── Rebase: correct a wrong base branch ──────────────────────────────────────

step "rebase_onto_base" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail; exec 2>&1
            branch='${data.internal._branch.value}'
            base='${var.base_branch}'
            # Already on $branch inside the isolated worktree — no checkout needed.
            # Stash uncommitted work so the rebase can run; restore_stash pops it back.
            if [ -n "$(git status --porcelain)" ]; then
                git stash push -u -m criteria-branch-manager-wip
                echo "stashed uncommitted changes before rebase"
            fi
            fork_point=$(git merge-base HEAD "origin/$base")
            echo "rebase --onto origin/$base from fork_point=$fork_point"
            git rebase --onto "origin/$base" "$fork_point"
        SHELL
    }
    timeout = "60s"
    outcome "success" { next = step.restore_stash }
    outcome "failure" {
        next = step.branch_triage_agent
        write {
            target = data.internal.triage_context.value
            value  = output.stdout
        }
    }
}

// ── Fast-forward to remote ────────────────────────────────────────────────────
//
// No rebase was needed; the worktree is already on $branch. Fast-forward to any
// new commits on origin/$branch (no-op for a brand-new branch).

step "checkout_branch" {
    target = adapter.shell.sh
    input {
        command = <<-SHELL
            set -euo pipefail; exec 2>&1
            branch='${data.internal._branch.value}'
            git pull --ff-only origin "$branch" 2>/dev/null || true
            echo "on_branch=$(git branch --show-current)"
        SHELL
    }
    timeout = "15s"
    outcome "success" { next = step.mark_done }
    outcome "failure" {
        next = step.branch_triage_agent
        write {
            target = data.internal.triage_context.value
            value  = output.stdout
        }
    }
}

// ── Branch triage agent ───────────────────────────────────────────────────────
//
// Called when any shell step fails.  The agent diagnoses the situation and
// performs only mechanical git operations to restore the branch to the happy
// path.  It does NOT make code changes or do any development work.

step "branch_triage_agent" {
    target      = adapter.copilot.branch_repair
    allow_tools = ["*"]
    max_visits  = 3

    input {
        prompt = <<-EOT
            Automated branch management for '${data.internal._branch.value}' (base: '${var.base_branch}') failed.

            --- failure output ---
            ${data.internal.triage_context.value}
            --- end ---

            Note: already-merged commits (those whose SHA is an ancestor of origin/${var.base_branch})
            were automatically skipped before reaching you. Any remaining conflict is a genuine
            code conflict requiring conflict-marker resolution or human judgment.

            Note: any uncommitted work was stashed before the rebase as
            'criteria-branch-manager-wip'. If that stash is still present
            (git stash list), pop it back into the working tree once the rebase
            is settled so the developer's work is not lost.

            Your goal: get the repository into this exact state:
              1. Checked out on branch '${data.internal._branch.value}'
              2. Branch is rebased on origin/'${var.base_branch}'
              3. Any 'criteria-branch-manager-wip' stash popped back into the tree
                 (resolve pop conflicts by keeping both the rebased and stashed work)

            Allowed operations:
              - Inspect: git status, git log, git diff, git show, git stash list
              - Preserve work: git stash, git stash pop
              - Navigate: git checkout '${data.internal._branch.value}', git fetch origin
              - Rebase: git rebase origin/'${var.base_branch}', git rebase --continue, git rebase --abort
              - Resolve conflicts: git add <file> (conflict markers only — do not change logic)
              - Discard noise: git restore <file> (only for files you did not write)

            NOT allowed:
              - Editing file content for any reason other than removing conflict markers
              - git commit (except automatic rebase continuation)
              - git push
              - git checkout -b or git branch (creating/deleting branches)
              - Any action that changes what the code does

            Call submit_outcome with one of:
              "success"      — goal state achieved
              "needs_human"  — resolution requires code judgment, domain knowledge, or intent that only the developer can provide
              "failed"       — git state is corrupt or the abort itself failed
        EOT
    }

    outcome "success"     { next = step.mark_done }
    outcome "needs_human" { next = state.needs_human }
    outcome "failed"      { next = state.failed }
    // "failure" is the copilot adapter's built-in outcome when the provider is
    // unreachable or the session crashes — treat it as needs_human since the
    // branch is in an unresolved state that requires manual intervention.
    outcome "failure"     { next = state.needs_human }
    outcome "default"     { next = state.needs_human }
}

// ── Restore stashed work ──────────────────────────────────────────────────────
//
// After a successful rebase, pop the WIP stashed by the rebase step back onto
// the branch so the developer's uncommitted work is preserved in the tree.
// Captures a report of what was restored for the parent to surface.
//
//   exit 0 — stash popped cleanly (or nothing was stashed)
//   exit 1 — stash pop conflicted; needs resolution

step "restore_stash" {
    target  = adapter.shell.sh
    timeout = "30s"
    input {
        command = <<-SHELL
            set -uo pipefail; exec 2>&1
            if git stash list | head -1 | grep -q 'criteria-branch-manager-wip'; then
                if git stash pop >/dev/null 2>&1; then
                    printf 'Note: uncommitted work was present before the rebase. It was stashed to allow the rebase and has been restored to the working tree — the changes listed below include that restored work.'
                else
                    echo "stash_pop_conflict=true: the rebase succeeded but restoring the pre-rebase work hit a conflict; manual resolution required"
                    git status --porcelain
                    exit 1
                fi
            fi
        SHELL
    }
    outcome "success" {
        next = step.mark_done
        write {
            target = data.internal.stash_report.value
            value  = output.stdout
        }
    }
    outcome "failure" {
        next = step.branch_triage_agent
        write {
            target = data.internal.triage_context.value
            value  = output.stdout
        }
    }
}

// ── Mark success ──────────────────────────────────────────────────────────────

// All success paths funnel here to stamp status="ok" before terminating.
// Required because the engine ignores subworkflow success=false at the parent.

step "mark_done" {
    target = adapter.noop.default
    input  {}
    outcome "success" {
        next = step.finish
        write {
            target = data.internal.status.value
            value  = "ok"
        }
    }
    outcome "failure" { next = step.finish }
}

step "finish" {
    target = adapter.noop.default
    input  {}
    outcome "success" { next = state.done }
    outcome "failure" { next = state.done }
}

// ── Terminal states ───────────────────────────────────────────────────────────

state "done" {
    terminal = true
    success  = true
}

state "needs_human" {
    terminal = true
    success  = false
}

state "failed" {
    terminal = true
    success  = false
}

output "branch" {
    type  = string
    value = data.internal._branch.value
}

output "base_branch" {
    type  = string
    value = var.base_branch
}

output "status" {
    type  = string
    value = data.internal.status.value
}

output "stash_report" {
    type  = string
    value = data.internal.stash_report.value
}
