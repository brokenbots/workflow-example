criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
set -euo pipefail
branch="$criteria_value_1"
base="$criteria_value_2"
behind=$(git rev-list --count "$branch..origin/$base" 2>/dev/null || echo "0")
echo "commits_behind=$behind"
if [ "$behind" -gt 0 ]; then
    exit 1
fi
exit 0
