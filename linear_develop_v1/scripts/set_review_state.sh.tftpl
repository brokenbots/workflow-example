criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
set -euo pipefail
: "${LINEAR_API_KEY:?LINEAR_API_KEY is not set -- export it before criteria apply}"
run_dir="$criteria_value_1/$criteria_value_2"
issue_id=$(jq -r '.data.issue.id' "$run_dir/ticket.json")
team_id=$(jq -r '.data.issue.team.id' "$run_dir/ticket.json")

states=$(curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'query($team: ID!, $name: String!) { workflowStates(filter: {team: {id: {eq: $team}}, name: {eq: $name}}) { nodes { id } } }' \
        --arg team "$team_id" \
        --arg name "$criteria_value_3" \
        '{query: $q, variables: {team: $team, name: $name}}')" \
    https://api.linear.app/graphql)
[ -n "$states" ] || { echo "linear rpc transport: workflowStates (empty response)" >&2; exit 1; }
printf '%s' "$states" | jq -e '(type == "object") and (has("data") or has("errors"))' >/dev/null \
    || { echo "linear rpc transport: workflowStates (non-JSON-RPC body)" >&2; printf '%s\n' "$states" >&2; exit 1; }
if printf '%s' "$states" | jq -e 'has("errors")' >/dev/null; then
    echo "linear rpc error: workflowStates: $(printf '%s' "$states" | jq -r '[.errors[]?.message] // [] | join("; ")')" >&2
    exit 1
fi

state_id=$(printf '%s' "$states" | jq -r '.data.workflowStates.nodes[0].id // empty')
if [ -z "$state_id" ]; then
    echo "Linear state '$criteria_value_3' not found on the ticket's team" >&2
    exit 1
fi

resp=$(curl -sS -f \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
        --arg q 'mutation($id: String!, $state: String!) { issueUpdate(id: $id, input: {stateId: $state}) { success } }' \
        --arg id "$issue_id" \
        --arg state "$state_id" \
        '{query: $q, variables: {id: $id, state: $state}}')" \
    https://api.linear.app/graphql) || {
    echo "linear rpc transport: issueUpdate" >&2
    exit 1
}
[ -n "$resp" ] || { echo "linear rpc transport: issueUpdate (empty response)" >&2; exit 1; }
printf '%s' "$resp" | jq -e '(type == "object") and (has("data") or has("errors"))' >/dev/null \
    || { echo "linear rpc transport: issueUpdate (non-JSON-RPC body)" >&2; printf '%s\n' "$resp" >&2; exit 1; }
if printf '%s' "$resp" | jq -e 'has("errors")' >/dev/null; then
    echo "linear rpc error: issueUpdate: $(printf '%s' "$resp" | jq -r '[.errors[]?.message] // [] | join("; ")')" >&2
    exit 1
fi
if ! printf '%s' "$resp" | jq -e '.data.issueUpdate.success == true' >/dev/null; then
    echo "linear rpc error: issueUpdate (success=false)" >&2
    exit 1
fi

echo "ticket moved to $criteria_value_3"
