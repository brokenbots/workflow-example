variable "ticket_id" {
    description = "Linear ticket identifier to process (e.g. \"CRI-32\"). Doubles as the run's slug: every artifact lives under <intake_root>/<ticket_id>/. The workflow assumes the ticket is triaged — fired on a Ready-for-Development ticket whose comments carry the triage outputs."
    type        = string
}

variable "provider_base_url" {
    description = "Optional provider base URL override for every agent in the composed workflow. Empty preserves each agent's configured URL."
    type        = string
    default     = ""
}

// Defaults to "" rather than being required: it is referenced from adapter
// config, which must be resolvable at compile time. A required variable leaves
// it unknown and the compile fails. Always pass it at apply time.
variable "repo_dir" {
    description = "Absolute path of the repository's primary working tree. Passed through to workstream_handler_v1, which runs all repo operations itself. Empty runs in the process working directory."
    type        = string
    default     = ""
}

// Deliberately OUTSIDE the repository under test, same discipline as
// qa_triage_v1's triage_root: development artifacts (ticket JSON, confirmed
// workstream, handler worktree) must never land in the repo's working tree.
// Same default as linear_intake_v1 and linear_triage_v1, so a workstream the
// triage phase published under this root is found and reused as-is.
variable "intake_root" {
    description = "Absolute path under which per-ticket working directories live (<intake_root>/<ticket_id>/). Must be OUTSIDE the repository under test, and under $HOME or CRITERIA_SHELL_ALLOWED_PATHS. Shared with the triage workflow's default so its published workstream is reused."
    type        = string
    default     = "/tmp/criteria-intake"
}

variable "linear_review_state" {
    description = "Name of the Linear workflow state the ticket is moved to whenever the run ends awaiting a human: the reviewer loop could not conclude, a Linear write failed, or the confirmed workstream could not be produced. Also passed to the handler, which moves the ticket here before every PR review. Resolved by name against the ticket's team (must exist there — e.g. Linear's default \"In Review\", or a custom state like \"Human Review\"); an unknown name fails the run loudly."
    type        = string
    default     = "In Review"
}

variable "linear_work_state" {
    description = "Name of the Linear workflow state set immediately before implementation begins. Resolved against the ticket's team."
    type        = string
    default     = "In Progress"
}

variable "linear_done_state" {
    description = "Name of the Linear workflow state set after the implementation PR has merged. Resolved against the ticket's team; an unknown name fails the step loudly and routes the run to the review state with the merge already recorded in a comment."
    type        = string
    default     = "Done"
}

// ── workstream_handler_v1 pass-throughs ──────────────────────────────────────

variable "base_branch" {
    description = "workstream_handler_v1: base branch to fork from and validate against."
    type        = string
    default     = "main"
}

variable "ci_gate_cmd" {
    description = "workstream_handler_v1: command the pair programming loop runs as its CI gate (exit 0 = clean). Empty skips the gate. Set it to mirror what the remote CI actually runs (e.g. 'make ci && make vuln-scan')."
    type        = string
    default     = ""
}

variable "allow_dirty" {
    description = "workstream_handler_v1: allow the pair programming loop to run even if the working tree has uncommitted changes."
    type        = bool
    default     = false
}

variable "linear_api_key" {
    type   = string
    secret = true
}

variable "workflow_github_token" {
    type   = string
    secret = true
}

// GitHub token for the reviewer identity. Kept separate from
// workflow_github_token so the handler's PR review/merge runs under a
// different identity than the PR author — the external "independent approval"
// gate is meaningless if both resolve to the same user (the entrypoint already
// rejects that). Threaded into workstream_handler_v1 as reviewer_github_token.
variable "reviewer_github_token" {
    type   = string
    secret = true
}