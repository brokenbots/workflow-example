// repro_scope_teardown_v1/work — the twice-entered subworkflow. Declares ONLY
// the agent adapter; the shell steps ride the PARENT's shell.comp (re-declared
// borrow) — mirroring the production shape where shell.sh was provisioned by
// the parent scope, REUSED by both pair-loop entries, while the copilot pair
// went through fresh per-entry provision/teardown cycles. The fatal entry's
// fresh copilot provision against the still-live pod is the target.

variable "workflow_github_token" {
    description = "Copilot adapter's GitHub token over the secret channel (copilot >= 0.5.2)."
    type        = string
    secret      = true
}

environment "remote" "probe_env" {
    // SAME environment composition as the parent's root env: the production
    // race ran inside ONE remote environment shared across scopes.
    per_scope_sessions = true
    working_directory  = "/data"
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "CRITERIA_REMOTE_TOKEN_PLACEHOLDER"
    accept_digest_from = "lockfile"
}

// The agent probe: a real copilot session is what died mid-handshake in the
// production run, so the repro must provision a REAL copilot per scope.
adapter "copilot" "agent" {
    source      = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version     = "0.5.15"
    environment = remote.probe_env
    secrets {
        GITHUB_TOKEN = var.workflow_github_token
    }
    config {
        model             = "minimax-m3:cloud"
        max_turns         = "2"
        system_prompt     = "You are a workflow probe. Submit exactly one outcome: success with reason 'probe ok'. Never use tools."
        provider_base_url = "http://192.168.17.116:11434/v1"
        provider_wire_api = "responses"
        working_directory = "/data"
    }
}

// Re-declaration borrow of the parent's shell adapter: same type + name +
// environment so the engine routes the child's shell steps through the
// parent's live session (CRI-145 re-declared-adapter shape; the child never
// provisions or releases it — the borrow ride).
adapter "shell" "comp" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.4"
    environment = remote.probe_env
}