variable "ticket_id" {
    description = "Linear ticket identifier to process (e.g. \"CRI-32\"). Doubles as the run's slug: every artifact lives under <intake_root>/<ticket_id>/ and <triage_root>/<ticket_id>/."
    type        = string
}

variable "max_agent_visits" {
    description = "Maximum attempts for the QA-review agent gate."
    type        = number
    default     = 2
}

variable "provider_base_url" {
    description = "Optional provider base URL override for every agent in the composed workflow. Empty preserves each agent's configured URL."
    type        = string
    default     = ""
}

// Defaults to "" rather than being required: it is referenced from adapter
// config, which must be resolvable at compile time. A required variable leaves
// it unknown and the compile fails. Always pass it at apply time.
variable "repo_dir" {
    description = "Absolute path of the repository's primary working tree. Passed through to qa_triage_v1, which runs all repo operations itself. Empty runs in the process working directory."
    type        = string
    default     = ""
}

// Deliberately OUTSIDE the repository under test, same discipline as
// qa_triage_v1's triage_root: triage artifacts (ticket JSON, rendered bug
// report, confirmed workstream, review notes) must never land in the repo's
// working tree.
variable "intake_root" {
    description = "Absolute path under which per-ticket working directories are created (<intake_root>/<ticket_id>/). Must be OUTSIDE the repository under test, and under $HOME or CRITERIA_SHELL_ALLOWED_PATHS."
    type        = string
    default     = "/tmp/criteria-intake"
}

variable "linear_review_state" {
    description = "Name of the Linear workflow state the ticket is moved to whenever the run ends awaiting a human: unusable ticket, invalid finding, ambiguous triage, or a crashed/failed subworkflow. Resolved by name against the ticket's team (must exist there — e.g. Linear's default \"In Review\", or a custom state like \"Human Review\"); an unknown name fails the run loudly."
    type        = string
    default     = "In Review"
}

// The Ready-for-Development terminal of this workflow (CRI-238): set when the
// finding is confirmed — the internal-reproduced bypass, or a QA verdict the
// reviewer routed as valid with a published workstream. Reuses the same
// set_review_state script as the review move, so resolution semantics are
// identical: resolved by name against the ticket's team, unknown name fails
// loudly.
variable "linear_ready_state" {
    description = "Name of the Linear workflow state set when the triage finding is confirmed and the ticket is ready for development. Resolved by name against the ticket's team; an unknown name fails the step loudly and routes the run to the review state."
    type        = string
    default     = "Ready for Development"
}

variable "linear_bug_label" {
    description = "Linear label applied when the internal-reproduced bypass confirms the ticket as a bug. When absent from the team, the conflicting feature label is removed and routing continues."
    type        = string
    default     = "Bug"
}

// The development route's arming label (CRI-240): the watcher's trigger label
// (k8s-run) gates every k8s run, so a confirmed finding must carry it when the
// ticket lands in the ready state or the development workflow never fires.
// Re-attached on the ready_for_development terminal path only — the In Review
// path stays manual, the human is the signal. Written as a merge over the
// ticket's current labels; resolved by name against the ticket's team, an
// unknown name fails the step loudly and routes the run to the review state.
variable "linear_run_label" {
    description = "Linear label re-attached when the triage finding is confirmed, arming the development route (the watcher's trigger label). Written as a merge — the ticket's existing labels are preserved. Resolved by name against the ticket's team; an unknown name fails the step loudly and routes the run to the review state."
    type        = string
    default     = "k8s-run"
}

variable "linear_feature_label" {
    description = "Linear label removed when the bug label is applied, so the ticket never carries a conflicting classification."
    type        = string
    default     = "Feature"
}

// ── qa_triage_v1 pass-throughs ───────────────────────────────────────────────
// Kept in sync with qa_triage_v1/variables.chcl. See that file for the full
// rationale on each.

variable "triage_root" {
    description = "qa_triage_v1: root for triage worktrees and the evidence directory. Must be OUTSIDE the repository under test."
    type        = string
    default     = "/tmp/criteria-triage"
}

variable "design_intent_file" {
    description = "qa_triage_v1: optional absolute path to a markdown file recording deliberate design decisions not documented in the repository. Consulted by the verdict gate. Empty means no such file."
    type        = string
    default     = ""
}

variable "repro_workflow_dir" {
    description = "qa_triage_v1: optional absolute path to a reproduction workflow supplied with the bug report, executed first and unmodified against every ref under test. Empty means the investigator constructs a reproduction from the report alone."
    type        = string
    default     = ""
}

variable "test_refs" {
    description = "qa_triage_v1: which refs to test: \"main\", \"stable\", or \"both\" (default). \"both\" is strongly preferred — the delta between refs distinguishes a live bug from a regression from an already-fixed report."
    type        = string
    default     = "both"
}

variable "main_ref" {
    description = "qa_triage_v1: ref treated as mainline. Fetched before resolution so the tested SHA is the remote's, not a stale local ref."
    type        = string
    default     = "origin/main"
}

variable "stable_ref" {
    description = "qa_triage_v1: ref treated as latest stable. Empty (the default) resolves to the highest non-prerelease semver tag reachable in the repo."
    type        = string
    default     = ""
}

variable "build_cmd" {
    description = "qa_triage_v1: command that builds the project inside a triage worktree, run before any reproduction attempt. Empty skips the build step — set this for any compiled project (e.g. 'make build')."
    type        = string
    default     = ""
}

variable "test_cmd" {
    description = "qa_triage_v1: command that runs the project's test suite inside a triage worktree, used to establish that the tree is otherwise healthy. Empty skips it."
    type        = string
    default     = ""
}

// ── Agent configs ────────────────────────────────────────────────────────────

// Triage reviewer: routes the completed triage run. Deliberately a DIFFERENT
// model family from qa_triage_v1's writer agents — the value of a review gate
// is that it does not share the writer's blind spots.
variable "triage_reviewer" {
    type = object({
        model            = string
        max_turns        = optional(number, 20)
        reasoning_effort = optional(string, "")
        provider = optional(object({
            base_url = optional(string, "")
            wire_api = optional(string, "")
            api_key  = optional(string, "")
        }))
    })

    default = {
        model     = "deepseek-v4.1-flash:cloud"
        max_turns = 20
        provider = {
            base_url = "http://localhost:11434/v1"
            wire_api = "responses"
            api_key  = ""
        }
    }
}

// Investigator and supervisor are qa_triage_v1's agent configs, passed through
// unchanged. The block shapes must stay in sync with qa_triage_v1/variables.chcl.
variable "investigator" {
    type = object({
        model            = string
        max_turns        = optional(number, 40)
        reasoning_effort = optional(string, "")
        provider = optional(object({
            base_url = optional(string, "")
            wire_api = optional(string, "")
            api_key  = optional(string, "")
        }))
    })

    default = {
        model     = "glm-5.3-flash:cloud"
        max_turns = 40
        provider = {
            base_url = "http://localhost:11434/v1"
            wire_api = "responses"
            api_key  = ""
        }
    }
}

variable "supervisor" {
    type = object({
        model            = string
        max_turns        = optional(number, 30)
        reasoning_effort = optional(string, "")
        provider = optional(object({
            base_url = optional(string, "")
            wire_api = optional(string, "")
            api_key  = optional(string, "")
        }))
    })

    default = {
        model     = "deepseek-v4.1-flash:cloud"
        max_turns = 30
        provider = {
            base_url = "http://localhost:11434/v1"
            wire_api = "responses"
            api_key  = ""
        }
    }
}

variable "linear_api_key" {
    type   = string
    secret = true
}

variable "workflow_github_token" {
    type   = string
    secret = true
}