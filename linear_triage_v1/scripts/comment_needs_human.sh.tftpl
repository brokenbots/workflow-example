criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
criteria_value_4={{ .criteria_value_4 | shellquote }}
            set -euo pipefail
            : "${LINEAR_API_KEY:?LINEAR_API_KEY is not set -- export it before criteria apply}"
            run_dir="$criteria_value_1/$criteria_value_2"
            issue_id=$(jq -r '.data.issue.id' "$run_dir/ticket.json")

            # QA persists every human escalation before returning it. Prefer
            # that complete verdict and reasoning over any stale review note.
            notes="$criteria_value_3/$criteria_value_2/evidence/triage-report.md"
            if [ ! -s "$notes" ]; then
                notes="$run_dir/review-notes.md"
            fi
            if [ ! -s "$notes" ]; then
                notes="$criteria_value_3/$criteria_value_2/evidence/summary.md"
            fi
            if [ ! -s "$notes" ]; then
                echo "needs-human verdict has no persisted reasoning" >&2
                exit 1
            fi

            curl -sS -f \
                -H "Authorization: $LINEAR_API_KEY" \
                -H "Content-Type: application/json" \
                -d "$(jq -n \
                    --arg q 'mutation($id: String!, $body: String!) { commentCreate(input: {issueId: $id, body: $body}) { success } }' \
                    --arg id "$issue_id" \
                    --arg header "**Automated QA triage needs a human decision.** Verdict: $criteria_value_4. Triage evidence: $criteria_value_3/$criteria_value_2/evidence/.

" \
                    --rawfile notes "$notes" \
                    '{query: $q, variables: {id: $id, body: ($header + $notes)}}')" \
                https://api.linear.app/graphql \
                | jq -e '.data.commentCreate.success == true' >/dev/null

            echo "comment posted"
