#!/bin/sh
# Deterministic triage bypass gate (internal-reproduced label). Reads the
# fetched ticket.json and prints "skip_triage" when the issue carries
# the internal-reproduced label, "run_triage" otherwise. Exit 0 in both cases -
# the label is a routing signal, not an error condition.
#
# Two fixes over the linear_intake_v1 original this was copied from (intake
# itself is untouched by the extraction):
# 1. fetch_ticket stores Linear's GraphQL response with its data/issue
#    envelope, so the label list must be read through .data.issue — the
#    original read it from the document root and never saw the label.
# 2. The jq variable is deliberately not named $label: "label" is a jq >= 1.6
#    keyword, so $label fails to compile there (and the original's stderr
#    suppression hid the error, forcing every ticket to "run_triage").
set -eu

TICKET_JSON="{{ .intake_root }}/{{ .ticket_id }}/ticket.json"

if jq -e --arg wanted "internal-reproduced" \
    '.data.issue.labels.nodes[]? | select(.name == $wanted)' "$TICKET_JSON" > /dev/null 2>&1; then
    # printf, not echo: the router compares output.stdout verbatim against
    # "skip_triage", and echo's trailing newline breaks the equality
    # (observed live on CRI-264: gate printed skip_triage, run took the
    # QA-triage default anyway).
    printf '%s' "skip_triage"
else
    printf '%s' "run_triage"
fi