// KB-279 (failures card): G12 callee-side environment + adapter.
//
// remote.g12_side — the SHADOWED same-key declaration (ADR-0009): the
//   callee's own value ("callee-shadow") must never surface on a pod; the
//   parent's declaration substitutes this one at composition.

environment "remote" "g12_side" {
    // Per-scope sessions: the g12 callee dial is its own (callee-scope,
    // environment) pod — the identity's single provision.
    per_scope_sessions = true
    working_directory  = "/home/criteria"
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
    // The contrast value (substitution test): if THIS value is ever observed
    // on a pod, the parent's shadow did not substitute — a defect files to
    // the engine carrier, never fixed from a harness card.
    variables = {
        FAILURE_G12_ENV_MARKER = "callee-shadow"
    }
}

// The SAME definition identity the parent declares (cross-layer grouping).
adapter "shell" "g12_declared" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.5"
    environment = remote.g12_side
}
