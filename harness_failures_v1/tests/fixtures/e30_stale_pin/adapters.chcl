// KB-279 E30 fixture adapters: one shell member on the pass-in identity.

environment "remote" "pin_env" {
    // The pin_probe step's single dial is its own session (per-scope).
    per_scope_sessions = true
    working_directory  = "/home/criteria"
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
    variables = {
        FAILURE_PIN_ENV_MARKER = "pin-probe"
    }
}

adapter "shell" "pass_in" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.5"
    environment = remote.pin_env
}
