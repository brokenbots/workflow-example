// KB-279 G12 fixture parent adapters: TWO declared identities so the suite
// can flip the block traversal between valid spellings (side_b -> side_a)
// without ever referencing an undeclared name. The marker values are the
// contrast the run layer would read; the callee carries its own shadow.

environment "remote" "side_a" {
    per_scope_sessions = true
    working_directory  = "/home/criteria"
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
    variables = {
        FAILURE_G12_SILENT_MARKER_A = "side-a-live"
    }
}

environment "remote" "side_b" {
    per_scope_sessions = true
    working_directory  = "/home/criteria"
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
    variables = {
        FAILURE_G12_SILENT_MARKER_B = "side-b-live"
    }
}

adapter "shell" "pass_in" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.5"
    environment = remote.side_a
}
