// KB-279 G12 fixture callee record writer (shape-only; never run by suite).
//
// ${probe_root}:   evidence root.
// ${record_name}:  fixed marker name.
// ${record_value}: fixed marker content.
set -eu

probe_root={{ .probe_root | shellquote }}
: "${probe_root:=${PROBE_ROOT:-${1:-/home/criteria/criteria-harness-failures}}}"
record_name={{ .record_name | shellquote }}
: "${record_name:=${RECORD_NAME:-${2:-g12_silent_callee}}}"
record_value={{ .record_value | shellquote }}
: "${record_value:=${RECORD_VALUE:-${3:-callee-shadow}}}"

case "$probe_root" in
    ''|*..*|*[;&|`$<>]*) echo "g12-callee: probe_root refused (unsafe shape)" >&2; exit 9 ;;
esac

records_dir="$probe_root/failure_probe_records"
mkdir -p "$records_dir"

printf 'g12-callee: record %s = %s\n' "$record_name" "$record_value" >&2
printf '%s: %s\n' "$record_name" "$record_value" >"$records_dir/$record_name.record"

echo "g12-callee: wrote callee record (shape evidence only)" >&2
exit 0