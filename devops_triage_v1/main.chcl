workflow {
    name          = "devops_triage_v1"
    version       = "1"
    criteria_version = ">=0.5.9, <0.6.0"
    initial_state = "stage_report"
    target_state  = "delivered"

    policy {
        max_total_steps = 200
    }
}

// ── Run state ────────────────────────────────────────────────────────────────

// Slug for this run. Names the run directory and the work branch.
data "internal" "slug" {
    type  = string
    value = ""
}

// Absolute path of this run's directory: <ops_root>/<slug>. Evidence lives at
// <run_dir>/evidence and is never removed.
data "internal" "run_dir" {
    type  = string
    value = ""
}

// The run's work branch, created deterministically off base_branch.
data "internal" "branch" {
    type  = string
    value = ""
}

// The branch's HEAD when THIS run started — the boundary between work that was
// already reviewed and work this run is responsible for.
//
// It exists because a branch can accumulate work across several runs (a follow-up
// request against an open PR). The scope checks must diff against this, not
// against base_branch: reviewing against base makes every earlier run's approved
// commits look like unrequested scope creep, and a manager acting on that
// conclusion sends a brief to revert work the operator asked for. That happened.
//
// On a fresh branch this equals base_sha and nothing changes.
data "internal" "run_base_sha" {
    type  = string
    value = ""
}

// Concrete SHA of the base branch, resolved after an explicit fetch so the work
// is cut from the remote's commit and not a stale local ref.
data "internal" "base_sha" {
    type  = string
    value = ""
}

// Manager's revision notes to the triage agent, carried as data rather than
// accumulated in the prompt so a refine cycle costs one message, not a growing
// transcript.
data "internal" "manager_feedback" {
    type  = string
    value = ""
}

// The brief the worker subworkflow is launched with. Written by the manager at
// the work-list gate, and rewritten by the manager at the final gate on every
// needs_work cycle — the worker's next session starts from this text and nothing
// else, which is what makes the reset meaningful.
data "internal" "worker_brief" {
    type  = string
    value = ""
}

// The worker's own account of the cycle it just finished.
data "internal" "worker_summary" {
    type  = string
    value = ""
}

// Triage's report of where things stand: "complete" | "incomplete" | "blocked".
// This is an observation, not a decision — the manager decides what to do about
// it at the final gate.
data "internal" "triage_state" {
    type  = string
    value = ""
}

// How the run concluded. Drives teardown and the final routing.
data "internal" "verdict" {
    type  = string
    value = ""
}

data "internal" "pr_url" {
    type  = string
    value = ""
}

// ── Worker subworkflow ───────────────────────────────────────────────────────
//
// Declared once and re-entered per cycle. Each entry runs the child from its
// initial state, so the devops agent gets a new session every time: the only
// thing that survives a cycle is the committed diff and the brief below. That is
// the point — an executor carrying three failed attempts in its context spends
// the fourth defending them.

subworkflow "devops_worker" {
    source = "./workflows/devops_worker"
    input = {
        brief         = data.internal.worker_brief.value
        worklist_file = "${data.internal.run_dir.value}/evidence/worklist.md"
        report_file   = "${data.internal.run_dir.value}/evidence/report.md"
        evidence_dir  = "${data.internal.run_dir.value}/evidence"
        worktree_dir  = var.worktree_dir
        base_branch   = var.base_branch
        branch        = data.internal.branch.value
        ci_gate_cmd   = var.ci_gate_cmd
        max_visits    = var.max_worker_visits
        devops        = var.devops
    }
}

// ── Intake ───────────────────────────────────────────────────────────────────

// Normalizes the request to a single file before anything else looks at it, so
// every downstream step has one shape to handle. Also the only place the
// workspace preconditions are checked — failing here costs nothing, and failing
// after a worktree exists costs a manual cleanup.
step "stage_report" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/stage_report.sh.tftpl", {
            criteria_value_1 = var.worktree_dir
            criteria_value_2 = var.repo_dir
            criteria_value_3 = var.ops_root
            criteria_value_4 = var.ops_report_file
            criteria_value_5 = var.report_text
        })
    }
    outcome "success" { next = step.resolve_slug }
    outcome "failure" { next = state.failed }
}

step "resolve_slug" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/resolve_slug.sh.tftpl", {
            criteria_value_1 = var.run_label
            criteria_value_2 = var.ops_report_file
            criteria_value_3 = var.ops_root
        })
    }
    outcome "success" {
        next = step.resolve_branch
        write {
            target = data.internal.slug.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

step "resolve_branch" {
    target = adapter.shell.repo
    input {
        command = "printf '%s%s' '${var.branch_prefix}' '${data.internal.slug.value}'"
    }
    outcome "success" {
        next = step.prepare_workspace
        write {
            target = data.internal.branch.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

step "prepare_workspace" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/prepare_workspace.sh.tftpl", {
            criteria_value_1 = var.ops_root
            criteria_value_2 = data.internal.slug.value
        })
    }
    outcome "success" {
        next = step.resolve_base
        write {
            target = data.internal.run_dir.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// Fetch first, then resolve. Resolving without fetching is how a run ends up
// branching from a commit that is not what anyone else means by "main".
step "resolve_base" {
    target  = adapter.shell.repo
    timeout = "120s"
    input {
        command = templatefile("./scripts/resolve_base.sh.tftpl", {
            criteria_value_1 = var.repo_dir
            criteria_value_2 = var.base_branch
        })
    }
    outcome "success" {
        next = step.write_context
        write {
            target = data.internal.base_sha.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// Facts that are identical for every run, recorded once so no agent has to
// establish them and no two agents can disagree about them.
//
// Deliberately NOT a discovery step. What is worth collecting depends entirely
// on the task — a failing release wants run logs, a permissions audit wants
// branch protections and token scopes, a dependency alert wants a lockfile
// history — and a fixed collector would either pull the wrong things or would
// quietly define the workflow as being about one kind of task. Discovery is
// triage's job, and what triage finds it writes back here.
step "write_context" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/write_context.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.ci_gate_cmd
            criteria_value_3 = var.verify_cmd
            criteria_value_4 = var.repo_dir
            criteria_value_5 = var.base_branch
            criteria_value_6 = data.internal.base_sha.value
            criteria_value_7 = data.internal.branch.value
            criteria_value_8 = var.worktree_dir
            criteria_value_9 = var.hints
        })
    }
    outcome "success" { next = step.setup_worktree }
    outcome "failure" { next = state.failed }
}

// The only tree the agents may write in, created before any of them starts.
//
// Deterministic on purpose. Branch creation and worktree attachment are
// identical every run — there is no judgement in them, so there is no agent in
// them. An agent asked to "get onto a branch" is an agent that can invent a
// different branch each time.
step "setup_worktree" {
    target  = adapter.shell.repo
    timeout = "120s"
    input {
        command = templatefile("./scripts/setup_worktree.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
            criteria_value_2 = var.base_branch
            criteria_value_3 = var.worktree_dir
            criteria_value_4 = var.repo_dir
            criteria_value_5 = data.internal.base_sha.value
        })
    }
    outcome "success" { next = step.record_run_base }
    outcome "failure" { next = state.failed }
}

// Mark where this run started, before any agent has touched the branch.
step "record_run_base" {
    target = adapter.shell.repo
    input {
        command = "printf '%s' \"$(git -C '${var.worktree_dir}' rev-parse HEAD)\""
    }
    outcome "success" {
        next = step.intake_review
        write {
            target = data.internal.run_base_sha.value
            value  = output.stdout
        }
    }
    outcome "failure" { next = state.failed }
}

// ── Gate 0: is there a request here at all? ──────────────────────────────────
//
// A deliberately low bar. The request is allowed to be one line: triage does the
// discovery, so demanding a run ID or a diagnosis up front would reject exactly
// the requests this workflow is for.

step "intake_review" {
    target      = adapter.copilot.manager
    max_visits  = var.max_intake_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/intake_review.md.tftpl", {
            run_dir = data.internal.run_dir.value
        })
    }

    outcome "actionable" { next = step.triage_worklist }
    outcome "insufficient" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "insufficient_report"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "needs_human" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_intake"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Triage: call 1 of 2 ──────────────────────────────────────────────────────
//
// Discovery and specification. This is the agent that goes and finds out what is
// actually true — it queries GitHub, reads run logs, walks history, inspects
// settings, runs scanners — and then writes down what has to be done.
//
// It does not do any of it. The agent that writes the work list never executes
// the work list, so the same reasoning is never both the plan and its own proof.
//
// It may also come back and say there is nothing to fix. That is a first-class
// result, not a failure to find one.

step "triage_worklist" {
    target      = adapter.copilot.triage
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/triage_worklist.md.tftpl", {
            run_dir          = data.internal.run_dir.value
            worktree_dir     = var.worktree_dir
            branch           = data.internal.branch.value
            base_branch      = var.base_branch
            base_sha         = data.internal.base_sha.value
            ci_gate_cmd      = var.ci_gate_cmd
            verify_cmd       = var.verify_cmd
            manager_feedback = data.internal.manager_feedback.value
        })
    }

    outcome "worklist_ready" { next = step.review_worklist }
    // The premise was wrong, the problem is already fixed, or the behavior is
    // working as designed. Reviewed like any other finding — an unreviewed "it's
    // fine" from the agent that would otherwise have to do the work is the one
    // conclusion this workflow should trust least.
    outcome "no_action_needed" { next = step.review_no_action }
    outcome "need_help" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_triage"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Gate 1a: is "nothing is wrong" actually true? ────────────────────────────

step "review_no_action" {
    target      = adapter.copilot.manager
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/review_no_action.md.tftpl", {
            run_dir = data.internal.run_dir.value
        })
    }

    outcome "confirmed" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "no_action_needed"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "disputed" {
        next = step.triage_worklist
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "needs_human" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_triage"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Gate 1b: is the work list right, before it costs a work cycle? ───────────

step "review_worklist" {
    target      = adapter.copilot.manager
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/review_worklist.md.tftpl", {
            run_dir = data.internal.run_dir.value
        })
    }

    outcome "worklist_approved" {
        next = step.run_devops_worker
        write {
            target = data.internal.worker_brief.value
            value  = output.reason
        }
        write {
            target = data.internal.manager_feedback.value
            value  = ""
        }
    }
    outcome "worklist_revise" {
        next = step.triage_worklist
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "worklist_reject" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "worklist_rejected"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    // The work is warranted but cannot proceed without an operator action —
    // a repository that must be created, a credential nobody has minted, an
    // approval this run does not hold. Distinct from worklist_reject, which
    // means the work is not wanted. Without this outcome the manager's only
    // way to move a blocked prerequisite forward is to write it into the
    // brief, which is how a forbidden action becomes an instruction.
    outcome "needs_human" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_worklist"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Work cycle ───────────────────────────────────────────────────────────────
//
// max_visits bounds the manager's needs_work <-> worker cycle: a brief that
// never converges fails the run instead of looping forever.

step "run_devops_worker" {
    target     = subworkflow.devops_worker
    max_visits = var.max_worker_cycles
    outcome "success" {
        next = step.run_verify
        write {
            target = data.internal.worker_summary.value
            value  = try(subworkflow.summary, "")
        }
    }
    outcome "failure" {
        next = step.write_ops_report
        write {
            target = data.internal.worker_summary.value
            value  = try(subworkflow.summary, "")
        }
        write {
            target = data.internal.verdict.value
            value  = "worker_failed"
        }
    }
}

// The expensive proof, run deterministically rather than by the agent that
// wants it to pass. Non-fatal by design: a failed verification is a finding for
// the state validation and the final gate, not a reason to abandon the run.
step "run_verify" {
    target  = adapter.shell.wt
    timeout = "1800s"
    input {
        command = templatefile("./scripts/run_verify.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = var.verify_cmd
        })
    }
    outcome "success" { next = step.validate_state }
    outcome "failure" { next = step.validate_state }
}

// ── Triage: call 2 of 2 ──────────────────────────────────────────────────────
// The same role that discovered the situation now reports what is and is not
// done. It reports; it does not decide, and it does not fix. Deciding is the
// manager's and fixing is the worker's — a triage agent that repairs what it
// finds destroys the only independent account of the tree's state.

step "validate_state" {
    target      = adapter.copilot.triage
    max_visits  = var.max_refine_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/validate_state.md.tftpl", {
            run_dir        = data.internal.run_dir.value
            worker_summary = data.internal.worker_summary.value
            run_base_sha   = data.internal.run_base_sha.value
            base_sha       = data.internal.base_sha.value
            base_branch    = var.base_branch
        })
    }

    outcome "state_complete" {
        next = step.final_review
        write {
            target = data.internal.triage_state.value
            value  = "complete"
        }
    }
    outcome "state_incomplete" {
        next = step.final_review
        write {
            target = data.internal.triage_state.value
            value  = "incomplete"
        }
    }
    outcome "state_blocked" {
        next = step.final_review
        write {
            target = data.internal.triage_state.value
            value  = "blocked"
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Gate 2: final authority over whether this work ships ─────────────────────

step "final_review" {
    target      = adapter.copilot.manager
    max_visits  = var.max_final_review_visits
    allow_tools = ["*"]

    input {
        prompt = templatefile("./agents/final_review.md.tftpl", {
            run_dir      = data.internal.run_dir.value
            triage_state = data.internal.triage_state.value
            branch       = data.internal.branch.value
            base_branch  = var.base_branch
            base_sha     = data.internal.base_sha.value
            run_base_sha = data.internal.run_base_sha.value
        })
    }

    outcome "approved" {
        next = switch.route_delivery
        write {
            target = data.internal.verdict.value
            value  = var.deliver == "none" ? "completed_local" : ""
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "needs_work" {
        next = step.run_devops_worker
        write {
            target = data.internal.worker_brief.value
            value  = output.reason
        }
    }
    outcome "reject" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "work_rejected"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "needs_human" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "needs_human_at_final"
        }
        write {
            target = data.internal.manager_feedback.value
            value  = output.reason
        }
    }
    outcome "failure" { next = state.failed }
    outcome "default" { next = state.failed }
}

// ── Delivery ─────────────────────────────────────────────────────────────────
// Every action past this point is deterministic shell. No agent pushes, tags,
// opens a PR, or touches a release in this workflow — those are identical every
// run, and the one thing worse than an agent that cannot fix a release pipeline
// is an agent that can publish one.

switch "route_delivery" {
    match {
        condition = var.deliver == "none"
        next      = step.write_ops_report
    }
    default { next = step.push_branch }
}

step "push_branch" {
    target  = adapter.shell.wt
    timeout = "120s"
    input {
        command = templatefile("./scripts/push_branch.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
        })
    }
    outcome "success" {
        next = switch.route_pr
        write {
            target = data.internal.verdict.value
            value  = "pushed"
        }
    }
    outcome "failure" {
        next = step.write_ops_report
        write {
            target = data.internal.verdict.value
            value  = "push_failed"
        }
    }
}

switch "route_pr" {
    match {
        condition = var.deliver == "pr"
        next      = step.open_pr
    }
    default { next = step.write_ops_report }
}

// Opens the PR and stops. Nothing here merges: review and merge belong to a
// human or to workstream_handler_v1, and a workflow that both writes a change
// and merges it has no gate left that it does not control.
step "open_pr" {
    target  = adapter.shell.wt
    timeout = "120s"
    input {
        command = templatefile("./scripts/open_pr.sh.tftpl", {
            criteria_value_1 = data.internal.branch.value
            criteria_value_2 = data.internal.slug.value
            criteria_value_3 = data.internal.run_dir.value
            criteria_value_4 = var.base_branch
        })
    }
    outcome "success" {
        next = step.write_ops_report
        write {
            target = data.internal.pr_url.value
            value  = output.stdout
        }
        write {
            target = data.internal.verdict.value
            value  = "pr_opened"
        }
    }
    // The branch is already pushed at this point, so a failed PR creation loses
    // nothing — it is recorded and the run concludes as `pushed`.
    outcome "failure" {
        next = step.write_ops_report
    }
}

// ── Run record ───────────────────────────────────────────────────────────────

// Written on every terminating path, including the ones that deliver nothing. A
// run that concludes "there was nothing to fix" is a result worth keeping — it
// is the answer to the request, and it is what stops the next person re-running
// the same investigation.
step "write_ops_report" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/write_ops_report.sh.tftpl", {
            criteria_value_1 = data.internal.run_dir.value
            criteria_value_2 = data.internal.verdict.value
            criteria_value_3 = data.internal.triage_state.value
            criteria_value_4 = data.internal.branch.value
            criteria_value_5 = var.base_branch
            criteria_value_6 = data.internal.base_sha.value
            criteria_value_7 = var.worktree_dir
            criteria_value_8 = data.internal.pr_url.value
            criteria_value_9 = data.internal.manager_feedback.value
            criteria_value_10 = data.internal.worker_summary.value
        })
    }
    outcome "success" { next = step.teardown }
    outcome "failure" { next = step.teardown }
}

// Evidence is the deliverable and is never removed.
//
// The worktree is removed ONLY when the commits are safely on the remote, or
// when there were never any commits to lose. Everywhere else it holds the sole
// copy of the run's work, and tearing it down would delete the thing the run
// exists to produce.
step "teardown" {
    target = adapter.shell.repo
    input {
        command = templatefile("./scripts/teardown.sh.tftpl", {
            criteria_value_1 = data.internal.verdict.value
            criteria_value_2 = var.worktree_dir
            criteria_value_3 = var.repo_dir
            criteria_value_4 = data.internal.run_dir.value
        })
    }
    outcome "success" { next = switch.route_final }
    outcome "failure" { next = switch.route_final }
}

switch "route_final" {
    match {
        condition = data.internal.verdict.value == "pr_opened" || data.internal.verdict.value == "pushed" || data.internal.verdict.value == "completed_local"
        next      = state.delivered
    }
    match {
        condition = startswith(data.internal.verdict.value, "needs_human")
        next      = state.needs_human
    }
    // A worker that never reached "ok", or a push that was refused, is a
    // mechanical failure of the run — not a considered decision not to ship.
    match {
        condition = data.internal.verdict.value == "push_failed" || data.internal.verdict.value == "worker_failed" || data.internal.verdict.value == ""
        next      = state.failed
    }
    default { next = state.closed_no_change }
}

// ── Terminal states ──────────────────────────────────────────────────────────

state "delivered" {
    terminal = true
    success  = true
}

// Not a failure, and for `no_action_needed` it is the point of the run: the
// answer to "is this broken?" is allowed to be no. The evidence directory
// records what was checked so the question is not re-investigated from scratch.
state "closed_no_change" {
    terminal = true
    success  = true
}

state "needs_human" {
    terminal = true
    success  = false
}

state "failed" {
    terminal = true
    success  = false
}

output "branch" {
    type  = string
    value = data.internal.branch.value
}

output "pr_url" {
    type  = string
    value = data.internal.pr_url.value
}

output "verdict" {
    type  = string
    value = data.internal.verdict.value
}
