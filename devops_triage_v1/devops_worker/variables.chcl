// The manager's brief, and the only instruction this cycle's agent receives.
// The session is new every cycle, so anything not in here — a prior attempt, a
// rejected approach, a constraint agreed two cycles ago — does not exist as far
// as the executing agent is concerned. That is deliberate; it is also why the
// manager is told to write this as a standalone directive.
variable "brief" {
    description = "Standalone brief for this work cycle, written by the manager. Empty is a programming error in the parent, not a valid input."
    type        = string
    default     = ""
}

variable "worklist_file" {
    description = "Absolute path to the approved work list. Read-only for this subworkflow — the executing agent implements it and never edits it."
    type        = string
    default     = ""
}

variable "report_file" {
    description = "Absolute path to the original request as staged into the evidence directory, read-only. Context for why the work list exists."
    type        = string
    default     = ""
}

variable "evidence_dir" {
    description = "Absolute path of the shared evidence directory. The work log for this cycle is appended here. Never cleaned up by this subworkflow."
    type        = string
    default     = ""
}

// Defaults to "" because it is referenced from adapter config, which must
// resolve at compile time. Always supplied by the parent.
variable "worktree_dir" {
    description = "Absolute path of the worktree this cycle runs in. Created by the parent before the first cycle; this subworkflow asserts it is on the expected branch rather than creating or switching anything."
    type        = string
    default     = ""
}

variable "branch" {
    description = "Branch the worktree must be on. Asserted, not checked out — a worktree on the wrong branch is a setup failure and must fail loudly rather than be silently corrected."
    type        = string
    default     = ""
}

variable "base_branch" {
    description = "Branch the work branch was cut from. Used to number the cycle commit."
    type        = string
    default     = "main"
}

variable "ci_gate_cmd" {
    description = "Fast local gate run after the cycle's commit (exit 0 = clean). Its combined output is fed back to the agent on failure. Empty skips the gate."
    type        = string
    default     = ""
}

variable "devops" {
    type = object({
        model            = string
        max_turns        = optional(number, 40)
        reasoning_effort = optional(string, "")
        provider = optional(object({
            base_url = optional(string, "")
            wire_api = optional(string, "")
            api_key  = optional(string, "")
        }))
    })

    // Always supplied by the parent. The default exists so this subworkflow
    // compiles standalone: adapter config must be known at compile time, and a
    // required object variable leaves it unknown.
    default = {
        model     = "kimi-k2.7-code:cloud"
        max_turns = 40
        provider = {
            base_url = "http://localhost:11434/v1"
            wire_api = "responses"
            api_key  = ""
        }
    }
}
