criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
set -uo pipefail
if [ -z "$(git status --porcelain)" ]; then
    echo "no_changes=true"
    exit 0
fi
base="$criteria_value_1"
n=$(git rev-list --count "origin/$base..HEAD" 2>/dev/null || echo 0)
n=$((n + 1))
git add -A
if ! out=$(git commit -m "ops: $criteria_value_2 cycle $n" 2>&1); then
    echo "commit_failed=true"
    echo "$out"
    exit 1
fi
echo "committed=$(git rev-parse --short HEAD) cycle=$n"
