criteria_value_1={{ .criteria_value_1 | shellquote }}
criteria_value_2={{ .criteria_value_2 | shellquote }}
criteria_value_3={{ .criteria_value_3 | shellquote }}
criteria_value_4={{ .criteria_value_4 | shellquote }}
criteria_value_5={{ .criteria_value_5 | shellquote }}
set -euo pipefail; exec 2>&1
branch="$criteria_value_1"
base="$criteria_value_2"
wt="$criteria_value_3"
echo "branch=$branch base=$base worktree=$wt"

git -C "$criteria_value_4" worktree prune 2>&1 || true

# Reuse a worktree already at this path (resume case). Ask git rather
# than string-matching paths, which differ under symlinks (/tmp vs
# /private/tmp on macOS).
if [ -d "$wt" ]; then
    if git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "reusing worktree at $wt (on '$(git -C "$wt" branch --show-current)')"
        exit 0
    fi
    echo "path $wt exists but is not a git worktree"
    exit 1
fi

mkdir -p "$(dirname "$wt")"
if git -C "$criteria_value_4" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$criteria_value_4" worktree add --force "$wt" "$branch"
elif git -C "$criteria_value_4" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git -C "$criteria_value_4" worktree add --force -b "$branch" "$wt" "origin/$branch"
else
    git -C "$criteria_value_4" worktree add --force -b "$branch" "$wt" "$criteria_value_5"
fi
echo "worktree_ready=$wt on_branch=$(git -C "$wt" branch --show-current)"
