// KB-217 NEGATIVE fixture: the reason-feeding arm of step "agent_work" writes
// output.reason into a variable and a subworkflow call input but declares NO
// require_comment. The validator must FAIL this tree and name the file, the
// step, the outcome arm, both sinks, and the fix hint. Deliberately not
// compile-ready (the violating state is only meaningful to the validator);
// the compliant twin of this tree lives next door.

workflow {
    version          = "1"
    criteria_version = ">=0.5.42"
    name             = "outcome_flow_violating"
    initial_state    = "agent_work"
    target_state     = "done"
}

data "internal" "findings" {
    type  = string
    value = ""
}

step "agent_work" {
    target = adapter.copilot.worker

    input {
        prompt = "work the task"
    }

    outcome "work_done" {
        next  = subworkflow.rollup
        write {
            target = data.internal.findings.value
            value  = output.reason
        }
    }

    outcome "failure" { next = state.done }
}
// NOTE: report's input also reads steps.agent_work.reason directly, so EVERY
// arm of agent_work is a reason producer for the rule (the conservative
// model: a steps.S.reason reference cannot name which arm's reason renders).
// The violating tree therefore fails on work_done AND failure; the compliant
// twin declares require_comment on both.

step "report" {
    target = adapter.copilot.reporter

    input {
        prompt = templatefile("./agents/report.md.tftpl", {
            findings = data.internal.findings.value
            followup = steps.agent_work.reason
        })
    }

    outcome "success" { next = state.done }
    outcome "failure" { next = state.done }
}

subworkflow "rollup" {
    target = subworkflow.rollup_impl

    input = {
        findings = data.internal.findings.value
    }
}

state "done" {
    type = "done"
}