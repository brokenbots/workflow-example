// review_triage_v1 environments + adapters.
//
// Mirrors qa_triage_v1/adapters.chcl: per-scope remote env (operator-spawned
// pods via the CRI-269 deferred-remote contract), reviewer copilot bound to it.
// The env's working_directory is the intake root — the reviewer writes
// review-notes.md into <intake_root>/<ticket_id>/read by the parent's comment
// scripts, and reads triage evidence under <triage_root>/<ticket_id>/.
//
// Kanboard credential not needed here: this tree reads artifacts and talks to
// the LLM provider; all Kanboard I/O stays in the parent tree.

environment "remote" "review" {
    per_scope_sessions = true
    working_directory  = var.intake_root
    process = {
        exec = ["*"]
    }
    listen_address   = "0.0.0.0:0"
    accept_token     = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
}

adapter "copilot" "triage_reviewer" {
    environment = remote.review
    source      = "ghcr.io/brokenbots/criteria-adapter-copilot"
    version     = "0.5.17"
    secrets {
        GITHUB_TOKEN = var.workflow_github_token
        GH_TOKEN     = var.workflow_github_token
    }
    config {
        model             = var.triage_reviewer.model
        max_turns         = "${var.triage_reviewer.max_turns}"
        reasoning_effort  = var.triage_reviewer.reasoning_effort
        system_prompt     = file("./agents/triage_reviewer.md")
        provider_base_url = var.provider_base_url != "" ? var.provider_base_url : var.triage_reviewer.provider.base_url
        provider_wire_api = var.triage_reviewer.provider.wire_api
        working_directory = var.intake_root
    }
}
