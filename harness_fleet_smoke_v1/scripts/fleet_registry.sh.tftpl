probe_root={{ .probe_root | shellquote }}
set -eu
command -v printf >/dev/null

# The fleet census + designed-class registry (KB-280). Two fixed-content
# records the live run events and triage read:
#
#   census.jsonl — the F33/F34/F35 vocabulary of the GREEN run: pod creates
#     == 1 per (scope, adapter/environment) pair (the root scope's single
#     provision; the borrower scope joins it with ZERO provision_wanted),
#     zero refused session dials anywhere on the green path, and the queue
#     discipline (Queue.Position counts to 0; 0 == admitted and running).
#
#   registry.jsonl — every designed class marker of the card slice (A1, A2
#     resolve + the engineered miss, F33-F37) plus the loud bug arms. A live
#     observation mapping a marker that lacks a registry line is NOT a
#     designed class of this card: defects file to their own carriers.

records_dir="$probe_root/fleet_smoke_records"
mkdir -p "$records_dir"

census="$records_dir/census.jsonl"
{
    printf 'record_name=fleet_census\n'
    printf 'class=F33 name=zero_pod_recreates marker=pod_creates==1 scope=root identity=shell.pass_in@remote.smoke (one provision, zero recreates)\n'
    printf 'class=F33 name=zero_provision_borrow marker=provision_wanted==0 scope=borrower identity=shell.pass_in@remote.smoke (the borrower joins the owner provision)\n'
    printf 'class=F34 name=refused_dial_zero marker=refused_session_dials==0 (every green-path dial lands on its joined session; a refusal is a red)\n'
    printf 'class=F35 name=queue_position_zero marker=Queue.Position==0 (0 == admitted and running)\n'
    printf 'designed_pod_creates_total=1\n'
} > "$census"

registry="$records_dir/registry.jsonl"
{
    printf 'record_name=fleet_registry\n'
    printf 'class=A1 name=identity_handshake_missing marker=session-bound-without-CRITERIA_ADAPTER_NAME (a nameless session must never run green)\n'
    printf 'class=A2 name=digest_pin_resolved marker=session-opened-under-lockfile-pin resolve-half (survivor redial proves the pinned provision outlives the borrowed scope)\n'
    printf 'class=A2 name=digest_miss_refused marker=admission-refused-before-session-open (a wrong pinned digest refuses fail-closed with ZERO pod creates; D7 fail-closed)\n'
    printf 'class=F33 name=zero_pod_recreates marker=pod_creates==1-per-scope-adapter-environment\n'
    printf 'class=F33 name=zero_provision_borrow marker=provision_wanted==0-for-borrower-scope\n'
    printf 'class=F34 name=refused_dial_zero marker=refused_session_dials==0 (unless the refusal IS the designed stimulus)\n'
    printf 'class=F35 name=queue_position_zero marker=Queue.Position-counts-to-0 (0==admitted-running; triage admits concurrently, develop serializes per repoURL)\n'
    printf 'class=F36 name=secret_free_config marker=no-secret-material-in-harness-configs (CRI-250; name references only)\n'
    printf 'class=F37 name=memory_ceiling_parity marker=peer-ceilings-seed-from-shared-adapterResources-then-resMax (a lone hand-written ceiling is the defect)\n'
    printf 'class=BUG name=canary_bug_terminal marker=state.failed (the loud exit: an invariant did not hold — never a silent green)\n'
} > "$registry"
echo "fleet-smoke census + registry written under $records_dir"