// KB-280 (fleet-smoke card): parent-side adapter + environment set. ONE
// identity on purpose: the canary pins fleet invariants over a single
// provision, not over a fleet.
//
//   environment remote.smoke — per-scope sessions (CRI-269 deferred-remote):
//     each scope's dials dispatch as per-scope operator-spawned peer pods.
//     The parent declaration carries the owner-side substitution marker the
//     borrower records must read ("owner", never the callee's contrast
//     value — ADR-0009 substitution evidence, E27 shape).
//
//   adapter shell.pass_in — the pass-in identity the borrower re-spells: the
//     SAME definition identity as the parent's (cross-layer grouping), the
//     E27/G6 borrow target. F37 surface: this member's container ceilings
//     come from the engine's shared adapterResources table (kind "shell":
//     512Mi request / 8Gi limit), never a hand-written ceiling.
//
// cwd note: the environment binds working_directory = "/home/criteria" — the
// operator pod's pre-existing user home; the adapter sandbox unconditionally
// allows it, and probe RECORDS land in var.probe_root beneath it (created at
// run time). No adapter engine overrides anywhere: the tree changes nothing
// about engine behavior. NO crash override is declared (the language default
// stays).

environment "remote" "smoke" {
    // Per-scope sessions: the root scope's dials dispatch as its single
    // (root-scope, remote.smoke) provision; the borrower scope joins it.
    per_scope_sessions = true
    working_directory  = "/home/criteria"
    process = {
        exec = ["*"]
    }
    listen_address     = "0.0.0.0:0"
    accept_token       = "__CRITERIA_REMOTE_TOKEN__"
    accept_digest_from = "lockfile"
    // The owner-side marker (substitution evidence): the borrower record must
    // read THIS value, never the callee's contrast value.
    variables = {
        FLEET_SMOKE_MARKER = "owner"
    }
}

adapter "shell" "pass_in" {
    source      = "ghcr.io/brokenbots/criteria-adapter-shell"
    version     = "0.5.5"
    environment = remote.smoke
}