// devops_maint_v1 — Lane A: classify/route/act graph (KB-407, ADR-0015 wave 2).
//
// Wave 2 of the devops_maint_v1 series (anchor KB-405, predecessor KB-406):
// the wave-1 collect step stays byte-compatible and is extended into a
// 6-step graph — every step deterministic shell except the one decision-
// adapter gate that rules on the automatable plan:
//
//   collect       (shell)    normalized inventory sweep               [KB-406]
//   classify      (shell)    deterministic buckets + consolidation:
//                            mechanical-bump / vuln-clear / needs-rebase /
//                            needs-judgment, ONE group per (repo, module,
//                            to_version) — the consolidated plan
//   route_prepare (shell)    compact decision-model brief from the
//                            classification artifact (pure jq)
//   route         (decision) the gate: a System One model rules the plan
//                            safe to run automatically. Confidence below
//                            route_conf_floor, a "hold" choice, or any
//                            undeclared choice holds the run (no act).
//   act           (shell)    rebase lane: needs_rebase carriers get
//                            update-branch read-back bookkeeping
//   merge         (shell)    brokenbot lane: gate (APPROVED/MERGEABLE/
//                            CLEAN/green rollup) then merge each carrier,
//                            close superseded members after the carrier
//                            merge. The workflow identity (collect/act) and
//                            the brokenbot identity (merge) are different
//                            tokens by design (ADR-0015: separate lanes).
//
// Determinism contract (ADR-0015 D1/D2): buckets and the consolidated plan
// come from pure jq in classify — identical inventories classify identically.
// The model cannot widen scope: the route step's only actionable choices are
// proceed (run the deterministic plan) or hold; judgment rows and parked/
// report-only rows are never auto-acted, they are carried into the
// classification artifact's report for the human lane (KB-409/410).
//
// Endings:
//   completed            — plan executed (or empty plan) and the merge lane
//                          finished; the acts + merged artifacts record it.
//   held                 — the route gate held: below route_conf_floor, the
//                          model chose hold, or its choice was undeclared
//                          (the conservative default arm). No act, no merge;
//                          the classification report stands on its own.
//   *_failed             — honest failure of one lane, with the typed
//                          failure line in the matching error output; the
//                          merge failure keeps its evidence artifact and
//                          names its path in the line.
workflow {
    name             = "devops_maint_v1"
    version          = "2"
    criteria_version = ">=0.5.9, >=0.5.52-rc1, <0.6.0"
    initial_state    = "collect"
    target_state     = "completed"

    policy {
        max_total_steps = 10
    }
}

// ── Run state ────────────────────────────────────────────────────────────────

// Absolute path of the normalized inventory artifact (one sweep). Set by the
// collect step's success arm — the handle the classify step reads back.
data "internal" "inventory_file" {
    type  = string
    value = ""
}

// Typed failure line when the collect step fails (config errors, an
// all-repos-failed sweep, or an artifact that failed its structural
// self-check). Embedded with the artifact path when one exists, so a failed
// sweep still tells a human where the partial evidence lives.
data "internal" "collect_error" {
    type  = string
    value = ""
}

// Absolute path of the classification artifact (buckets + consolidated plan
// + rebase plan + report), the handle the route/act/merge steps read back.
data "internal" "classification_file" {
    type  = string
    value = ""
}

// Typed failure line when the classify step fails (bad inventory artifact or
// a structural self-check failure).
data "internal" "classify_error" {
    type  = string
    value = ""
}

// The compact decision-model brief (single-line JSON the route_prepare step
// composes from the classification artifact). It becomes the decision step's
// state, so the model reasons over the deterministic plan, not the raw
// inventory.
data "internal" "route_brief" {
    type  = string
    value = ""
}

// Typed failure line when the route_prepare step fails (bad classification
// artifact, brief count mismatch).
data "internal" "route_brief_error" {
    type  = string
    value = ""
}

// The route gate's recorded verdict is read at terminal states from
// steps.route directly (with try guards) — a write inside the step's own
// outcome cannot reference steps.route (compile-time guard), and the shared
// output lets every ending report the same routing facts.

// Typed failure line when the route step fails (decision backend failure).
data "internal" "route_error" {
    type  = string
    value = ""
}

// Absolute path of the acts artifact (rebase bookkeeping rows).
data "internal" "acts_file" {
    type  = string
    value = ""
}

// Typed failure line when the act step fails. Per-carrier rebase failures are
// bookkeeping rows inside the acts artifact, not step failures.
data "internal" "act_error" {
    type  = string
    value = ""
}

// Absolute path of the merged artifact (per-carrier gate + close-out rows);
// also written when a gated merge fails, so the evidence survives the
// non-zero exit.
data "internal" "merge_file" {
    type  = string
    value = ""
}

// Typed failure line when the merge step fails (with the evidence-artifact
// path when a gated merge failed).
data "internal" "merge_error" {
    type  = string
    value = ""
}

// ── The route gate's questions ───────────────────────────────────────────────

// One choice question: run the deterministic plan (rebases + consolidated
// carrier merges) as automated maintenance, or hold for a human. The brief
// carries the plan and the explicit note that judgment/report rows are never
// auto-acted, so a hold choice is the model's whole veto surface — it can
// narrow nothing, widen nothing, and invent no actions.
local "route_questions" {
    value = jsonencode([
        {
            id           = "action"
            type         = "choice"
            instructions = "You are reviewing the consolidated dependency-maintenance plan for one sweep: bump carriers to merge, superseded PRs to close after each carrier merge, and PRs to rebase. The plan is deterministic and already scoped: bump/rebase rows only, human-judgment rows are excluded and report-only. Choose proceed to let automation execute the plan exactly as stated, or hold if anything in the brief looks wrong for automated execution (ambiguity, a module the plan mis-identifies, evidence of broader dependency work that should be human-decided)."
            criteria     = {
                proceed = "The consolidated bump/rebase plan in the brief is unambiguous and safe to execute automatically as stated; human-review rows are already excluded from it."
                hold    = "Something in the brief is wrong or ambiguous for automated execution: hold the whole plan for a human instead of acting."
            }
        }
    ])
}

// ── Graph ────────────────────────────────────────────────────────────────────

// Wave-1 collect step, unchanged (the header documents its sweep surfaces).
step "collect" {
    target  = adapter.shell.collect
    // Step timeouts must be compile-time-known literals in the step grammar
    // (no var interpolation), so the collect wall-clock budget is pinned at
    // 3600s: a 16-repo sweep's enumeration + per-PR checks + one depth-1
    // clone per repo + the advisory scans fit comfortably.
    timeout = "3600s"
    input {
        command = templatefile("./scripts/collect_inventory.sh.tftpl", {
            gh_retry         = file("./scripts/gh_retry.sh.tftpl")
            org              = var.org
            repos_json       = jsonencode(var.repos)
            sweep_root       = var.sweep_root
            // shellquote takes strings only: bools flatten to "true"/"false"
            // at the template boundary; the sweep script re-verifies the shape.
            scan_govulncheck = var.scan_govulncheck ? "true" : "false"
            scan_osv         = var.scan_osv ? "true" : "false"
        })
    }
    outcome "success" {
        next = step.classify
        write {
            target = data.internal.inventory_file.value
            // stdout carries ONLY the machine artifact path (exact trimmatch).
            value = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.collect_failed
        write {
            target = data.internal.collect_error.value
            // The final stderr line is the typed failure reason; earlier
            // stderr already carries the gh retry attempt evidence.
            value = trimspace(output.stderr)
        }
    }
}

// Deterministic buckets + consolidated plan (pure jq; identical inventories
// classify identically and the artifact self-checks its own structure).
step "classify" {
    target  = adapter.shell.classify
    timeout = "600s"
    input {
        command = templatefile("./scripts/classify_prs.sh.tftpl", {
            inventory_file = data.internal.inventory_file.value
        })
    }
    outcome "success" {
        next = step.route_prepare
        write {
            target = data.internal.classification_file.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.classify_failed
        write {
            target = data.internal.classify_error.value
            value  = trimspace(output.stderr)
        }
    }
}

// Compact brief for the route gate (pure jq; count-gated against the
// classification summary).
step "route_prepare" {
    target  = adapter.shell.route_prepare
    timeout = "600s"
    input {
        command = templatefile("./scripts/route_brief.sh.tftpl", {
            classification_file = data.internal.classification_file.value
        })
    }
    outcome "success" {
        next = step.route
        write {
            target = data.internal.route_brief.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.route_prepare_failed
        write {
            target = data.internal.route_brief_error.value
            value  = trimspace(output.stderr)
        }
    }
}

// The decision-adapter gate. One System One call over the brief; the answers
// are routed by the switch below (outcome-pure step, like decision_demo_v1).
step "route" {
    target  = adapter.decision.route_gate
    timeout = "120s"
    input {
        questions = local.route_questions
        state     = data.internal.route_brief.value
    }
    outcome "success" {
        next = switch.route_gate
    }
    outcome "failure" {
        next = state.route_failed
        write {
            target = data.internal.route_error.value
            value  = trimspace(output.stderr)
        }
    }
}

// Gate routing. Match arms are evaluated in declaration order and the first
// truthy condition wins, so the confidence gate must stay first: an
// unconfident choice always lands on hold, never on auto-action below it.
// hold is also the default arm — an undeclared choice can never act.
switch "route_gate" {
    match {
        condition = steps.route.answers.action.confidence < var.route_conf_floor
        next      = state.held
    }
    match {
        condition = steps.route.answers.action.choice == "hold"
        next      = state.held
    }
    match {
        condition = steps.route.answers.action.choice == "proceed"
        next      = step.act
    }
    default { next = state.held }
}

// Rebase lane: bookkeeping over the needs_rebase plan; per-carrier failures
// stay rows in the acts artifact.
step "act" {
    target  = adapter.shell.act
    timeout = "3600s"
    input {
        command = templatefile("./scripts/act_rebase_consolidate.sh.tftpl", {
            gh_retry            = file("./scripts/gh_retry.sh.tftpl")
            org                 = var.org
            classification_file = data.internal.classification_file.value
        })
    }
    outcome "success" {
        next = step.merge
        write {
            target = data.internal.acts_file.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.act_failed
        write {
            target = data.internal.act_error.value
            value  = trimspace(output.stderr)
        }
    }
}

// The brokenbot lane: gate + merge carriers, close superseded members.
step "merge" {
    target  = adapter.shell.merge
    timeout = "3600s"
    input {
        command = templatefile("./scripts/merge_acts.sh.tftpl", {
            gh_retry            = file("./scripts/gh_retry.sh.tftpl")
            org                 = var.org
            classification_file = data.internal.classification_file.value
        })
    }
    outcome "success" {
        next = state.completed
        write {
            target = data.internal.merge_file.value
            value  = trimspace(output.stdout)
        }
    }
    outcome "failure" {
        next = state.merge_failed
        write {
            target = data.internal.merge_error.value
            value  = trimspace(output.stderr)
        }
    }
}

// ── Endings ──────────────────────────────────────────────────────────────────

state "completed" {
    terminal = true
    success  = true
}

// The route gate held the run (low confidence, hold choice, or an undeclared
// choice). A held run is an honest non-success: no act, no merge; the
// classification report is the deliverable for the human lane.
state "held" {
    terminal = true
    success  = false
}

state "collect_failed" {
    terminal = true
    success  = false
}

state "classify_failed" {
    terminal = true
    success  = false
}

state "route_prepare_failed" {
    terminal = true
    success  = false
}

state "route_failed" {
    terminal = true
    success  = false
}

state "act_failed" {
    terminal = true
    success  = false
}

state "merge_failed" {
    terminal = true
    success  = false
}

// ── Outputs ──────────────────────────────────────────────────────────────────

output "inventory_file" {
    description = "Path of the normalized inventory artifact for this sweep; empty when the collect step failed."
    type        = string
    value       = data.internal.inventory_file.value
}

output "collect_error" {
    description = "Typed failure line of the collect step (with the partial-artifact path when one exists); empty on success."
    type        = string
    value       = data.internal.collect_error.value
}

output "classification_file" {
    description = "Path of the classification artifact (buckets, consolidated plan, rebase plan, report); empty when the classify step failed."
    type        = string
    value       = data.internal.classification_file.value
}

output "classify_error" {
    description = "Typed failure line of the classify step; empty on success."
    type        = string
    value       = data.internal.classify_error.value
}

output "route_brief" {
    description = "The single-line brief the route gate ruled on; empty when the route_prepare step failed."
    type        = string
    value       = data.internal.route_brief.value
}

output "route_decision" {
    description = "The route gate's verdict (choice + confidence) as JSON, or the conservative undeclared marker when the backend gave no usable answer."
    type        = string
    value = jsonencode({
        choice     = try(steps.route.answers.action.choice, "undeclared")
        confidence = try(steps.route.answers.action.confidence, -1)
    })
}

output "route_brief_error" {
    description = "Typed failure line of the route_prepare step; empty on success."
    type        = string
    value       = data.internal.route_brief_error.value
}

output "route_error" {
    description = "Typed failure line of the route step (decision backend failure); empty on success."
    type        = string
    value       = data.internal.route_error.value
}

output "acts_file" {
    description = "Path of the acts artifact (rebase bookkeeping rows); empty when the act step failed."
    type        = string
    value       = data.internal.acts_file.value
}

output "act_error" {
    description = "Typed failure line of the act step; empty on success. Per-carrier rebase failures live in the acts artifact, not here."
    type        = string
    value       = data.internal.act_error.value
}

output "merge_file" {
    description = "Path of the merged artifact (gate + close-out rows); also set when a gated merge failed, so the evidence survives the failure."
    type        = string
    value       = data.internal.merge_file.value
}

output "merge_error" {
    description = "Typed failure line of the merge step (with the evidence-artifact path on a gated merge failure); empty on success."
    type        = string
    value       = data.internal.merge_error.value
}
