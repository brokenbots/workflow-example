// devops_maint_v1 variables (KB-406 collect + KB-407 Lane A graph).
//
// The sweep runs unattended as deterministic shell (no model turns), so its
// scope is fail-loud: org must be bound (no default) and repos ships EMPTY by
// design so an unconfigured sweep can never silently collect unconfigured
// repositories. The route gate's backend must be explicitly bound too — a
// default base_url would let a missing binding point the gate at nothing.
variable "org" {
    description = "GitHub org whose repos the sweep enumerates; org/repo pairs feed every gh call (PRs, checks, advisories, code-scanning, rulesets)."
    type        = string
}

// Repo scope of the sweep, in declared sweep order. Empty by design: collect
// refuses to emit a zero-repo artifact (fail loud) instead of widening scope.
variable "repos" {
    description = "Repo names under org this sweep collects. Must be bound to a non-empty list; empty by design so a sweep can never silently widen scope."
    type        = list(string)
    default     = []
}

// The PVC data lane the sweep executes from (interface.json mounts it at
// /data). The shell adapter's working directory must exist BEFORE the step
// execs, so it points at the mounted lane while the sweep script itself
// creates the deeper sweep_root/<sweep_id>/ workspace.
variable "data_root" {
    description = "Durable data lane the sweep executes from (mounted at the interface's data mount path). Sweep artifacts nest under sweep_root inside it."
    type        = string
    default     = "/data"
}

// Durable root for sweep workspaces + inventory artifacts. Kept across runs
// so the delta-driven cadence can read prior inventories back.
variable "sweep_root" {
    description = "Durable root for sweep workspaces + inventory.json artifacts (prior sweeps stay readable for the delta-driven cadence)."
    type        = string
    default     = "/data/devops-maint"
}

// Advisory surfaces are on by default (the card's full column set); a caller
// may disable one to trade wall clock for a faster partial sweep — the
// artifact records the skipped surface honestly rather than reporting it
// clean, so classify can never classify UNKNOWN as "no advisories".
variable "scan_govulncheck" {
    description = "Run govulncheck per cloned repo when the tool is present (status lanes: ok | not_applicable | unavailable | error; a disabled surface records not_applicable, never a clean bill)."
    type        = bool
    default     = true
}

variable "scan_osv" {
    description = "Run osv-scanner per cloned repo when the tool is present (status lanes: ok | not_applicable | unavailable | error; a disabled surface records not_applicable, never a clean bill)."
    type        = bool
    default     = true
}

variable "workflow_github_token" {
    description = "Workflow GitHub identity the shell adapter injects as GH_TOKEN via the engine's secret providers (ADR-0015 D4). Collect + act run under it; merge does not."
    type        = string
    secret      = true
}

// ── Lane A (KB-407): route gate + brokenbot merge lane ───────────────────────

// The decision gate: a choice below this confidence is not trusted to
// auto-act and holds the run, mirroring decision_demo_v1's routing gate.
variable "route_conf_floor" {
    type        = number
    default     = 0.9
    description = "Minimum acceptable decision confidence for the route gate to auto-proceed the consolidated plan; anything below holds the run."
}

// The route gate's backend endpoint override carries a production fallback
// (the decision_demo_v1 production shape) because adapter config attributes
// must be compile-time known; an explicit binding still wins.
// No default on the override itself: an unbound override falls back rather
// than pointing the gate at a guessed endpoint.
variable "route_decision_base_url" {
    type        = string
    default     = ""
    description = "Optional System One decision backend base URL for the route gate (the adapter appends /v1/systemone). Empty falls back to the production endpoint."
}

variable "route_decision_model" {
    type        = string
    default     = "jev-latest"
    description = "Model id the route gate runs."
}

// Optional bearer credential for the decision backend; left empty the gate
// calls anonymously (the adapter treats an empty api_key as anonymous).
// Secret-tainted: it reaches the adapter only through the secret channel.
variable "route_decision_api_key" {
    type        = string
    default     = ""
    secret      = true
    description = "Optional API key for the decision backend the route gate calls."
}

// The brokenbot merge identity: the ONLY token allowed to merge carriers and
// close superseded members (ADR-0015 D4: separate lanes). No default — an
// unbound brokenbot identity must fail loud before any merge runs.
variable "brokenbot_github_token" {
    description = "Brokenbot lane GitHub identity the merge step uses for gating, merging and close-out; separate from the workflow identity by design."
    type        = string
    secret      = true
}

// ── Lane B (KB-409): protection + CodeQL triage ─────────────────────────────

// Branch-protection application (AFTER per-repo CI green; NEVER
// protection-without-signal). One row per repo to protect; the pack selects
// the required status-check contexts from the KB-408 application contract.
variable "protection_plan" {
    description = "Repos to carry branch protection via the canonical devops-maintenance-protection ruleset. The pack (go|ts|py|starter) fixes the required status-check contexts. Applied only when the pack's required checks are green on the default-branch HEAD; a repo without a plan row is reported but never protected."
    type        = list(object({
        repo = string
        pack = string
    }))
    default     = []
}

// Pre-decided CodeQL dispositions the triage loop executes verbatim (never
// re-derived at run time). fix rows ride the standard pipeline (no budget);
// suppress rows are typed dismissals capped by the per-run budget.
variable "codeql_triage_plan" {
    description = "Typed triage decisions for open CodeQL alerts: repo + alert_number + rule_id + disposition (fix | suppress) + rationale. A suppress row must carry dismissed_reason (false_positive | wont_fix | used_in_tests | used_in_docs). Rows outside the repos scope or duplicating (repo, alert_number) fail loud before any network call; open alerts without a row stay unplanned (report-only)."
    type        = list(object({
        repo             = string
        alert_number     = number
        rule_id          = string
        disposition      = string
        dismissed_reason = optional(string, "")
        rationale        = string
    }))
    default     = []
}

// The backlog is driven to zero and HELD, not driven recklessly: at most this
// many dismissal executions happen per run, in plan declaration order.
variable "codeql_triage_budget" {
    description = "Maximum CodeQL dismissal executions per run (suppression rows only; fix rows never consume budget). Keeps the triage loop budgeted."
    type        = number
    default     = 5
}
